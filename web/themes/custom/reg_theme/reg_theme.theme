<?php

/**
 * @file
 * Theme hooks and preprocessors for REG Theme.
 */

use Drupal\Core\Cache\Cache;
use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;

/**
 * Implements hook_preprocess_html().
 */
function reg_theme_preprocess_html(array &$variables): void {
  $variables['attributes']['class'][] = 'reg-site';
  $route_node = \Drupal::routeMatch()->getParameter('node');
  if ($route_node instanceof NodeInterface && $route_node->bundle() === 'reg_news' && \Drupal::hasService('reg_core.news_repository')) {
    $news = \Drupal::service('reg_core.news_repository')->article($route_node);
    if (!empty($news['seo']['title'])) {
      $variables['head_title']['title'] = $news['seo']['title'];
    }
  }
}

/**
 * Implements hook_preprocess_page().
 */
function reg_theme_preprocess_page(array &$variables): void {
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['reg_homepage_work'] = reg_theme_homepage_work($variables['page']);
    $variables['reg_homepage_work_url'] = Url::fromUserInput('/what-we-do');
  }

  $request_time = \Drupal::time()->getRequestTime();
  $timezone = new \DateTimeZone(\Drupal::config('system.date')->get('timezone.default') ?: date_default_timezone_get());
  $now = (new \DateTimeImmutable('@' . $request_time))->setTimezone($timezone);
  $next_year = $now
    ->setDate(((int) $now->format('Y')) + 1, 1, 1)
    ->setTime(0, 0);
  $variables['reg_year'] = $now->format('Y');
  $variables['page']['#cache']['max-age'] = Cache::mergeMaxAges(
    $variables['page']['#cache']['max-age'] ?? Cache::PERMANENT,
    max(1, $next_year->getTimestamp() - $request_time),
  );
  $variables['page']['#cache']['contexts'][] = 'url.query_args';
  $variables['page']['#cache']['tags'][] = 'config:system.theme.global';
  $variables['page']['#cache']['tags'][] = 'config:system.date';
  $variables['page']['#cache']['tags'][] = 'config:reg_theme.settings';

  $configured_logo = theme_get_setting('logo.url');
  $use_default_logo = (bool) theme_get_setting('logo.use_default');
  $base_path = (string) ($variables['base_path'] ?? base_path());
  $theme_directory = (string) ($variables['directory'] ?? 'themes/custom/reg_theme');
  $fallback_logo = rtrim($base_path, '/') . '/' . trim($theme_directory, '/') . '/assets/images/reg-logo.svg';
  $variables['reg_logo_url'] = !$use_default_logo && is_string($configured_logo) && trim($configured_logo) !== ''
    ? $configured_logo
    : $fallback_logo;

  $language_manager = \Drupal::languageManager();
  $current_language = $language_manager->getCurrentLanguage();
  $route_match = \Drupal::routeMatch();
  $route_name = $route_match->getRouteName();
  $route_parameters = $route_match->getRawParameters()->all();
  $query = \Drupal::request()->query->all();
  $variables['reg_language_links'] = [];
  foreach (['en', 'rw'] as $langcode) {
    $language = $language_manager->getLanguage($langcode);
    if (!$language) {
      continue;
    }
    try {
      $url = $route_name
        ? Url::fromRoute($route_name, $route_parameters, ['language' => $language, 'query' => $query])->toString()
        : Url::fromRoute('<front>', [], ['language' => $language])->toString();
    }
    catch (\Exception) {
      $url = Url::fromRoute('<front>', [], ['language' => $language])->toString();
    }
    $variables['reg_language_links'][] = [
      'langcode' => $langcode,
      'label' => $langcode === 'rw' ? 'Kinyarwanda' : 'English',
      'short_label' => $langcode === 'rw' ? 'RW' : 'EN',
      'url' => $url,
      'active' => $current_language->getId() === $langcode,
    ];
  }

  $settings = \Drupal::config('reg_core.settings');
  $translation = \Drupal::translation();
    $variables['reg_main_menu'] = reg_theme_build_menu('main', 4);
  $variables['reg_utility_menu'] = reg_theme_build_menu('reg-utility-menu', 1);
  $variables['reg_utility_menu_mobile'] = reg_theme_build_menu('reg-utility-menu', 1);
  $variables['reg_utility_menu_footer'] = reg_theme_build_menu('reg-utility-menu', 1);
  $social_media = \Drupal::service('reg_core.social_media_manager');
  $variables['reg_social_links'] = [
    'utility' => $social_media->linksForPlacement('utility'),
    'footer' => $social_media->linksForPlacement('footer'),
  ];
  $variables['page']['#cache']['tags'][] = 'config:reg_core.social_media';
  $variables['reg_search_url'] = reg_theme_route('search.view_node_search', '/search/node');
  $variables['reg_call_center'] = trim((string) ($settings->get('support.call_center') ?: '2727'));
  $variables['reg_call_center_uri'] = preg_replace('/[^0-9+]/', '', $variables['reg_call_center']) ?: '2727';
  $variables['reg_links'] = [
    'services' => reg_theme_route('reg_core.services', '/online-services'),
    'outages' => reg_theme_route('reg_core.outages', '/outages'),
    'faq' => reg_theme_route('reg_core.faq', '/help/faq'),
    'bill_estimator' => reg_theme_route('reg_core.bill_estimator', '/tools/bill-estimator'),
    'carbon_calculator' => reg_theme_route('reg_core.carbon_calculator', '/tools/carbon-footprint'),
    'online_services' => $settings->get('links.online_services') ?: reg_theme_route('reg_core.services', '/online-services'),
    'new_connection' => $settings->get('links.new_connection') ?: reg_theme_route('reg_core.services', '/online-services'),
    'payments' => $settings->get('links.payments') ?: reg_theme_route('reg_core.services', '/online-services'),
    'complaints' => reg_theme_route('reg_core.complaints', '/complaints'),
    'branches' => reg_theme_route('reg_core.branches', '/branches'),
    'contact' => reg_theme_route('reg_core.contact', '/contact'),
    'customer_services' => reg_theme_route('reg_core.customer_services', '/customer-services'),
    'gis' => $settings->get('links.gis') ?: reg_theme_route('reg_core.outages', '/outages'),
  ];

  $fallback_services = [
    ['eyebrow' => $translation->translate('Digital services'), 'title' => $translation->translate('Online Services'), 'description' => $translation->translate("Access REG's online customer service portal to apply for services, manage requests and get support digitally."), 'url' => $variables['reg_links']['online_services'], 'cta' => $translation->translate('Open online services')],
    ['eyebrow' => $translation->translate('Outages'), 'title' => $translation->translate('Check Outages'), 'description' => $translation->translate('View current and planned electricity interruptions.'), 'url' => $variables['reg_links']['outages'], 'cta' => $translation->translate('Check outages')],
    ['eyebrow' => $translation->translate('Contacts'), 'title' => $translation->translate('Branch Locator'), 'description' => $translation->translate('Find the nearest REG, EUCL or EDCL service point.'), 'url' => $variables['reg_links']['branches'], 'cta' => $translation->translate('Find a branch')],
    ['eyebrow' => $translation->translate('Knowledge'), 'title' => $translation->translate('Help & FAQs'), 'description' => $translation->translate('Find answers to common customer questions and service issues.'), 'url' => $variables['reg_links']['faq'], 'cta' => $translation->translate('Get help')],
  ];

  $variables['reg_fallback'] = [
    'services' => reg_theme_service_items($fallback_services),
    'status' => reg_theme_outage_items(),
    'news' => reg_theme_news_items(),
    'tenders' => reg_theme_tender_items(),
    'sports' => reg_theme_sports_items(),
  ];
  $variables['page']['#cache']['tags'][] = 'node_list:reg_service';
  $variables['page']['#cache']['tags'][] = 'config:reg_core.settings';
  $variables['page']['#cache']['contexts'][] = 'user.permissions';
  $variables['reg_fallback']['news']['x_feed'] = $social_media->homepageXFeed();
  if ($variables['reg_fallback']['news']['x_feed'] !== [] && \Drupal::hasService('reg_core.x_feed')) {
    $x_feed = \Drupal::service('reg_core.x_feed')->homepageFeed();
    $variables['reg_fallback']['news']['x_feed']['posts'] = $x_feed['items'];
    $variables['page']['#cache']['tags'] = array_merge($variables['page']['#cache']['tags'], $x_feed['cache_tags']);
  }

}

/**
 * Implements hook_preprocess_menu().
 */
function reg_theme_preprocess_menu(array &$variables): void {
  if (($variables['menu_name'] ?? '') === 'main' || ($variables['menu_name'] ?? '') === 'reg-utility-menu') {
    $route_name = \Drupal::routeMatch()->getRouteName() ?: '';
    $active_section = ($variables['menu_name'] ?? '') === 'main'
      ? reg_theme_main_active_section($route_name)
      : '';
    $langcode = \Drupal::languageManager()->getCurrentLanguage('language_url')->getId();
    $current_path = \Drupal::request()->getPathInfo();
    reg_theme_navigation_item_attributes($variables['items'], $langcode, $current_path, $active_section);
  }
}

/**
 * Adds presentation classes from trusted menu-link options.
 */
function reg_theme_navigation_item_attributes(
  array &$items,
  string $langcode,
  string $current_path,
  string $active_section = '',
  bool $branch_allowed = TRUE,
  int $level = 0,
): bool {
  $any_active = FALSE;
  foreach ($items as &$item) {
    $options = $item['url']->getOptions();
    $navigation_id = (string) ($options['reg_core_navigation_id'] ?? '');
    if (str_starts_with($navigation_id, 'main:')) {
      $item['attributes']->addClass('menu-item--nav-' . str_replace('_', '-', substr($navigation_id, 5)));
    }
    if ($navigation_id === 'main:what-we-do') {
      $item['attributes']->addClass(['menu-item--mega', 'menu-item--what-we-do']);
    }
    if (($options['reg_menu_layout'] ?? '') === 'mega') {
      $item['attributes']->addClass('menu-item--mega');
    }
    $priority = (int) ($options['reg_mobile_priority'] ?? 0);
    if ($priority >= 1 && $priority <= 3) {
      $item['attributes']->addClass('menu-item--mobile-priority-' . $priority);
    }

    $original_link = $item['original_link'] ?? NULL;
    if ($original_link && method_exists($original_link, 'getEntity')) {
      try {
        $entity = $original_link->getEntity()->getUntranslated();
        if ($entity->hasTranslation($langcode)) {
          $item['title'] = $entity->getTranslation($langcode)->label();
        }
      }
      catch (\Exception) {
        // Retain Drupal's resolved menu title if an entity is unavailable.
      }
    }

    $item_branch_allowed = $level === 0 && $active_section !== ''
      ? $navigation_id === $active_section
      : $branch_allowed;
    $is_active = !empty($item['in_active_trail']);
    if ($active_section !== '') {
      $is_active = $level === 0 && $navigation_id === $active_section;
    }
    $item_path = parse_url($item['url']->toString(), PHP_URL_PATH) ?: '';
    if (
      $item_branch_allowed
      && $item_path !== ''
      && (rtrim($item_path, '/') ?: '/') === (rtrim($current_path, '/') ?: '/')
    ) {
      $is_active = TRUE;
    }
    if (!empty($item['below'])) {
      $is_active = reg_theme_navigation_item_attributes(
        $item['below'],
        $langcode,
        $current_path,
        $active_section,
        $item_branch_allowed,
        $level + 1,
      ) || $is_active;
    }
    if ($is_active) {
      $item['in_active_trail'] = TRUE;
      $item['attributes']->addClass('menu-item--active-trail');
      $any_active = TRUE;
    }
  }
  return $any_active;
}

/**
 * Maps implemented routes to one unambiguous main-navigation section.
 */
function reg_theme_main_active_section(string $route_name): string {
  if (
    str_starts_with($route_name, 'reg_core.outage')
    || in_array($route_name, [
      'reg_core.services',
      'reg_core.customer_services',
      'reg_core.report_problem',
      'reg_core.branches',
      'reg_core.branch_detail',
      'reg_core.faq',
      'reg_core.bill_estimator',
      'reg_core.carbon_calculator',
    ], TRUE)
  ) {
    return 'main:customer-services';
  }
  if (in_array($route_name, [
    'reg_core.video_media_center',
    'reg_core.videos',
    'reg_core.news',
    'reg_core.news_english',
    'reg_core.news_kinyarwanda',
    'reg_core.press_releases',
    'reg_core.announcements',
    'reg_core.publications',
    'reg_core.newsletters',
    'reg_core.corporate_documents',
    'reg_core.media_gallery',
    'reg_core.media_social',
  ], TRUE)) {
    return 'main:media-center';
  }
  if (
    str_starts_with($route_name, 'reg_core.public_information')
    || str_starts_with($route_name, 'reg_core.tender')
    || str_starts_with($route_name, 'reg_core.job')
    || str_starts_with($route_name, 'reg_core.publication')
  ) {
    return 'main:public-information';
  }
  if (str_starts_with($route_name, 'reg_core.sports')) {
    return 'main:sports';
  }
  if (in_array($route_name, ['reg_core.contact', 'reg_core.complaints'], TRUE)) {
    return 'main:contact';
  }
  return '';
}

/**
 * Builds an administrator-managed menu with access and active-trail handling.
 */
function reg_theme_build_menu(string $menu_name, int $max_depth): array {
  try {
    $menu_tree = \Drupal::menuTree();
    $parameters = $menu_tree->getCurrentRouteMenuTreeParameters($menu_name)
      ->setMinDepth(1)
      ->setMaxDepth($max_depth);
    $tree = $menu_tree->load($menu_name, $parameters);
    $tree = $menu_tree->transform($tree, [
      ['callable' => 'menu.default_tree_manipulators:checkAccess'],
      ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
    ]);
    $build = $menu_tree->build($tree);
  }
  catch (\Exception) {
    $build = [];
  }
  $build['#cache']['contexts'][] = 'languages:language_interface';
  $build['#cache']['contexts'][] = 'route.menu_active_trails:' . $menu_name;
  $build['#cache']['tags'][] = 'config:system.menu.' . $menu_name;
  return $build;
}

/**
 * Loads homepage service items from structured content when available.
 */
function reg_theme_service_items(array $fallback): array {
  $nodes = reg_theme_load_nodes('reg_service', 8, 'field_reg_order', 'ASC');
  if (!$nodes) {
    return $fallback;
  }

  // Keep the four homepage destinations, while retaining matching CMS copy.
  $items = $fallback;
  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  foreach ($nodes as $node) {
    if (!$node->access('view')) {
      continue;
    }
    $source_title = (string) $node->getUntranslated()->label();
    if ($node->hasTranslation($langcode) && $node->getTranslation($langcode)->isPublished()) {
      $node = $node->getTranslation($langcode);
    }
    foreach (['Online Services', 'Check Outages', 'Branch Locator', 'Help & FAQs'] as $index => $title) {
      if ($source_title !== $title) {
        continue;
      }
      $items[$index]['title'] = $node->label();
      $items[$index]['description'] = reg_theme_field($node, 'field_reg_summary') ?: $fallback[$index]['description'];
      // Destinations and order belong to the compact homepage gateway.
    }
  }
  return $items;
}

/**
 * Loads outage items from structured content.
 */
function reg_theme_outage_items(): array {
  $result = ['current' => [], 'planned' => []];
  try {
    $repository = \Drupal::service(\Drupal\reg_core\Outage\OutageRepositoryInterface::class);
    foreach (['current', 'planned'] as $mode) {
      foreach (array_slice($repository->getOutages(['mode' => $mode])->outages, 0, 3) as $outage) {
        $start = !empty($outage['start_time']) ? new \DateTimeImmutable($outage['start_time']) : NULL;
        $end = !empty($outage['expected_restoration']) ? new \DateTimeImmutable($outage['expected_restoration']) : NULL;
        $result[$mode][] = [
          'title' => $outage['network_element'] ?: $outage['title'],
          'description' => implode(' · ', array_slice($outage['districts'] ?? [], 0, 3)),
          'date' => $start ? strtoupper($start->format('d M')) . ($end ? ' · ' . $start->format('H:i') . '–' . $end->format('H:i') : '') : '',
          'url' => \Drupal\Core\Url::fromRoute('reg_core.outage_detail', ['outage_id' => $outage['outage_id']])->toString(),
        ];
      }
    }
  }
  catch (\Throwable) {
    // Keep the homepage available during database updates.
  }
  return $result;
}

/**
 * Loads news items from structured content.
 */
function reg_theme_news_items(): array {
  try {
    if (\Drupal::hasService('reg_core.news_repository')) {
      return \Drupal::service('reg_core.news_repository')->homepage();
    }
  }
  catch (\Exception) {
    // Keep the homepage available while database updates are pending.
  }
  return ['primary' => [], 'secondary' => [], 'cache_tags' => ['node_list:reg_news']];
}

/**
 * Implements hook_preprocess_node().
 */
function reg_theme_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'reg_news' || ($variables['view_mode'] ?? '') !== 'full') {
    return;
  }

  /** @var \Drupal\reg_core\News\NewsRepositoryInterface $repository */
  $repository = \Drupal::service('reg_core.news_repository');
  $news = $repository->article($node);
  $variables['news'] = $news;
  $variables['#cache']['contexts'][] = 'languages:language_content';
  $variables['#cache']['contexts'][] = 'user.node_grants:view';
  $variables['#cache']['tags'] = array_values(array_unique(array_merge($variables['#cache']['tags'] ?? [], $news['cache_tags'])));
}

/**
 * Loads tender items from structured content.
 */
function reg_theme_tender_items(): array {
  try {
    if (\Drupal::hasService('reg_core.public_information_repository')) {
      return \Drupal::service('reg_core.public_information_repository')->homepageTenders(3);
    }
  }
  catch (\Exception) {
    // Keep the completed homepage available during updates or cache rebuilds.
  }
  return [];
}

/**
 * Loads sports items from structured content.
 */
function reg_theme_sports_items(): array {
  try {
    if (\Drupal::hasService('reg_core.sports_repository')) {
      return \Drupal::service('reg_core.sports_repository')->homepageHighlights();
    }
  }
  catch (\Exception) {
    // Keep the completed homepage available during updates or cache rebuilds.
  }
  return [];
}

/**
 * Loads published nodes when a structured bundle exists.
 *
 * @return \Drupal\node\NodeInterface[]
 */
function reg_theme_load_nodes(string $bundle, int $limit, string $sort, string $direction): array {
  $type = \Drupal::entityTypeManager()->getStorage('node_type')->load($bundle);
  if (!$type) {
    return [];
  }

  try {
    $storage = \Drupal::entityTypeManager()->getStorage('node');
    $query = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', $bundle)
      ->condition('status', NodeInterface::PUBLISHED)
      ->sort($sort, $direction)
      ->range(0, $limit);
    $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
    $nodes = [];
    foreach ($storage->loadMultiple($query->execute()) as $node) {
      if ($node->hasTranslation($langcode) && $node->getTranslation($langcode)->isPublished()) {
        $node = $node->getTranslation($langcode);
      }
      $nodes[] = $node;
    }
    return $nodes;
  }
  catch (\Exception) {
    return [];
  }
}

/**
 * Returns a plain text field value.
 */
function reg_theme_field(NodeInterface $node, string $field_name): string {
  if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
    return '';
  }
  $value = $node->get($field_name)->first()?->get('value')->getValue();
  return trim(strip_tags((string) $value));
}

/**
 * Returns a formatted datetime field value.
 */
function reg_theme_date_field(NodeInterface $node, string $field_name): string {
  $value = reg_theme_field($node, $field_name);
  if ($value === '') {
    return '';
  }
  try {
    $date = new DrupalDateTime($value, 'UTC');
    return \Drupal::service('date.formatter')->format($date->getTimestamp(), 'medium');
  }
  catch (\Exception) {
    return $value;
  }
}

/**
 * Returns a link field as a URL string.
 */
function reg_theme_link_field(NodeInterface $node, string $field_name): string {
  if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
    return '';
  }
  $uri = (string) $node->get($field_name)->first()?->get('uri')->getValue();
  if ($uri === '') {
    return '';
  }
  try {
    return Url::fromUri($uri)->toString();
  }
  catch (\Exception) {
    return $uri;
  }
}

/**
 * Returns a route URL, with a path fallback during early installation.
 */
function reg_theme_route(string $route_name, string $fallback): string {
  try {
    return Url::fromRoute($route_name)->toString();
  }
  catch (\Exception) {
    return $fallback;
  }
}

/**
 * Builds homepage cards from published primary pages in the content language.
 */
function reg_theme_homepage_work(array &$page): array {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $langcode = \Drupal::languageManager()->getCurrentLanguage(\Drupal\Core\Language\LanguageInterface::TYPE_CONTENT)->getId();
  $keys = ['generation', 'transmission', 'distribution', 'access'];
  $cache = \Drupal\Core\Cache\CacheableMetadata::createFromRenderArray($page)
    ->addCacheTags(['node_list:reg_what_we_do_page', 'node_list:reg_section_hero', 'media_list', 'config:responsive_image.styles.reg_homepage_work'])
    ->addCacheContexts(['languages:language_content', 'languages:language_url', 'user.permissions', 'user.node_grants:view']);
  $ids = $storage->getQuery()->accessCheck(TRUE)
    ->condition('type', 'reg_what_we_do_page')
    ->condition('langcode', $langcode, '=', $langcode)
    ->condition('status', NodeInterface::PUBLISHED, '=', $langcode)
    ->condition('field_reg_wwd_key', $keys, 'IN')
    ->sort('changed', 'DESC')->sort('uuid', 'ASC')->execute();
  $items = [];
  foreach ($storage->loadMultiple($ids) as $node) {
    $key = $node->get('field_reg_wwd_key')->value;
    if (!isset($items[$key])) {
      $item = reg_theme_homepage_work_card($node, $langcode, $cache);
      if ($item !== NULL) {
        $items[$key] = $item;
      }
    }
  }
  $cache->applyTo($page);
  // Stable structured keys define display order; IDs and titles never do.
  return array_values(array_filter(array_replace(array_fill_keys($keys, NULL), $items)));
}

/**
 * Normalizes a current-language card without falling back to another language.
 */
function reg_theme_homepage_work_card(NodeInterface $node, string $langcode, \Drupal\Core\Cache\CacheableMetadata $cache): ?array {
  $cache->addCacheableDependency($node);
  if (!$node->hasTranslation($langcode)) {
    return NULL;
  }
  $node = $node->getTranslation($langcode);
  $access = $node->access('view', NULL, TRUE);
  $cache->addCacheableDependency($access);
  if (!$node->isPublished() || !$access->isAllowed()) {
    return NULL;
  }
  $summary_access = $node->get('field_reg_summary')->access('view', NULL, TRUE);
  $cache->addCacheableDependency($summary_access);
  $summary = $summary_access->isAllowed() ? trim(strip_tags((string) $node->get('field_reg_summary')->value)) : '';
  $image_mode = 'cover';
  if ($node->hasField('field_reg_image_display_mode')) {
    $mode_field = $node->get('field_reg_image_display_mode');
    $mode_access = $mode_field->access('view', NULL, TRUE);
    $cache->addCacheableDependency($mode_access);
    if ($mode_access->isAllowed() && $mode_field->value === 'contain') {
      $image_mode = 'contain';
    }
  }
  $url = $node->toUrl('canonical', ['language' => $node->language()])->toString(TRUE);
  $cache->addCacheableDependency($url);
  $image_access = $node->get('field_reg_featured_image')->access('view', NULL, TRUE);
  $cache->addCacheableDependency($image_access);
  $media = $image_access->isAllowed() ? $node->get('field_reg_featured_image')->entity : NULL;
  $image = reg_theme_homepage_work_image($media, $cache);
  $uses_fallback = $image === [];
  if ($uses_fallback) {
    $image = reg_theme_homepage_work_fallback_image($cache);
  }
  return [
    'key' => $node->get('field_reg_wwd_key')->value,
    'title' => $node->label(), 'url' => $url->getGeneratedUrl(), 'image' => $image,
    'summary' => \Drupal\Component\Utility\Unicode::truncate($summary, 150, TRUE, TRUE),
    'image_mode' => $image_mode, 'image_fallback' => $uses_fallback,
  ];
}

/**
 * Builds bounded responsive derivatives from the node-selected Image Media.
 */
function reg_theme_homepage_work_image(?\Drupal\Core\Entity\EntityInterface $media, \Drupal\Core\Cache\CacheableMetadata $cache): array {
  if (!$media instanceof \Drupal\media\MediaInterface) {
    return [];
  }
  $media = \Drupal::service('entity.repository')->getTranslationFromContext($media);
  $access = $media->access('view', NULL, TRUE);
  $cache->addCacheableDependency($media)->addCacheableDependency($access);
  $source = $media->getSource()->getConfiguration()['source_field'] ?? '';
  if (!$media->isPublished() || !$access->isAllowed() || !$source || !$media->hasField($source)) {
    return [];
  }
  $field = $media->get($source);
  $field_access = $field->access('view', NULL, TRUE);
  $cache->addCacheableDependency($field_access);
  $item = $field->first();
  $file = $item?->entity;
  if (!$field_access->isAllowed() || !$file instanceof \Drupal\file\FileInterface) {
    return [];
  }
  $cache->addCacheableDependency($file);
  if (!is_file($file->getFileUri())) {
    return [];
  }
  return [
    '#theme' => 'responsive_image', '#responsive_image_style_id' => 'reg_homepage_work',
    '#uri' => $file->getFileUri(), '#width' => (int) $item->width, '#height' => (int) $item->height,
    '#attributes' => ['alt' => (string) $item->alt, 'loading' => 'lazy', 'decoding' => 'async'],
  ];
}

/**
 * Reuses the configured, published What We Do section hero's fallback Media.
 */
function reg_theme_homepage_work_fallback_image(\Drupal\Core\Cache\CacheableMetadata $cache): array {
  $cache->addCacheTags(['node_list:reg_section_hero']);
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()->accessCheck(TRUE)
    ->condition('type', 'reg_section_hero')->condition('status', NodeInterface::PUBLISHED)
    ->condition('field_reg_section_key', 'what_we_do')->condition('field_reg_active', 1)
    ->sort('field_reg_order', 'ASC')->sort('uuid', 'ASC')->execute();
  foreach ($storage->loadMultiple($ids) as $hero) {
    $access = $hero->access('view', NULL, TRUE);
    $cache->addCacheableDependency($hero)->addCacheableDependency($access);
    if (!$access->isAllowed() || trim((string) $hero->get('field_reg_page_paths')->value) !== '') {
      continue;
    }
    $field = $hero->get('field_reg_background_image');
    $field_access = $field->access('view', NULL, TRUE);
    $cache->addCacheableDependency($field_access);
    $image = $field_access->isAllowed() ? reg_theme_homepage_work_image($field->entity, $cache) : [];
    if ($image !== []) {
      return $image;
    }
  }
  return [];
}
