{{ attach_library('reg_core/newsroom') }}
<article{{ attributes.addClass('reg-news-article') }} data-reg-analytics-event="news_view" data-reg-analytics-id="{{ news.id }}">
  <header class="reg-news-article__header">
    <div class="reg-news-article__header-inner">
      <p class="reg-news-article__kicker">{{ news.section == 'sports' ? 'REG Sports'|t : 'Media Center'|t }} / {{ news.section == 'sports' ? 'Sports News'|t : 'Corporate News'|t }}</p>
      <h1>{{ news.title }}</h1>
      {% if news.summary %}<p class="reg-news-article__summary">{{ news.summary }}</p>{% endif %}
      <div class="reg-news-article__meta">
        {% if news.date %}<time datetime="{{ news.date_iso }}">{{ 'Published:'|t }} {{ news.date }}</time>{% endif %}
        {% if news.date and news.category.label %}<span aria-hidden="true">•</span>{% endif %}
        {% if news.category.label %}<span>{{ news.category.label }}</span>{% endif %}
        {% if news.department %}<span aria-hidden="true">•</span><span>{{ news.department }}</span>{% endif %}
      </div>
    </div>
  </header>

  {% if news.image.render %}
    <figure class="reg-news-article__hero">
      {{ news.image.render }}
      {% if news.image_caption or news.photo_credit %}
        <figcaption>
          {% if news.image_caption %}<span>{{ news.image_caption }}</span>{% endif %}
          {% if news.photo_credit %}<small>{{ 'Photo:'|t }} {{ news.photo_credit }}</small>{% endif %}
        </figcaption>
      {% endif %}
    </figure>
  {% endif %}

  <div class="reg-news-article__content">
    <div class="reg-news-article__body">{{ news.body }}</div>

    {% if news.tags %}<p class="reg-news-article__tags"><strong>{{ 'Topics'|t }}:</strong> {{ news.tags|join(', ') }}</p>{% endif %}

    {% if news.translation %}<p class='reg-news-article__translation'><a href='{{ news.translation.url }}' hreflang='{{ news.translation.language }}'>{{ news.translation.label|t }} &rarr;</a></p>{% endif %}

    {% if news.video %}
      <section class="reg-news-article__video" aria-labelledby="reg-news-video-heading">
        <h2 id="reg-news-video-heading">{{ 'Video'|t }}</h2>
        {{ news.video }}
      </section>
    {% endif %}

    {% if news.gallery %}
      <section class="reg-news-gallery" aria-labelledby="reg-news-gallery-heading">
        <p class="reg-newsroom__eyebrow">{{ 'Photo Gallery'|t }}</p>
        <h2 id="reg-news-gallery-heading">{{ 'More from this story'|t }}</h2>
        <div class="reg-news-gallery__grid">
          {% for image in news.gallery %}<figure>{{ image.render }}</figure>{% endfor %}
        </div>
      </section>
    {% endif %}

    <section class="reg-news-share" aria-labelledby="reg-news-share-heading">
      <h2 id="reg-news-share-heading">{{ 'Share article'|t }}</h2>
      <div class="reg-news-share__actions">
        <a href="{{ news.share.x }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'Share this article on X'|t }}" data-reg-analytics-event="news_share" data-reg-analytics-type="x" data-reg-analytics-id="{{ news.id }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.847h-7.406l-5.8-7.584-6.638 7.584H.474l8.56-9.782L0 1.153h7.594l5.243 6.932 6.064-6.932Zm-1.291 19.492h2.039L6.486 3.24H4.298L17.61 20.645Z"/></svg><span>X</span>
        </a>
        <a href="{{ news.share.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'Share this article on Facebook'|t }}" data-reg-analytics-event="news_share" data-reg-analytics-type="facebook" data-reg-analytics-id="{{ news.id }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.414c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.972h-1.513c-1.49 0-1.956.931-1.956 1.887v2.261h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073Z"/></svg><span>{{ 'Facebook'|t }}</span>
        </a>
        <a href="{{ news.share.linkedin }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'Share this article on LinkedIn'|t }}" data-reg-analytics-event="news_share" data-reg-analytics-type="linkedin" data-reg-analytics-id="{{ news.id }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.94v5.666H9.351V9h3.414v1.561h.047c.476-.9 1.637-1.85 3.37-1.85 3.602 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124ZM7.119 20.452H3.555V9H7.12v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0Z"/></svg><span>{{ 'LinkedIn'|t }}</span>
        </a>
        <button type="button" data-reg-copy-link="{{ news.share.copy }}" data-reg-analytics-event="news_share" data-reg-analytics-type="copy" data-reg-analytics-id="{{ news.id }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 7a5 5 0 0 1 5-5h4a5 5 0 0 1 0 10h-2v-2h2a3 3 0 1 0 0-6h-4a3 3 0 0 0-3 3v2H8V7Zm1 4h6v2H9v-2Zm-2 1h2v2H7a3 3 0 1 0 0 6h4a3 3 0 0 0 3-3v-2h2v2a5 5 0 0 1-5 5H7a5 5 0 0 1 0-10Z"/></svg><span data-reg-copy-label>{{ 'Copy link'|t }}</span>
        </button>
        <span class="visually-hidden" aria-live="polite" data-reg-copy-status></span>
      </div>
    </section>
  </div>

  {% if news.related %}
    <section class="reg-news-related" aria-labelledby="reg-news-related-heading">
      <div class="reg-container">
        <p class="reg-newsroom__eyebrow">{{ 'Continue reading'|t }}</p>
        <h2 id="reg-news-related-heading">{{ news.section == 'sports' ? 'Related Sports News'|t : 'Related Corporate News'|t }}</h2>
        <div class="reg-news-grid">
          {% for item in news.related %}{% include '@reg_core/reg-news-card.html.twig' with {item: item, variant: 'card', analytics_event: 'news_related_click'} only %}{% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  <div class="reg-container reg-news-article__back"><a href="{{ news.back_url }}">← {{ news.section == 'sports' ? 'Back to Sports News'|t : 'Back to News'|t }}</a></div>
</article>
