{% if items %}
  {{ attach_library('reg_theme/homepage_work') }}
  <section class="homepage-work" aria-labelledby="homepage-work-title">
    <div class="reg-container">
      <div class="homepage-work__heading">
        <div>
          <span class="section-kicker">{{ section.eyebrow }}</span>
          <h2 id="homepage-work-title">{{ section.heading }}</h2>
          {% if section.intro %}<p>{{ section.intro }}</p>{% endif %}
        </div>
        <a class="homepage-work__all" href="{{ overview_url }}">{{ section.cta_label }} <span aria-hidden="true">→</span><span class="visually-hidden"> {{ section.eyebrow }}</span></a>
      </div>
      <div class="homepage-work__grid">
        {% for item in items %}
          {% set media_mode = item.image_mode == 'contain' ? 'diagram' : 'photo' %}
          <a class="homepage-work__card" href="{{ item.url }}" aria-label="{{ 'Explore @title'|t({'@title': item.title}) }}">
            {% if item.image %}<div class="homepage-work__image homepage-work__image--{{ media_mode }}">{{ item.image }}</div>{% endif %}
            <div class="homepage-work__body">
              <h3>{{ item.title }}</h3>
              {% if item.summary %}<p>{{ item.summary }}</p>{% endif %}
              <span class="homepage-work__explore">{{ section.card_cta_label }} <span class="homepage-work__arrow" aria-hidden="true">→</span></span>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}
