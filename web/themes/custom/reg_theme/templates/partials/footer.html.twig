{{ reg_footer_cache }}
<footer class="site-footer">
  <div class="reg-container footer-grid">
    <div>
      {% if page.footer_brand %}
        {{ page.footer_brand }}
      {% else %}
        <h2>{{ reg_footer.organization_name }}</h2>
        <p>{{ reg_footer.organization_description }}</p>
      {% endif %}
    </div>
    <div>
      {% if page.footer_services %}
        {{ page.footer_services }}
      {% else %}
        <h3>{{ reg_footer.quick_links_heading }}</h3>
        <nav class="footer-menu" aria-label="{{ 'Footer utility navigation'|t }}">
          {{ reg_footer_quick_links }}
        </nav>
      {% endif %}
    </div>
    <div>
      {% if page.footer_resources %}
        {{ page.footer_resources }}
      {% else %}
        <h3>{{ reg_footer.support_heading }}</h3>
        <p>{{ reg_footer.support_description }}</p>
        {{ reg_footer_support }}
      {% endif %}
    </div>
    <div>
      {% if reg_social_links.footer %}
        <div class="footer-social">
          <h3>{{ reg_footer.social_heading }}</h3>
          {% include '@reg_core/reg-social-links.html.twig' with {
            items: reg_social_links.footer,
            variant: 'footer'
          } only %}
        </div>
      {% endif %}
      {% if page.footer_connect %}
        {{ page.footer_connect }}
      {% else %}
        <h3 class="footer-language-heading">{{ reg_footer.language_heading }}</h3>
        {% include '@reg_theme/partials/language-switcher.html.twig' %}
      {% endif %}
    </div>
  </div>
  <div class="reg-container footer-bottom">
    <p>{{ reg_footer.copyright }}</p>
    {% if page.footer_bottom %}
      {{ page.footer_bottom|without('reg_theme_powered') }}
    {% endif %}
  </div>
</footer>
