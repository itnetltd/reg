/**
 * Implements hook_install().
 */
function reg_core_install(): void {
  reg_core_apply_foundation();
  require_once __DIR__ . '/reg_core.media_center.inc';
  reg_core_apply_media_center_migration();
  reg_core_apply_tender_upgrade();
  reg_core_apply_newsroom();
  require_once __DIR__ . '/reg_core.social_post.inc';
  reg_core_apply_social_posts();
  reg_core_apply_social_media_configuration();
  reg_core_apply_official_faq_content();
  reg_core_apply_official_branch_content();
  require_once __DIR__ . '/reg_core.about.inc';
  reg_core_apply_about_section();
  reg_core_apply_public_alerts();
  reg_core_apply_homepage_content();
  reg_core_apply_energy_tools();
  reg_core_apply_homepage_videos();
  reg_core_apply_2026_basketball_data();
  reg_core_apply_featured_result_image();
  require_once __DIR__ . '/reg_core.what_we_do.inc';
  reg_core_apply_what_we_do_content_model();
  reg_core_apply_homepage_statistics();
  reg_core_apply_energy_at_glance();
  reg_core_apply_manual_outages();
  require_once __DIR__ . '/reg_core.plans.inc';
  reg_core_apply_plan_linked_publishing();
  require_once __DIR__ . '/reg_core.supplier.inc';
  reg_core_apply_supplier_portal();
  \Drupal::messenger()->addStatus(new TranslatableMarkup('REG Core content model and service tools have been configured.'));
}

/**
 * Adds safe, idempotent defaults for official social media management.
 */
function reg_core_apply_social_media_configuration(): void {
  $config = \Drupal::configFactory()->getEditable('reg_core.social_media');
  $defaults = [
    'x' => [
      'display_name' => 'Rwanda Energy Group',
      'show_utility' => TRUE,
      'show_footer' => TRUE,
      'show_homepage_feed' => TRUE,
      'api_enabled' => FALSE,
      'api_username' => 'reg_rwanda',
      'api_user_id' => '',
      'api_cache_lifetime' => 900,
      'api_homepage_post_count' => 3,
      'api_exclude_replies' => TRUE,
      'api_exclude_reposts' => TRUE,
    ],
    'facebook' => ['show_utility' => TRUE, 'show_footer' => TRUE],
    'youtube' => ['show_utility' => TRUE, 'show_footer' => TRUE],
    'instagram' => ['show_utility' => FALSE, 'show_footer' => TRUE],
    'linkedin' => ['show_utility' => FALSE, 'show_footer' => TRUE],
  ];
  $changed = FALSE;

  foreach ($defaults as $id => $placements) {
    $values = [
      'url' => '',
      'enabled' => FALSE,
      'show_homepage_feed' => FALSE,
      ...$placements,
    ];
    foreach ($values as $key => $value) {
      $config_key = 'platforms.' . $id . '.' . $key;
      if ($config->get($config_key) === NULL) {
        $config->set($config_key, $value);
        $changed = TRUE;
      }
    }
  }

  if ($changed) {
    $config->save(TRUE);
  }
}

/**
 * Builds the CMS-driven News & Insights content and presentation foundation.
 */
function reg_core_apply_newsroom(): void {
  \Drupal::service('module_installer')->install([
    'block',
    'image',
    'responsive_image',
    'media',
    'media_library',
    'taxonomy',
    'language',
    'content_translation',
    'workflows',
    'content_moderation',
  ], TRUE);

  $vocabulary = Vocabulary::load('reg_news_category');
  if (!$vocabulary) {
    $vocabulary = Vocabulary::create([
      'vid' => 'reg_news_category',
      'name' => 'REG News categories',
      'description' => 'Translated newsroom categories used for archive filters and related News.',
    ]);
    $vocabulary->save();
  }

  $term_ids = [];
  foreach (reg_core_news_categories() as $weight => $name) {
    $existing = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties([
      'vid' => 'reg_news_category',
      'name' => $name,
    ]);
    $term = $existing ? reset($existing) : Term::create([
      'vid' => 'reg_news_category',
      'name' => $name,
      'weight' => $weight,
      'langcode' => 'en',
    ]);
    if ($term->isNew()) {
      $term->save();
    }
    $term_ids[$name] = (int) $term->id();
  }

  $weight = 5;
  foreach (reg_core_field_definitions()['reg_news'] as $field_name => $definition) {
    reg_core_ensure_field('reg_news', $field_name, $definition, $weight);
    $weight += 2;
  }
  reg_core_ensure_field('reg_news', 'field_reg_content_department', reg_core_string_field('Author / REG department', FALSE), 18);

  ContentLanguageSettings::loadByEntityTypeBundle('node', 'reg_news')
    ->setDefaultLangcode('site_default')
    ->setLanguageAlterable(TRUE)
    ->setThirdPartySetting('content_translation', 'enabled', TRUE)
    ->save();
  ContentLanguageSettings::loadByEntityTypeBundle('taxonomy_term', 'reg_news_category')
    ->setDefaultLangcode('site_default')
    ->setLanguageAlterable(TRUE)
    ->setThirdPartySetting('content_translation', 'enabled', TRUE)
    ->save();

  reg_core_configure_news_form_and_display();
  reg_core_ensure_news_image_styles();
  reg_core_configure_news_workflow();
  reg_core_migrate_news_content($term_ids);
  reg_core_place_homepage_blocks();
  reg_core_create_roles();
}

/**
 * Returns controlled newsroom categories in their editorial display order.
 */
function reg_core_news_categories(): array {
  return [
    'Corporate News',
    'Projects',
    'Customer Service',
    'Energy Development',
    'Electricity Access',
    'Renewable Energy',
    'Partnerships',
    'Investment',
    'Events',
    'Announcements',
    'Community',
    'Sports',
  ];
}

/**
 * Orders the Communications edit form and suppresses raw public fields.
 */
function reg_core_configure_news_form_and_display(): void {
  $form_display = EntityFormDisplay::load('node.reg_news.default') ?: EntityFormDisplay::create([
    'targetEntityType' => 'node',
    'bundle' => 'reg_news',
    'mode' => 'default',
    'status' => TRUE,
  ]);
  $components = [
    'title' => ['string_textfield', -30],
    'langcode' => ['language_select', -28],
    'field_reg_news_category_term' => ['options_select', -24],
    'field_reg_summary' => ['string_textarea', -22],
    'field_reg_featured_image' => ['media_library_widget', -20],
    'field_reg_image_caption' => ['string_textarea', -18],
    'field_reg_photo_credit' => ['string_textfield', -17],
    'body' => ['text_textarea_with_summary', -15],
    'field_reg_news_gallery' => ['media_library_widget', -12],
    'field_reg_video_media' => ['media_library_widget', -10],
    'field_reg_publication_date' => ['datetime_default', -8],
    'field_reg_content_department' => ['string_textfield', -6],
    'field_reg_featured' => ['boolean_checkbox', -4],
    'field_reg_homepage_priority' => ['number', -2],
    'field_tags' => ['entity_reference_autocomplete_tags', 0],
    'field_reg_related_news' => ['entity_reference_autocomplete', 2],
    'field_reg_translation_requested' => ['boolean_checkbox', 20],
    'field_reg_translation_priority' => ['options_select', 22],
    'field_reg_translation_review' => ['datetime_default', 24],
    'field_reg_meta_title' => ['string_textfield', 30],
    'field_reg_meta_description' => ['string_textarea', 32],
    'field_reg_canonical_url' => ['link_default', 34],
    'field_reg_external_url' => ['link_default', 36],
    'path' => ['path', 38],
    'moderation_state' => ['moderation_state_default', 90],
    'revision_log' => ['string_textarea', 92],
  ];
  foreach ($components as $name => [$widget, $component_weight]) {
    $form_display->setComponent($name, [
      'type' => $widget,
      'weight' => $component_weight,
      'settings' => [],
    ]);
  }
  foreach (['field_reg_news_category', 'uid', 'created', 'status', 'promote', 'sticky'] as $hidden) {
    $form_display->removeComponent($hidden);
  }
  $form_display->save();

  $view_display = EntityViewDisplay::load('node.reg_news.default') ?: EntityViewDisplay::create([
    'targetEntityType' => 'node',
    'bundle' => 'reg_news',
    'mode' => 'default',
    'status' => TRUE,
  ]);
  foreach (array_keys(reg_core_field_definitions()['reg_news']) as $field_name) {
    $view_display->removeComponent($field_name);
  }
  foreach (['field_reg_content_department', 'field_reg_translation_requested', 'field_reg_translation_priority', 'field_reg_translation_review'] as $field_name) {
    $view_display->removeComponent($field_name);
  }
  $view_display->setComponent('body', [
    'type' => 'text_default',
    'label' => 'hidden',
    'weight' => 0,
    'settings' => [],
  ])->save();
}

/**
 * Creates scaled/cropped news derivatives and responsive style mappings.
 */
function reg_core_ensure_news_image_styles(): void {
  $styles = [
    'news_featured_large' => ['News featured large 1200x760', 1200, 760],
    'news_featured_small' => ['News featured small 720x520', 720, 520],
    'news_card_medium' => ['News card medium 640x400', 640, 400],
    'news_thumbnail' => ['News thumbnail 320x220', 320, 220],
    'news_article_hero' => ['News article hero 1440x900', 1440, 900],
  ];
  foreach ($styles as $name => [$label, $width, $height]) {
    if (ImageStyle::load($name)) {
      continue;
    }
    $style = ImageStyle::create(['name' => $name, 'label' => $label]);
    $style->addImageEffect([
      'id' => 'image_scale_and_crop',
      'weight' => 0,
      'data' => [
        'width' => $width,
        'height' => $height,
        'anchor' => 'center-center',
      ],
    ]);
    $style->save();
  }

  $responsive_styles = [
    'reg_news_featured' => ['REG News featured responsive', 'news_featured_large', 'news_featured_small', 'news_featured_large'],
    'reg_news_card' => ['REG News card responsive', 'news_card_medium', 'news_thumbnail', 'news_card_medium'],
    'reg_news_thumbnail' => ['REG News thumbnail responsive', 'news_thumbnail', 'news_thumbnail', 'news_thumbnail'],
    'reg_news_article' => ['REG News article responsive', 'news_article_hero', 'news_featured_small', 'news_article_hero'],
  ];
  foreach ($responsive_styles as $id => [$label, $fallback, $mobile, $desktop]) {
    if (ResponsiveImageStyle::load($id)) {
      continue;
    }
    $responsive = ResponsiveImageStyle::create([
      'id' => $id,
      'label' => $label,
      'breakpoint_group' => 'reg_theme',
      'fallback_image_style' => $fallback,
    ]);
    $responsive->addImageStyleMapping('reg_theme.mobile', '1x', [
      'image_mapping_type' => 'image_style',
      'image_mapping' => $mobile,
    ]);
    $responsive->addImageStyleMapping('reg_theme.desktop', '1x', [
      'image_mapping_type' => 'image_style',
      'image_mapping' => $desktop,
    ]);
    $responsive->save();
  }
}

/**
 * Adds a dedicated Draft/Review/Published/Archived workflow for News.
 */
function reg_core_configure_news_workflow(): void {
  $workflow = Workflow::load('reg_news_editorial');
  if (!$workflow) {
    $workflow = Workflow::create([
      'id' => 'reg_news_editorial',
      'label' => 'REG News Editorial',
      'type' => 'content_moderation',
      'type_settings' => [
        'states' => [
          'draft' => ['label' => 'Draft', 'published' => FALSE, 'default_revision' => FALSE, 'weight' => -10],
          'needs_review' => ['label' => 'Needs Review', 'published' => FALSE, 'default_revision' => FALSE, 'weight' => 0],
          'published' => ['label' => 'Published', 'published' => TRUE, 'default_revision' => TRUE, 'weight' => 10],
          'archived' => ['label' => 'Archived', 'published' => FALSE, 'default_revision' => TRUE, 'weight' => 20],
        ],
        'transitions' => [
          'create_new_draft' => ['label' => 'Create New Draft', 'from' => ['draft', 'needs_review', 'published', 'archived'], 'to' => 'draft', 'weight' => 0],
          'submit_for_review' => ['label' => 'Submit for Review', 'from' => ['draft', 'needs_review'], 'to' => 'needs_review', 'weight' => 5],
          'return_to_draft' => ['label' => 'Return to Draft', 'from' => ['needs_review'], 'to' => 'draft', 'weight' => 10],
          'publish' => ['label' => 'Publish', 'from' => ['needs_review', 'published'], 'to' => 'published', 'weight' => 15],
          'archive' => ['label' => 'Archive', 'from' => ['published', 'archived'], 'to' => 'archived', 'weight' => 20],
        ],
        'entity_types' => [],
        'default_moderation_state' => 'draft',
      ],
    ]);
  }
  $moderation = $workflow->getTypePlugin();
  if ($moderation instanceof ContentModerationInterface) {
    $moderation->addEntityTypeAndBundle('node', 'reg_news');
  }
  $workflow->save();
}

/**
 * Migrates legacy category/date data and reuses the conference image file.
 */
function reg_core_migrate_news_content(array $term_ids): void {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()->accessCheck(FALSE)->condition('type', 'reg_news')->execute();
  $legacy_map = [
    'news' => 'Corporate News',
    'press_release' => 'Corporate News',
    'announcement' => 'Announcements',
    'campaign' => 'Community',
  ];

  foreach ($storage->loadMultiple($ids) as $node) {
    $changed = FALSE;
    if ($node->hasField('field_reg_news_category_term') && $node->get('field_reg_news_category_term')->isEmpty()) {
      $legacy = $node->hasField('field_reg_news_category') && !$node->get('field_reg_news_category')->isEmpty()
        ? (string) $node->get('field_reg_news_category')->value
        : 'news';
      $category_name = $legacy_map[$legacy] ?? 'Corporate News';
      if (!empty($term_ids[$category_name])) {
        $node->set('field_reg_news_category_term', ['target_id' => $term_ids[$category_name]]);
        $changed = TRUE;
      }
    }
    if ($node->hasField('field_reg_publication_date') && $node->get('field_reg_publication_date')->isEmpty()) {
      $body = $node->hasField('body') && !$node->get('body')->isEmpty() ? (string) $node->get('body')->value : '';
      $publication_timestamp = str_contains($body, '6 August 2026')
        ? strtotime('2026-08-06 00:00:00 UTC')
        : $node->getCreatedTime();
      $node->set('field_reg_publication_date', gmdate('Y-m-d\TH:i:s', $publication_timestamp));
      $changed = TRUE;
    }
    if ($node->hasField('moderation_state') && $node->get('moderation_state')->isEmpty()) {
      $node->set('moderation_state', $node->isPublished() ? 'published' : 'draft');
      $changed = TRUE;
    }

    $body = $node->hasField('body') && !$node->get('body')->isEmpty() ? (string) $node->get('body')->value : '';
    $conference_file_uuid = 'cdf4c974-fd06-40e9-abe4-4fc61ad0e673';
    if (str_contains($body, $conference_file_uuid)) {
      $file_ids = \Drupal::entityTypeManager()->getStorage('file')->getQuery()
        ->accessCheck(FALSE)
        ->condition('uuid', $conference_file_uuid)
        ->range(0, 1)
        ->execute();
      $file = $file_ids ? \Drupal::entityTypeManager()->getStorage('file')->load(reset($file_ids)) : NULL;
      if ($file) {
        $media_ids = \Drupal::entityTypeManager()->getStorage('media')->getQuery()
          ->accessCheck(FALSE)
          ->condition('bundle', 'image')
          ->condition('field_media_image.target_id', $file->id())
          ->range(0, 1)
          ->execute();
        $media = $media_ids ? Media::load(reset($media_ids)) : NULL;
        if (!$media) {
          $file->setPermanent();
          $file->save();
          $media = Media::create([
            'bundle' => 'image',
            'name' => 'Australia–Africa Clean Energy Conference',
            'status' => 1,
            'uid' => $node->getOwnerId(),
            'field_media_image' => [
              'target_id' => $file->id(),
              'alt' => 'Conference participants at the Australia–Africa Clean Energy Conference',
              'title' => '',
            ],
          ]);
          $media->save();
        }
        if ($node->hasField('field_reg_featured_image') && $node->get('field_reg_featured_image')->isEmpty()) {
          $node->set('field_reg_featured_image', ['target_id' => $media->id()]);
          $changed = TRUE;
        }
        $clean_body = preg_replace('/^\s*<img\b[^>]*data-entity-uuid=["\']' . preg_quote($conference_file_uuid, '/') . '["\'][^>]*>\s*/i', '', $body, 1, $removed);
        if ($removed && is_string($clean_body)) {
          $body_value = $node->get('body')->first()->getValue();
          $body_value['value'] = $clean_body;
          $node->set('body', $body_value);
          $changed = TRUE;
        }
      }
    }

    if ($changed) {
      $node->setNewRevision(TRUE);
      $node->setRevisionLogMessage('REG News newsroom upgrade: migrated editorial metadata and reused existing conference media.');
      $node->save();
    }
  }
}

/**
 * Creates idempotent restored examples from the supplied announcements.
 */
function reg_core_seed_manual_outage_samples(): void {
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $terms = [];
  foreach (['reg_district', 'reg_sector'] as $vid) {
    foreach ($term_storage->loadTree($vid) as $term) $terms[$vid][$term->name] = (int) $term->tid;
  }
  $records = [
    'REG-HIST-BIREMBO-2025-11-28' => [
      'title' => 'Birembo Substation Maintenance', 'date' => '2025-11-28', 'network' => 'Birembo Substation', 'reason' => 'Substation maintenance works',
      'segments' => [
        ['09:00', '11:00', 'Kinyinya', ['Gasabo'], ['Kinyinya', 'Kimihurura', 'Kacyiru'], 'Kinyinya and parts of Kimihurura and Kacyiru'],
        ['11:00', '13:00', 'Kibagabaga-Nyarutarama', ['Gasabo'], ['Remera', 'Kimironko', 'Nyarutarama'], 'parts of Remera and Kimironko'],
        ['13:00', '15:00', 'Kibagabaga-Remera', ['Gasabo'], ['Kimironko', 'Remera'], 'parts of Kimironko and Remera'],
      ],
    ],
    'REG-HIST-UTEXRWA-2026-07-08' => [
      'title' => 'Planned Power Outage – UTEXRWA Feeder', 'date' => '2026-07-08', 'network' => 'UTEXRWA feeder', 'reason' => 'Maintenance and extension works',
      'segments' => [['12:00', '14:00', 'UTEXRWA', ['Gasabo'], ['Gisozi', 'Kinyinya', 'Kacyiru'], 'Gisozi, Kinyinya and Kacyiru']],
    ],
    'REG-HIST-KIGALI-NORD-2026-08-16' => [
      'title' => 'Planned Power Outage – Kigali Nord Feeder', 'date' => '2026-08-16', 'network' => 'Kigali Nord feeder', 'reason' => 'Extension and maintenance works',
      'segments' => [['08:00', '10:00', 'Kigali Nord', ['Nyarugenge', 'Gasabo'], ['Muhima', 'Nyarugenge', 'Kacyiru', 'Gisozi', 'Kimihurura'], 'Muhima and Nyarugenge; Kacyiru, Gisozi and Kimihurura']],
    ],
  ];
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($records as $reference => $record) {
    $existing = $storage->getQuery()->accessCheck(FALSE)->condition('type', 'reg_outage')->condition('field_reg_announcement_ref', $reference)->range(0, 1)->execute();
    $segments = [];
    foreach ($record['segments'] as [$start, $end, $feeder, $districts, $sectors, $areas]) {
      $start_utc = (new \DateTimeImmutable($record['date'] . ' ' . $start, new \DateTimeZone('Africa/Kigali')))->setTimezone(new \DateTimeZone('UTC'))->format('Y-m-d\\TH:i:s');
      $end_utc = (new \DateTimeImmutable($record['date'] . ' ' . $end, new \DateTimeZone('Africa/Kigali')))->setTimezone(new \DateTimeZone('UTC'))->format('Y-m-d\\TH:i:s');
      $segments[] = ['start' => $start_utc, 'end' => $end_utc, 'feeder' => $feeder, 'substation' => $record['network'], 'districts' => implode(',', array_map(static fn(string $name): int => $terms['reg_district'][$name], $districts)), 'sectors' => implode(',', array_map(static fn(string $name): int => $terms['reg_sector'][$name], $sectors)), 'affected_area' => $areas, 'restoration_status' => 'restored'];
    }
    $node = $existing ? $storage->load(reset($existing)) : Node::create(['type' => 'reg_outage', 'langcode' => 'en', 'uid' => 1]);
    $node->set('title', $record['title'])->set('field_reg_announcement_ref', $reference)->set('field_reg_announcement_date', $record['date'])->set('field_reg_outage_type', 'planned_maintenance')->set('field_reg_reason', $record['reason'])->set('field_reg_network_element', $record['network'])->set('field_reg_outage_status', 'restored')->set('field_reg_outage_segments', $segments)->set('field_reg_public_summary', $record['reason'])->set('field_reg_outage_source', 'manual')->set('field_reg_featured', 0)->set('field_reg_show_public_alert', 0)->setPublished(TRUE);
    if ($node->hasField('moderation_state')) $node->set('moderation_state', 'published');
    if (!$node->isNew()) {
      $node->setNewRevision(TRUE);
      $node->setRevisionLogMessage('Corrected historical announcement schedule timezone normalization.');
    }
    $node->save();
  }
}

/**
 * Builds and imports the official REG branch directory without overwrites.
 */
function reg_core_apply_official_branch_content(): array {
  reg_core_apply_customer_support_phase();

  $fields = [
    'field_reg_manager_name' => reg_core_string_field('Manager', FALSE, TRUE),
    'field_reg_phone_ph' => reg_core_string_field('PH', FALSE, TRUE),
    'field_reg_phone_te' => reg_core_string_field('TE', FALSE, TRUE),
    'field_reg_source_url' => [
      'type' => 'link',
      'label' => 'Source URL',
      'required' => FALSE,
      'translatable' => FALSE,
      'widget' => 'link_default',
      'formatter' => 'link',
    ],
    'field_reg_source_label' => reg_core_string_field('Source label', FALSE, FALSE),
    'field_reg_source_id' => reg_core_string_field('Stable source ID', FALSE, FALSE),
    'field_reg_source_hash' => reg_core_string_field('Migration source hash', FALSE, FALSE),
    'field_reg_source_excerpt' => array_replace(reg_core_long_text_field('Original source record'), ['translatable' => FALSE]),
    'field_reg_branch_review_status' => reg_core_list_field('Review status', [
      'imported_requires_validation' => 'Imported — Requires REG Validation',
      'verified' => 'Verified by REG',
      'needs_update' => 'Needs update',
    ], TRUE, FALSE),
    'field_reg_source_checked_date' => array_replace(
      reg_core_date_field('Source checked date', FALSE),
      ['storage_settings' => ['datetime_type' => 'date']],
    ),
    'field_reg_last_verified' => array_replace(
      reg_core_date_field('Last verified date', FALSE),
      ['storage_settings' => ['datetime_type' => 'date']],
    ),
    'field_reg_manager_photo' => array_replace(reg_core_media_reference_field('Manager photo', 1, FALSE, 'image'), ['translatable' => FALSE]),
    'field_reg_branch_photo' => array_replace(reg_core_media_reference_field('Branch photo', 1, FALSE, 'image'), ['translatable' => FALSE]),
  ];
  $weight = 35;
  foreach ($fields as $fieldName => $definition) {
    reg_core_ensure_field('reg_branch', $fieldName, $definition, $weight);
    $weight += 2;
  }

  // The migration source does not contain physical addresses for each branch.
  // Keep the fields available but do not force editors or the importer to guess.
  foreach ([
    'field_reg_address',
    'field_reg_email',
    'field_reg_phone',
    'field_reg_province',
    'field_reg_district_ref',
  ] as $optionalField) {
    $field = FieldConfig::loadByName('node', 'reg_branch', $optionalField);
    if ($field && $field->isRequired()) {
      $field->setRequired(FALSE)->save();
    }
  }

  $branchType = FieldStorageConfig::loadByName('node', 'field_reg_branch_type');
  if ($branchType) {
    $allowed = $branchType->getSetting('allowed_values') ?: [];
    $allowed['official_branch_service_area'] = 'Branch / service area';
    $branchType->setSetting('allowed_values', $allowed)->save();
  }

  // Editorial trace fields are available on the form and admin listing, but
  // must not leak through Drupal's generic node display.
  $display = EntityViewDisplay::load('node.reg_branch.default');
  if ($display) {
    foreach ([
      'field_reg_source_url',
      'field_reg_source_label',
      'field_reg_source_id',
      'field_reg_source_hash',
      'field_reg_source_excerpt',
      'field_reg_branch_review_status',
      'field_reg_source_checked_date',
      'field_reg_last_verified',
    ] as $fieldName) {
      $display->removeComponent($fieldName);
    }
    $display->save();
  }

  $config = \Drupal::configFactory()->getEditable('reg_core.settings');
  $officialContacts = [
    'support.organization_name' => 'Rwanda Energy Group',
    'support.address_lines' => ['KN82 ST3', 'Nyarugenge District', 'Kigali City'],
    'support.postal_address' => 'P.O. Box 537 Kigali, Rwanda',
    'support.general_email' => 'info@reg.rw',
    'support.general_telephone' => '(+250)(0)788385025',
    'support.reg_emails' => ['info@reg.rw'],
    'support.eucl_emails' => ['info@eucl.reg.rw', 'eucl@reg.rw'],
    'support.edcl_emails' => ['info@edcl.reg.rw', 'edcl@reg.rw'],
    'support.contact_source_url' => \Drupal\reg_core\Content\OfficialBranchContent::SOURCE_URL,
  ];
  foreach ($officialContacts as $key => $value) {
    if (!$config->get($key)) {
      $config->set($key, $value);
    }
  }
  $config->set('links.branch_contacts', '/branches')->save(TRUE);

  return \Drupal::service('reg_core.official_branch_importer')->import();
}

/**
 * Implements hook_requirements().
 */
function reg_core_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }

  $config = \Drupal::config('reg_core.settings');
  $missing = [];
  if (!trim((string) $config->get('tariffs.approved_schedule_effective'))) {
    $missing[] = 'approved tariff assumptions';
  }
  if (!(float) $config->get('carbon.emission_factor')) {
    $missing[] = 'approved carbon emission factor';
  }
  if (!$config->get('links.online_services')) {
    $missing[] = 'official online-services URL';
  }

  return [
    'reg_core_readiness' => [
      'title' => new TranslatableMarkup('REG integration readiness'),
      'value' => $missing ? new TranslatableMarkup('Configuration required') : new TranslatableMarkup('Configured'),
      'description' => $missing
        ? new TranslatableMarkup('The foundation is installed. REG still needs to validate: @items.', ['@items' => implode(', ', $missing)])
        : new TranslatableMarkup('Core public-service assumptions and links are configured.'),
      'severity' => $missing ? REQUIREMENT_WARNING : REQUIREMENT_OK,
    ],
  ];
}

/**
 * Applies the phase-two structured content foundation.
 */
function reg_core_apply_foundation(): void {
  $module_installer = \Drupal::service('module_installer');
  $module_installer->install([
    'language',
    'locale',
    'content_translation',
    'media',
    'media_library',
    'views',
    'workflows',
    'content_moderation',
  ], TRUE);

  foreach ([
    'reg_news_category' => ['REG News categories', 'Translated newsroom categories.'],
    'tags' => ['Tags', 'Free tagging for public content.'],
  ] as $vid => [$name, $description]) {
    if (!Vocabulary::load($vid)) {
      Vocabulary::create(['vid' => $vid, 'name' => $name, 'description' => $description])->save();
    }
  }

  $types = [
    'reg_service' => ['Service', 'Approved gateway item linking customers to an official digital service.'],
    'reg_outage' => ['Outage notice', 'Current, planned or resolved outage information managed in the CMS or synchronized from an official source.'],
    'reg_news' => ['REG news', 'News, press releases, announcements and corporate updates.'],
    'reg_tender' => ['Tender', 'Procurement opportunities, addenda, clarifications and award notices.'],
    'reg_job' => ['Job vacancy', 'Vacancies, application guidance and recruitment notices.'],
    'reg_publication' => ['Publication', 'Reports, policies, plans, safeguards and official documents.'],
    'reg_faq' => ['FAQ', 'Approved multilingual knowledge content for customer support and the FAQ-first assistant.'],
    'reg_branch' => ['Branch contact', 'REG/EUCL branch contact and location information.'],
    'reg_public_alert' => ['Public Alert', 'Scheduled, translated homepage or sitewide notices governed by the REG editorial workflow.'],
    'reg_homepage_hero' => ['Homepage Heroes', 'Published, ordered and translatable homepage hero campaigns.'],
    'reg_partner' => ['Partners', 'Active institutional partner names, logos and approved website links.'],
    'reg_energy_tool' => ['Energy Tools', 'Published and ordered homepage tools for cost, carbon and safety awareness.'],
    'reg_video' => ['Videos', 'Published REG videos using approved providers, Media thumbnails, and homepage featuring controls.'],
    'reg_section_hero' => ['Section Hero', 'Reusable, translated section-page hero backgrounds, text, and optional page overrides.'],
    'reg_sports_update' => ['Sports update', 'Fixtures, results, team news and sports media updates.'],
    'reg_sports_team' => ['Sports team', 'Official REG sports team profiles and current team information.'],
    'reg_sports_player' => ['Sports player', 'Public athlete profiles linked to official REG teams.'],
    'reg_sports_membership' => ['Sports team-season membership', 'Season-aware roster membership linking an athlete to an official REG team.'],
    'reg_sports_staff' => ['Sports technical staff', 'Approved technical and team staff profiles.'],
    'reg_sports_fixture' => ['Sports fixture', 'Fixtures and connected match results for official REG teams.'],
    'reg_sports_standing' => ['Sports standing row', 'CMS-managed competition standing rows by season.'],
    'reg_sports_gallery' => ['Sports gallery', 'Approved team, match and event photo albums.'],
    'reg_sports_video' => ['Sports video', 'Approved sports video highlights using supported Media providers.'],
  ];

  foreach ($types as $id => [$label, $description]) {
    $type = NodeType::load($id);
    if (!$type) {
      $type = NodeType::create([
        'type' => $id,
        'name' => $label,
        'description' => $description,
        'new_revision' => TRUE,
        'preview_mode' => 1,
        'display_submitted' => FALSE,
      ]);
      $type->save();
    }
    if (function_exists('node_add_body_field') && !in_array($id, ['reg_public_alert', 'reg_homepage_hero', 'reg_partner', 'reg_energy_tool', 'reg_video', 'reg_section_hero'], TRUE)) {
      reg_core_ensure_body_field_storage();
      node_add_body_field($type, $id === 'reg_faq' ? 'Supporting notes' : 'Body');
    }
  }

  $definitions = reg_core_field_definitions();
  foreach ($definitions as $bundle => $fields) {
    $weight = 5;
    foreach ($fields as $field_name => $definition) {
      reg_core_ensure_field($bundle, $field_name, $definition, $weight);
      $weight += 2;
    }
  }

  $translation_manager = \Drupal::service('content_translation.manager');
  foreach (array_keys($types) as $bundle) {
    if (!$translation_manager->isEnabled('node', $bundle)) {
      $translation_manager->setEnabled('node', $bundle, TRUE);
    }
  }

  reg_core_configure_faq_governance();

  reg_core_create_roles();

  $config = \Drupal::configFactory()->getEditable('reg_core.settings');
  if ($config->isNew()) {
    $config
      ->set('support.call_center', '2727')
      ->set('support.complaint_url', '')
      ->set('links.online_services', '')
      ->set('links.new_connection', '')
      ->set('links.payments', '')
      ->set('links.gis', '')
      ->set('links.outage_source', '')
      ->set('links.recruitment', '')
      ->set('links.procurement', '')
      ->set('links.branch_contacts', '')
      ->set('tariffs.residential', 0)
      ->set('tariffs.commercial', 0)
      ->set('tariffs.industrial', 0)
      ->set('tariffs.fixed_charge', 0)
      ->set('tariffs.updated', '')
      ->set('tariffs.approved_schedule_effective', '2025-10-01')
      ->set('carbon.emission_factor', 0)
      ->set('carbon.updated', '')
      ->save();
  }

  $dms_defaults = [
    'dms.api_base_url' => '',
    'dms.authentication_method' => 'none',
    'dms.client_id' => '',
    'dms.credential_environment_variable' => 'REG_GE_DMS_CREDENTIAL',
    'dms.request_timeout' => 10,
    'dms.synchronization_interval' => 300,
    'dms.cache_lifetime' => 300,
  ];
  $changed = FALSE;
  foreach ($dms_defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
      $changed = TRUE;
    }
  }
  if ($changed) {
    $config->save();
  }

  reg_core_apply_public_information_hub();
  reg_core_apply_sports_portal();
  reg_core_apply_customer_support_phase();
  reg_core_apply_multilingual_completion();
  reg_core_apply_navigation();
  reg_core_apply_analytics_dashboards();
  reg_core_apply_section_heroes();
}

/**
 * Installs Drupal-managed, bilingual public navigation and content search.
 */
function reg_core_apply_navigation(): void {
  \Drupal::service('module_installer')->install([
    'menu_link_content',
    'menu_ui',
    'search',
    'search_node',
  ], TRUE);

  $utility_menu = Menu::load('reg-utility-menu');
  if (!$utility_menu) {
    Menu::create([
      'id' => 'reg-utility-menu',
      'label' => 'REG utility menu',
      'description' => 'Compact public-service links shown above the REG main navigation.',
      'langcode' => 'en',
      'locked' => FALSE,
    ])->save();
  }

  ContentLanguageSettings::loadByEntityTypeBundle('menu_link_content', 'menu_link_content')
    ->setDefaultLangcode('site_default')
    ->setLanguageAlterable(TRUE)
    ->setThirdPartySetting('content_translation', 'enabled', TRUE)
    ->save();

  foreach ([RoleInterface::ANONYMOUS_ID, RoleInterface::AUTHENTICATED_ID] as $role_id) {
    $role = Role::load($role_id);
    if ($role && !$role->hasPermission('search content')) {
      $role->grantPermission('search content')->save();
    }
  }

  // The Standard profile ships a static Home link in the Main menu. Keep the
  // front page accessible through the REG logo, but remove that profile link
  // from public navigation using Drupal's supported override storage.
  \Drupal::service('menu_link.static.overrides')->saveOverride('standard.front_page', [
    'menu_name' => 'main',
    'parent' => '',
    'weight' => 0,
    'expanded' => FALSE,
    'enabled' => FALSE,
  ]);

  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('menu_name', ['main', 'reg-utility-menu'], 'IN')
    ->execute();
  $existing = [];
  foreach ($storage->loadMultiple($ids) as $menu_link) {
    $value = $menu_link->get('link')->first()?->getValue() ?? [];
    $key = $value['options']['reg_core_navigation_id'] ?? NULL;
    if (is_string($key) && $key !== '') {
      $existing[$key] = $menu_link;
    }
  }

  $settings = \Drupal::config('reg_core.settings');
  reg_core_ensure_navigation_links('main', NavigationDefaults::main(), '', $existing, $settings);
  reg_core_ensure_navigation_links('reg-utility-menu', NavigationDefaults::utility(), '', $existing, $settings);
}

/**
 * Creates missing navigation defaults without changing administrator edits.
 *
 * @param \Drupal\menu_link_content\Entity\MenuLinkContent[] $existing
 *   Existing default links keyed by the stable REG navigation identifier.
 */
function reg_core_ensure_navigation_links(
  string $menu_name,
  array $definitions,
  string $parent,
  array &$existing,
  \Drupal\Core\Config\ImmutableConfig $settings,
): void {
  $route_provider = \Drupal::service('router.route_provider');
  foreach ($definitions as $weight => $definition) {
    $key = $menu_name . ':' . $definition['id'];
    $menu_link = $existing[$key] ?? NULL;
    if (!$menu_link) {
      $uri = 'route:<nolink>';
      $enabled = (bool) ($definition['enabled'] ?? FALSE);
      $route_name = $definition['route'] ?? NULL;
      if (is_string($route_name) && $route_name !== '') {
        try {
          $route_provider->getRouteByName($route_name);
          $uri = 'route:' . $route_name;
        }
        catch (\Exception) {
          $enabled = FALSE;
        }
      }

      $config_key = $definition['options']['config_key'] ?? NULL;
      if (is_string($config_key) && $config_key !== '') {
        $configured_uri = trim((string) $settings->get($config_key));
        if (
          UrlHelper::isValid($configured_uri, TRUE)
          && UrlHelper::stripDangerousProtocols($configured_uri) === $configured_uri
        ) {
          $uri = $configured_uri;
          $enabled = TRUE;
        }
        else {
          $enabled = FALSE;
        }
      }

      $link_options = [
        'reg_core_navigation_id' => $key,
      ];
      foreach (['layout' => 'reg_menu_layout', 'mobile_priority' => 'reg_mobile_priority', 'query' => 'query'] as $source => $target) {
        if (isset($definition['options'][$source])) {
          $link_options[$target] = $definition['options'][$source];
        }
      }

      $menu_link = MenuLinkContent::create([
        'title' => $definition['title'],
        'link' => [
          'uri' => $uri,
          'options' => $link_options,
        ],
        'menu_name' => $menu_name,
        'parent' => $parent,
        'weight' => $weight,
        'expanded' => !empty($definition['children']),
        'enabled' => $enabled,
        'langcode' => 'en',
      ]);
      $menu_link->save();
      $existing[$key] = $menu_link;
    }

    foreach ($definition['translations'] ?? [] as $langcode => $title) {
      if (!$menu_link->hasTranslation($langcode)) {
        $menu_link->addTranslation($langcode, ['title' => $title]);
        $menu_link->save();
      }
    }

    if (!empty($definition['children'])) {
      reg_core_ensure_navigation_links(
        $menu_name,
        $definition['children'],
        $menu_link->getPluginId(),
        $existing,
        $settings,
      );
    }
  }
}

/**
 * Rebuilds the module-owned What We Do subtree from its approved structure.
 *
 * The stable navigation markers scope replacement to this module's links and
 * leave all administrator-created menu links untouched.
 */
function reg_core_sync_what_we_do_navigation(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $managed_ids = \Drupal::database()->select('menu_link_content_data', 'mlc')
    ->fields('mlc', ['id'])
    ->condition('menu_name', 'main')
    ->condition('link__options', '%main:what-we-do%', 'LIKE')
    ->distinct()
    ->execute()
    ->fetchCol();

  $work_child_ids = \Drupal::database()->select('menu_link_content_data', 'mlc')
    ->fields('mlc', ['id'])
    ->condition('menu_name', 'main')
    ->condition('link__options', '%main:work-%', 'LIKE')
    ->distinct()
    ->execute()
    ->fetchCol();

  $managed_ids = array_values(array_unique(array_merge($managed_ids, $work_child_ids)));
  if ($managed_ids) {
    $storage->delete($storage->loadMultiple($managed_ids));
  }

  $existing = [];
  $ids = $storage->getQuery()->accessCheck(FALSE)->condition('menu_name', 'main')->execute();
  foreach ($storage->loadMultiple($ids) as $link) {
    $options = $link->get('link')->first()?->getValue()['options'] ?? [];
    if (is_string($options)) {
      $decoded = @unserialize($options, ['allowed_classes' => FALSE]);
      $options = is_array($decoded) ? $decoded : [];
    }
    $key = $options['reg_core_navigation_id'] ?? '';
    if (is_string($key) && $key !== '') {
      $existing[$key] = $link;
    }
  }

  $definitions = array_values(array_filter(
    NavigationDefaults::main(),
    static fn(array $item): bool => $item['id'] === 'what-we-do',
  ));
  reg_core_ensure_navigation_links('main', $definitions, '', $existing, \Drupal::config('reg_core.settings'));
}

/**
 * Installs privacy-preserving analytics and dashboard defaults.
 */
function reg_core_apply_analytics_dashboards(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('reg_core_analytics_event')) {
    $schema->createTable('reg_core_analytics_event', reg_core_schema()['reg_core_analytics_event']);
  }

  $config = \Drupal::configFactory()->getEditable('reg_core.settings');
  $defaults = [
    'analytics.enabled' => FALSE,
    'analytics.provider' => 'none',
    'analytics.measurement_id' => '',
    'analytics.privacy_mode' => 'strict',
    'analytics.local_aggregate_enabled' => TRUE,
    'analytics.dashboard_cache_seconds' => 300,
    'governance.branch_review_days' => 180,
    'governance.faq_review_days' => 180,
    'governance.service_review_days' => 180,
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save(TRUE);
  reg_core_create_roles();
}

/**
 * Ensures the shared node body storage exists before attaching body fields.
 */
function reg_core_ensure_body_field_storage(): void {
  if (FieldStorageConfig::loadByName('node', 'body')) {
    return;
  }
  FieldStorageConfig::create([
    'field_name' => 'body',
    'entity_type' => 'node',
    'type' => 'text_with_summary',
    'cardinality' => 1,
    'translatable' => TRUE,
    'settings' => [],
  ])->save();
}

/**
 * Returns the content model field definitions.
 */
