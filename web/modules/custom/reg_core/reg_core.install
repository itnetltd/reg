    }
    if ($id === 'reg_outage_editor') {
      $permissions[] = 'use reg_customer_service_editorial transition create_new_draft';
      $permissions[] = 'use reg_customer_service_editorial transition submit_for_review';
      $permissions[] = 'view media';
      $permissions[] = 'access media overview';
      $permissions[] = 'create document media';
      $permissions[] = 'edit own document media';
      $permissions[] = 'create terms in reg_district';
      $permissions[] = 'edit terms in reg_district';
      $permissions[] = 'create terms in reg_sector';
      $permissions[] = 'edit terms in reg_sector';
    }
    if ($id === 'reg_communications_editor') {
      $permissions[] = 'use reg_customer_service_editorial transition create_new_draft';
      $permissions[] = 'use reg_customer_service_editorial transition submit_for_review';
      $permissions[] = 'use reg_news_editorial transition create_new_draft';
      $permissions[] = 'use reg_news_editorial transition submit_for_review';
      $permissions[] = 'use reg_news_editorial transition return_to_draft';
      $permissions[] = 'use reg_social_post_editorial transition create_new_draft';
      $permissions[] = 'use reg_social_post_editorial transition publish';
      $permissions[] = 'use reg_social_post_editorial transition archive';
      $permissions[] = 'create terms in reg_news_category';
      $permissions[] = 'edit terms in reg_news_category';
      $permissions[] = 'create remote_video media';
      $permissions[] = 'edit own remote_video media';
      $permissions[] = 'use reg_about_editorial transition create_new_draft';
      $permissions[] = 'use reg_about_editorial transition submit_for_review';
      $permissions[] = 'use reg_about_editorial transition publish';
      $permissions[] = 'use reg_about_editorial transition return_to_draft';
      $permissions[] = 'use reg_about_editorial transition archive';
    }
    if (in_array($id, ['reg_procurement_editor', 'reg_hr_editor', 'reg_communications_editor', 'reg_content_approver'], TRUE)) {
      $permissions[] = 'use reg_public_information_editorial transition create_new_draft';
      $permissions[] = 'use reg_public_information_editorial transition submit_for_review';
      $permissions[] = 'view media';
      $permissions[] = 'access media overview';
      $permissions[] = 'create document media';
      $permissions[] = 'edit own document media';
      if ($id === 'reg_content_approver') {
        $permissions[] = 'edit any document media';
      }
    }
    if (in_array($id, ['reg_communications_editor', 'reg_customer_service_editor', 'reg_content_approver'], TRUE)) {
      $permissions[] = 'view media';
      $permissions[] = 'access media overview';
      $permissions[] = 'create image media';
      $permissions[] = 'edit own image media';
      $permissions[] = 'use reg_section_hero_editorial transition create_new_draft';
      $permissions[] = 'use reg_section_hero_editorial transition submit_for_review';
      $permissions[] = 'create terms in reg_video_category';
      $permissions[] = 'edit terms in reg_video_category';
      if ($id === 'reg_content_approver') {
        $permissions[] = 'edit any image media';
      }
    }
    if (in_array($id, ['reg_sports_editor', 'reg_content_approver'], TRUE)) {
      $permissions[] = 'use reg_sports_editorial transition create_new_draft';
      $permissions[] = 'use reg_sports_editorial transition submit_for_review';
      $permissions[] = 'view media';
      $permissions[] = 'access media overview';
      $permissions[] = 'create image media';
      $permissions[] = 'edit own image media';
      $permissions[] = 'create remote_video media';
      $permissions[] = 'edit own remote_video media';
      $permissions[] = 'create terms in reg_sports_competition';
      $permissions[] = 'edit terms in reg_sports_competition';
      $permissions[] = 'create terms in reg_sports_season';
      $permissions[] = 'edit terms in reg_sports_season';
      if ($id === 'reg_content_approver') {
        $permissions[] = 'edit any image media';
        $permissions[] = 'edit any remote_video media';
      }
    }
    if ($id === 'reg_translator') {
      $permissions[] = 'view reg translation report';
      $permissions[] = 'translate any entity';
      $permissions[] = 'translate reg_faq node';
      $permissions[] = 'translate reg_tender node';
      $permissions[] = 'translate reg_job node';
      $permissions[] = 'translate reg_publication node';
      $permissions[] = 'translate reg_homepage_hero node';
      $permissions[] = 'translate reg_energy_tool node';
      $permissions[] = 'translate reg_video node';
      $permissions[] = 'translate reg_section_hero node';
      $permissions[] = 'translate reg_fact node';
      $permissions[] = 'translate reg_public_alert node';
      $permissions[] = 'translate reg_outage node';
      $permissions[] = 'translate reg_news node';
      $permissions[] = 'translate reg_social_post node';
      foreach (['reg_about_page', 'reg_value', 'reg_leader', 'reg_employee_recognition'] as $about_bundle) {
        $permissions[] = "translate $about_bundle node";
        $permissions[] = "edit any $about_bundle content";
        $permissions[] = "view $about_bundle revisions";
      }
      foreach (reg_core_sports_bundles() as $sports_bundle) {
        $permissions[] = "translate $sports_bundle node";
        $permissions[] = "edit any $sports_bundle content";
        $permissions[] = "view $sports_bundle revisions";
      }
      $permissions[] = 'create content translations';
      $permissions[] = 'update content translations';
      $permissions[] = 'edit any reg_faq content';
      $permissions[] = 'edit any reg_tender content';
      $permissions[] = 'edit any reg_job content';
      $permissions[] = 'edit any reg_publication content';
      $permissions[] = 'edit any reg_homepage_hero content';
      $permissions[] = 'edit any reg_energy_tool content';
      $permissions[] = 'edit any reg_video content';
      $permissions[] = 'edit any reg_section_hero content';
      $permissions[] = 'edit any reg_fact content';
      $permissions[] = 'edit any reg_public_alert content';
      $permissions[] = 'edit any reg_news content';
      $permissions[] = 'edit any reg_social_post content';
      $permissions[] = 'view reg_faq revisions';
      $permissions[] = 'view reg_tender revisions';
      $permissions[] = 'view reg_job revisions';
      $permissions[] = 'view reg_publication revisions';
      $permissions[] = 'view reg_homepage_hero revisions';
      $permissions[] = 'view reg_energy_tool revisions';
      $permissions[] = 'view reg_video revisions';
      $permissions[] = 'view reg_section_hero revisions';
      $permissions[] = 'view reg_fact revisions';
      $permissions[] = 'view reg_public_alert revisions';
      $permissions[] = 'view reg_news revisions';
      $permissions[] = 'view reg_social_post revisions';
      $permissions[] = 'use reg_faq_editorial transition create_new_draft';
      $permissions[] = 'use reg_faq_editorial transition submit_for_review';
      $permissions[] = 'use reg_public_information_editorial transition create_new_draft';
      $permissions[] = 'use reg_public_information_editorial transition submit_for_review';
      $permissions[] = 'use reg_sports_editorial transition create_new_draft';
      $permissions[] = 'use reg_sports_editorial transition submit_for_review';
      $permissions[] = 'use reg_news_editorial transition create_new_draft';
      $permissions[] = 'use reg_news_editorial transition submit_for_review';
      $permissions[] = 'use reg_about_editorial transition create_new_draft';
      $permissions[] = 'use reg_about_editorial transition submit_for_review';
      $permissions[] = 'translate reg_branch node';
      $permissions[] = 'translate reg_service node';
      $permissions[] = 'edit any reg_branch content';
      $permissions[] = 'edit any reg_service content';
      $permissions[] = 'view reg_branch revisions';
      $permissions[] = 'view reg_service revisions';
      $permissions[] = 'use reg_customer_service_editorial transition create_new_draft';
      $permissions[] = 'use reg_customer_service_editorial transition submit_for_review';
      $permissions[] = 'use reg_section_hero_editorial transition create_new_draft';
      $permissions[] = 'use reg_section_hero_editorial transition submit_for_review';
    }
    foreach (array_unique($permissions) as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
  }
}

