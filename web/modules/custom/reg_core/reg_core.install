  $date = [
    'type' => 'datetime',
    'label' => 'Date',
    'required' => FALSE,
    'storage_settings' => ['datetime_type' => 'datetime'],
    'widget' => 'datetime_default',
    'formatter' => 'datetime_default',
  ];
  $sports_source_fields = [
    'field_reg_source_organization' => reg_core_list_field('Source organization', reg_core_sports_source_options(), TRUE, FALSE),
