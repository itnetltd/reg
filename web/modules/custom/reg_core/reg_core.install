/**
 * Creates a reusable string field definition.
 */
function reg_core_string_field(string $label, bool $translatable = TRUE, bool $required = FALSE): array {
  return [
    'type' => 'string',
    'label' => $label,
    'required' => $required,
    'translatable' => $translatable,
    'storage_settings' => ['max_length' => 255],
    'widget' => 'string_textfield',
    'formatter' => 'string',
  ];
}

/**
 * Creates a reusable formatted long-text field definition.
 */
function reg_core_long_text_field(string $label): array {
  return [
    'type' => 'text_long',
    'label' => $label,
    'required' => FALSE,
    'widget' => 'text_textarea',
    'formatter' => 'text_default',
  ];
}

/**
 * Creates a taxonomy-term reference field definition.
 */
function reg_core_term_reference_field(string $label, string $vocabulary, bool $required = FALSE, bool $translatable = TRUE): array {
  return [
    'type' => 'entity_reference',
    'label' => $label,
    'required' => $required,
    'translatable' => $translatable,
    'storage_settings' => ['target_type' => 'taxonomy_term'],
    'field_settings' => [
      'handler' => 'default:taxonomy_term',
      'handler_settings' => ['target_bundles' => [$vocabulary => $vocabulary]],
    ],
    'widget' => 'options_select',
    'formatter' => 'entity_reference_label',
  ];
}

/**
 * Creates a Media reference limited to approved document or image media.
 */
function reg_core_media_reference_field(string $label, int $cardinality = 1, bool $required = FALSE, string $bundle = 'document'): array {
  return [
    'type' => 'entity_reference',
    'label' => $label,
    'required' => $required,
    'cardinality' => $cardinality,
    'storage_settings' => ['target_type' => 'media'],
    'field_settings' => [
      'handler' => 'default:media',
      'handler_settings' => ['target_bundles' => [$bundle => $bundle]],
    ],
    'widget' => 'media_library_widget',
    'formatter' => 'entity_reference_label',
  ];
}

/**
 * Creates a node reference limited to one content bundle.
 */
function reg_core_node_reference_field(string $label, string $bundle, int $cardinality = 1, bool $required = FALSE, bool $translatable = TRUE): array {
  return [
    'type' => 'entity_reference',
    'label' => $label,
    'required' => $required,
    'translatable' => $translatable,
    'cardinality' => $cardinality,
    'storage_settings' => ['target_type' => 'node'],
    'field_settings' => [
      'handler' => 'default:node',
      'handler_settings' => ['target_bundles' => [$bundle => $bundle]],
    ],
    'widget' => 'entity_reference_autocomplete',
    'formatter' => 'entity_reference_label',
  ];
}

