/**
 * Builds the CMS-managed homepage hero and partner content foundation.
 */
function reg_core_apply_homepage_content(): void {
  \Drupal::service('module_installer')->install([
    'block',
    'image',
    'responsive_image',
    'media',
    'media_library',
    'language',
    'content_translation',
  ], TRUE);

  $types = [
    'reg_homepage_hero' => ['Homepage Heroes', 'Published, ordered and translatable homepage hero campaigns.'],
    'reg_partner' => ['Partners', 'Active institutional partner names, logos and approved website links.'],
  ];
  foreach ($types as $id => [$label, $description]) {
    if (!NodeType::load($id)) {
      NodeType::create([
        'type' => $id,
        'name' => $label,
        'description' => $description,
        'new_revision' => TRUE,
        'preview_mode' => 1,
        'display_submitted' => FALSE,
      ])->save();
    }
    $weight = 5;
    foreach (reg_core_field_definitions()[$id] as $field_name => $definition) {
      reg_core_ensure_field($id, $field_name, $definition, $weight);
      $weight += 2;
    }
  }

  $base_definitions = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('node');
  $hero_title = BaseFieldOverride::loadByName('node', 'reg_homepage_hero', 'title')
    ?: BaseFieldOverride::createFromBaseFieldDefinition($base_definitions['title'], 'reg_homepage_hero');
  $hero_title->setLabel('Title')->setTranslatable(TRUE)->save();
  $partner_title = BaseFieldOverride::loadByName('node', 'reg_partner', 'title')
    ?: BaseFieldOverride::createFromBaseFieldDefinition($base_definitions['title'], 'reg_partner');
  $partner_title->setLabel('Partner Name')->setTranslatable(FALSE)->save();

  ContentLanguageSettings::loadByEntityTypeBundle('node', 'reg_homepage_hero')
    ->setDefaultLangcode('site_default')
    ->setLanguageAlterable(TRUE)
    ->setThirdPartySetting('content_translation', 'enabled', TRUE)
    ->save();
  ContentLanguageSettings::loadByEntityTypeBundle('node', 'reg_partner')
    ->setDefaultLangcode('site_default')
    ->setLanguageAlterable(FALSE)
    ->setThirdPartySetting('content_translation', 'enabled', FALSE)
    ->save();

  reg_core_ensure_homepage_image_styles();
  reg_core_place_homepage_blocks();
  reg_core_create_roles();
  reg_core_apply_homepage_demo_data();
}

