function reg_core_apply_homepage_demo_data(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $hero_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'reg_homepage_hero')
    ->range(0, 1)
    ->execute();
  if (!$hero_ids) {
    Node::create([
      'type' => 'reg_homepage_hero',
      'langcode' => 'en',
      'uid' => 1,
      'title' => 'Energy with a vision for the future',
      'field_reg_subtitle' => 'Driving Rwanda’s progress through sustainable and reliable power solutions.',
      'field_reg_primary_cta_label' => 'Check outages',
      'field_reg_primary_cta_url' => ['uri' => 'internal:/outages'],
      'field_reg_secondary_cta_label' => 'Online services',
      'field_reg_secondary_cta_url' => ['uri' => 'internal:/online-services'],
      'field_reg_order' => 0,
      'field_reg_active' => 1,
      'status' => 1,
    ])->save();
  }

  foreach (['MININFRA', 'RURA', 'EUCL', 'EDCL'] as $weight => $name) {
    $existing = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'reg_partner')
      ->condition('title', $name)
      ->range(0, 1)
      ->execute();
    if ($existing) {
      continue;
