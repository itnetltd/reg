    'reg_sports_video',
  ];
}

/**
 * Enhances the existing branch bundle and customer-support governance.
 */
function reg_core_apply_customer_support_phase(): void {
  \Drupal::service('module_installer')->install([
    'taxonomy',
    'language',
    'content_translation',
    'workflows',
    'content_moderation',
  ], TRUE);

  reg_core_ensure_branch_taxonomies();
  $fields = [
    'field_reg_entity' => reg_core_list_field('REG entity', reg_core_company_options(), TRUE, FALSE),
    'field_reg_branch_type' => reg_core_list_field('Branch type', [
      'customer_service_center' => 'Customer service center',
      'regional_office' => 'Regional office',
      'headquarters' => 'Headquarters or main office',
      'official_branch_service_area' => 'Branch / service area',
    ], TRUE, FALSE),
    'field_reg_province' => reg_core_term_reference_field('Province', 'reg_province', TRUE, FALSE),
    'field_reg_district_ref' => reg_core_term_reference_field('District', 'reg_district', TRUE, FALSE),
    'field_reg_district' => reg_core_string_field('Legacy district name', FALSE),
    'field_reg_sector' => reg_core_string_field('Sector', FALSE),
    'field_reg_cell' => reg_core_string_field('Cell', FALSE),
    'field_reg_village' => reg_core_string_field('Village', FALSE),
    'field_reg_address' => [
      'type' => 'string_long',
      'label' => 'Physical address',
      'required' => TRUE,
      'translatable' => TRUE,
      'widget' => 'string_textarea',
      'formatter' => 'basic_string',
    ],
    'field_reg_latitude' => reg_core_decimal_field('Latitude', 10, 7, FALSE),
    'field_reg_longitude' => reg_core_decimal_field('Longitude', 10, 7, FALSE),
    'field_reg_phone' => reg_core_string_field('Telephone', FALSE, TRUE),
    'field_reg_phone_secondary' => reg_core_string_field('Secondary telephone', FALSE),
    'field_reg_email' => [
      'type' => 'email',
      'label' => 'Email',
      'required' => TRUE,
      'translatable' => FALSE,
      'widget' => 'email_default',
      'formatter' => 'email_mailto',
    ],
    'field_reg_opening_hours' => reg_core_long_text_field('Opening hours'),
    'field_reg_branch_services' => array_replace(
      reg_core_term_reference_field('Services available', 'reg_branch_service', FALSE, FALSE),
      ['cardinality' => -1],
    ),
    'field_reg_accessibility' => reg_core_long_text_field('Accessibility information'),
    'field_reg_public_notes' => reg_core_long_text_field('Public notes'),
    'field_reg_map_url' => array_replace([
      'type' => 'link',
      'label' => 'Map directions URL',
      'required' => FALSE,
      'widget' => 'link_default',
      'formatter' => 'link',
    ], ['translatable' => FALSE]),
    'field_reg_featured' => reg_core_boolean_field('Featured or main office', FALSE),
    'field_reg_active' => reg_core_boolean_field('Active branch', FALSE),
    'field_reg_review_date' => array_replace(
      reg_core_date_field('Next branch review date', FALSE),
      ['storage_settings' => ['datetime_type' => 'date']],
    ),
    'field_reg_content_department' => reg_core_string_field('Responsible department', FALSE),
  ];
  $weight = 5;
  foreach ($fields as $field_name => $definition) {
    reg_core_ensure_field('reg_branch', $field_name, $definition, $weight);
    $weight += 2;
  }

  $base_definitions = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('node');
  $title = BaseFieldOverride::loadByName('node', 'reg_branch', 'title')
    ?: BaseFieldOverride::createFromBaseFieldDefinition($base_definitions['title'], 'reg_branch');
  $title->setLabel('Branch name')->setTranslatable(FALSE)->save();

  ContentLanguageSettings::loadByEntityTypeBundle('node', 'reg_branch')
    ->setDefaultLangcode('site_default')
    ->setLanguageAlterable(TRUE)
    ->setThirdPartySetting('content_translation', 'enabled', TRUE)
    ->save();
  reg_core_configure_customer_service_workflow();
  reg_core_create_roles();

  $config = \Drupal::configFactory()->getEditable('reg_core.settings');
  $defaults = [
    'support.complaint_mode' => 'external',
    'support.complaint_url' => '',
    'support.fault_reporting_url' => '',
    'support.complaint_email' => '',
    'support.complaint_api_endpoint' => '',
    'support.complaint_integration_enabled' => FALSE,
    'support.general_email' => '',
    'support.general_telephone' => '',
    'branches.map_provider' => 'none',
    'branches.results_per_page' => 12,
    'governance.branch_review_days' => 180,
    'governance.faq_review_days' => 180,
    'governance.service_review_days' => 180,
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->set('links.branch_contacts', '/branches')->save(TRUE);
}

/**
 * Creates reusable branch location and service classifications.
 */
function reg_core_ensure_branch_taxonomies(): void {
  $definitions = [
    'reg_province' => ['Rwanda provinces', [
      'City of Kigali',
      'Eastern Province',
      'Northern Province',
      'Southern Province',
      'Western Province',
    ]],
    'reg_district' => ['Rwanda districts', []],
    'reg_branch_service' => ['Branch services', [
      'Billing support',
      'Fault reporting',
      'Meter services',
      'New connections',
      'Payments guidance',
      'Service complaints',
      'Tariff information',
    ]],
  ];
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach ($definitions as $id => [$label, $terms]) {
    $vocabulary = Vocabulary::load($id) ?: Vocabulary::create(['vid' => $id, 'name' => $label]);
    $vocabulary->save();
    $existing = [];
    foreach ($storage->loadTree($id) as $term) {
      $existing[mb_strtolower($term->name)] = TRUE;
    }
    foreach ($terms as $term_name) {
      if (!isset($existing[mb_strtolower($term_name)])) {
        Term::create(['vid' => $id, 'name' => $term_name])->save();
      }
    }
  }
}

/**
 * Configures branch and service approval without duplicating FAQ governance.
 */
function reg_core_configure_customer_service_workflow(): void {
  $workflow = Workflow::load('reg_customer_service_editorial');
  if (!$workflow) {
    $workflow = Workflow::create([
      'id' => 'reg_customer_service_editorial',
      'label' => 'REG customer service editorial',
      'type' => 'content_moderation',
      'type_settings' => [
        'states' => [
          'draft' => ['label' => 'Draft', 'weight' => 0, 'published' => FALSE, 'default_revision' => FALSE],
          'needs_review' => ['label' => 'Needs Review', 'weight' => 5, 'published' => FALSE, 'default_revision' => FALSE],
          'published' => ['label' => 'Published', 'weight' => 10, 'published' => TRUE, 'default_revision' => TRUE],
          'archived' => ['label' => 'Archived', 'weight' => 20, 'published' => FALSE, 'default_revision' => TRUE],
        ],
        'transitions' => [
          'create_new_draft' => ['label' => 'Create New Draft', 'from' => ['draft', 'needs_review', 'published', 'archived'], 'to' => 'draft', 'weight' => 0],
          'submit_for_review' => ['label' => 'Submit for Review', 'from' => ['draft'], 'to' => 'needs_review', 'weight' => 5],
          'return_to_draft' => ['label' => 'Return to Draft', 'from' => ['needs_review'], 'to' => 'draft', 'weight' => 10],
          'publish' => ['label' => 'Publish', 'from' => ['needs_review', 'published'], 'to' => 'published', 'weight' => 15],
          'archive' => ['label' => 'Archive', 'from' => ['published', 'archived'], 'to' => 'archived', 'weight' => 20],
        ],
        'entity_types' => [],
        'default_moderation_state' => 'draft',
      ],
    ]);
  }
  $moderation = $workflow->getTypePlugin();
  if ($moderation instanceof ContentModerationInterface) {
    foreach (['reg_service', 'reg_branch', 'reg_public_alert', 'reg_outage'] as $bundle) {
      $moderation->addEntityTypeAndBundle('node', $bundle);
    }
  }
  $workflow->save();
}

/**
 * Completes bilingual configuration and public-content translation policy.
 */
function reg_core_apply_multilingual_completion(): void {
  \Drupal::service('module_installer')->install([
    'language',
    'locale',
    'content_translation',
    'config_translation',
  ], TRUE);
  if (!ConfigurableLanguage::load('rw')) {
    ConfigurableLanguage::createFromLangcode('rw')->save();
  }
  $negotiation = \Drupal::configFactory()->getEditable('language.negotiation');
  $negotiation
    ->set('url.source', 'path_prefix')
    ->set('url.prefixes.en', '')
    ->set('url.prefixes.rw', 'rw')
    ->set('url.domains.en', '')
    ->set('url.domains.rw', '')
    ->save(TRUE);

  $bundles = reg_core_public_bundles();
  $node_type_storage = \Drupal::entityTypeManager()->getStorage('node_type');
  $field_manager = \Drupal::service('entity_field.manager');
  foreach ($bundles as $bundle) {
    if (!$node_type_storage->load($bundle)) {
      continue;
    }
    ContentLanguageSettings::loadByEntityTypeBundle('node', $bundle)
      ->setDefaultLangcode('site_default')
      ->setLanguageAlterable(TRUE)
      ->setThirdPartySetting('content_translation', 'enabled', TRUE)
      ->save();

    $priority_fields = [
      'field_reg_translation_priority' => reg_core_list_field('Translation priority', [
        'priority_1' => 'Priority 1 - critical customer service',
        'priority_2' => 'Priority 2 - public information',
        'standard' => 'Standard',
      ], FALSE, FALSE),
      'field_reg_translation_requested' => reg_core_boolean_field('Translation requested', FALSE),
      'field_reg_translation_review' => array_replace(
        reg_core_date_field('Translation review date', FALSE),
        ['storage_settings' => ['datetime_type' => 'date']],
      ),
      'field_reg_content_department' => reg_core_string_field('Responsible department', FALSE),
    ];
    $weight = 90;
    foreach ($priority_fields as $field_name => $definition) {
      reg_core_ensure_field($bundle, $field_name, $definition, $weight);
      $weight += 2;
    }

    foreach ($field_manager->getFieldDefinitions('node', $bundle) as $field_name => $definition) {
      $field = FieldConfig::loadByName('node', $bundle, $field_name);
      if (!$field) {
        continue;
      }
      $type = $definition->getType();
      $nontranslatable_types = [
        'boolean',
        'datetime',
        'decimal',
        'email',
        'entity_reference',
        'file',
        'image',
        'integer',
        'link',
        'list_integer',
        'list_string',
        'timestamp',
      ];
      $nontranslatable_name = preg_match(
        '/(_id|_key|_reference|_phone|_telephone|_email|_latitude|_longitude|_score|_date|_url|_status|_type|_entity|_sport|_team|_position|_season|_competition|_category|_method|_language|_number|_order|_priority|_owner|_source|_venue|_district|_province|_sector|_cell|_village|_nationality|_height|_points|_rebounds|_assists|_steals|_blocks|_kills|_aces|_contact)$/',
        $field_name,
      );
      $nontranslatable_name = $nontranslatable_name || in_array($field_name, [
        'field_reg_away_team_name',
        'field_reg_awarded_supplier',
        'field_reg_home_team_name',
        'field_reg_opponent',
        'field_reg_other_stats',
        'field_reg_photo_credit',
        'field_reg_quarter_scores',
        'field_reg_set_scores',
      ], TRUE);
      $field->setTranslatable(
        !in_array($type, $nontranslatable_types, TRUE) && !$nontranslatable_name,
      )->save();
    }
  }

  $base_definitions = $field_manager->getBaseFieldDefinitions('node');
  $proper_name_bundles = [
    'reg_branch',
    'reg_leader',
    'reg_employee_recognition',
    'reg_sports_team',
    'reg_sports_player',
    'reg_sports_membership',
    'reg_sports_staff',
    'reg_sports_fixture',
    'reg_sports_standing',
  ];
  foreach ($bundles as $bundle) {
    if (!$node_type_storage->load($bundle)) {
      continue;
    }
    $title = BaseFieldOverride::loadByName('node', $bundle, 'title')
      ?: BaseFieldOverride::createFromBaseFieldDefinition($base_definitions['title'], $bundle);
    $title->setTranslatable(!in_array($bundle, $proper_name_bundles, TRUE))->save();
  }

  reg_core_create_roles();
}

