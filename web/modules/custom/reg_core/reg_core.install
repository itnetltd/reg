/**
 * Creates a field and configures its default displays.
 */
function reg_core_ensure_field(string $bundle, string $field_name, array $definition, int $weight): void {
  $storage = FieldStorageConfig::loadByName('node', $field_name);
  if (!$storage) {
    $storage = FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'type' => $definition['type'],
      'cardinality' => $definition['cardinality'] ?? 1,
      'translatable' => $definition['translatable'] ?? TRUE,
      'settings' => $definition['storage_settings'] ?? [],
    ]);
    $storage->save();
  }
  elseif ($definition['type'] === 'list_string' && isset($definition['storage_settings']['allowed_values'])) {
    $storage->setSetting('allowed_values', $definition['storage_settings']['allowed_values']);
    $storage->save();
  }

  $field = FieldConfig::loadByName('node', $bundle, $field_name);
  if (!$field) {
    $field = FieldConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'bundle' => $bundle,
      'label' => $definition['label'],
      'description' => $definition['description'] ?? '',
      'required' => $definition['required'] ?? FALSE,
      'translatable' => $definition['translatable'] ?? TRUE,
      'settings' => $definition['field_settings'] ?? [],
    ]);
    $field->save();
  }
  else {
    $field
      ->setLabel($definition['label'])
      ->setRequired($definition['required'] ?? FALSE)
      ->setTranslatable($definition['translatable'] ?? TRUE)
      ->setSettings($definition['field_settings'] ?? []);
    if (array_key_exists('description', $definition)) {
      $field->setDescription($definition['description']);
    }
    $field->save();
  }

  $form_display = EntityFormDisplay::load("node.$bundle.default") ?: EntityFormDisplay::create([
    'targetEntityType' => 'node',
    'bundle' => $bundle,
    'mode' => 'default',
    'status' => TRUE,
  ]);
  $form_display->setComponent($field_name, [
    'type' => $definition['widget'],
    'weight' => $weight,
    'settings' => $definition['widget_settings'] ?? [],
  ])->save();

  $view_display = EntityViewDisplay::load("node.$bundle.default") ?: EntityViewDisplay::create([
    'targetEntityType' => 'node',
    'bundle' => $bundle,
    'mode' => 'default',
    'status' => TRUE,
  ]);
  $view_display->setComponent($field_name, [
    'type' => $definition['formatter'],
    'label' => 'above',
    'weight' => $weight,
    'settings' => $definition['formatter_settings'] ?? [],
  ])->save();
}

/**
 * Builds reusable CMS-managed section heroes and imports their safe defaults.
 */
function reg_core_apply_section_heroes(): void {
  \Drupal::service('module_installer')->install([
    'image',
    'responsive_image',
    'media',
    'media_library',
    'language',
    'content_translation',
    'workflows',
    'content_moderation',
  ], TRUE);

  $type = NodeType::load('reg_section_hero');
  if (!$type) {
    $type = NodeType::create([
      'type' => 'reg_section_hero',
      'name' => 'Section Hero',
      'description' => 'Reusable, translated section-page hero backgrounds, text, and optional page overrides.',
      'new_revision' => TRUE,
      'preview_mode' => 1,
      'display_submitted' => FALSE,
    ]);
    $type->save();
  }
  $fields = reg_core_field_definitions()['reg_section_hero'];
  $weight = 5;
  foreach ($fields as $field_name => $definition) {
    reg_core_ensure_field('reg_section_hero', $field_name, $definition, $weight);
    $weight += 2;
  }

  $base_definitions = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('node');
  $title = BaseFieldOverride::loadByName('node', 'reg_section_hero', 'title')
    ?: BaseFieldOverride::createFromBaseFieldDefinition($base_definitions['title'], 'reg_section_hero');
  $title->setLabel('Title')->setTranslatable(TRUE)->save();
  ContentLanguageSettings::loadByEntityTypeBundle('node', 'reg_section_hero')
    ->setDefaultLangcode('site_default')
    ->setLanguageAlterable(TRUE)
    ->setThirdPartySetting('content_translation', 'enabled', TRUE)
    ->save();

  reg_core_configure_section_hero_workflow();
  reg_core_ensure_section_hero_image_styles();
  reg_core_create_roles();
  reg_core_apply_section_hero_defaults();
}

/**
 * Creates the bounded desktop and mobile section-hero derivatives.
 */
function reg_core_ensure_section_hero_image_styles(): void {
  $styles = [
    'reg_section_hero_desktop' => ['REG section hero desktop 1920x640', 1920, 640],
    'reg_section_hero_mobile' => ['REG section hero mobile 900x700', 900, 700],
  ];
  foreach ($styles as $name => [$label, $width, $height]) {
    if (ImageStyle::load($name)) {
      continue;
    }
    $style = ImageStyle::create(['name' => $name, 'label' => $label]);
    $style->addImageEffect([
      'id' => 'image_scale_and_crop',
      'weight' => 0,
      'data' => [
        'width' => $width,
        'height' => $height,
        'anchor' => 'center-center',
        'upscale' => FALSE,
      ],
    ]);
    $style->save();
  }

  if (!ResponsiveImageStyle::load('reg_section_hero')) {
    $responsive = ResponsiveImageStyle::create([
      'id' => 'reg_section_hero',
      'label' => 'REG section hero',
      'breakpoint_group' => 'reg_theme',
      'fallback_image_style' => 'reg_section_hero_desktop',
    ]);
    $responsive->addImageStyleMapping('reg_theme.mobile', '1x', [
      'image_mapping_type' => 'image_style',
      'image_mapping' => 'reg_section_hero_mobile',
    ]);
    $responsive->addImageStyleMapping('reg_theme.desktop', '1x', [
      'image_mapping_type' => 'image_style',
      'image_mapping' => 'reg_section_hero_desktop',
    ]);
    $responsive->save();
  }
}

/**
 * Configures Draft, Needs Review, Published, and Archived hero governance.
 */
function reg_core_configure_section_hero_workflow(): void {
  $workflow = Workflow::load('reg_section_hero_editorial');
  if (!$workflow) {
    $workflow = Workflow::create([
      'id' => 'reg_section_hero_editorial',
      'label' => 'REG Section Hero editorial',
      'type' => 'content_moderation',
      'type_settings' => [
        'states' => [
          'draft' => ['label' => 'Draft', 'weight' => 0, 'published' => FALSE, 'default_revision' => FALSE],
          'needs_review' => ['label' => 'Needs Review', 'weight' => 5, 'published' => FALSE, 'default_revision' => FALSE],
          'published' => ['label' => 'Published', 'weight' => 10, 'published' => TRUE, 'default_revision' => TRUE],
          'archived' => ['label' => 'Archived', 'weight' => 20, 'published' => FALSE, 'default_revision' => TRUE],
        ],
        'transitions' => [
          'create_new_draft' => ['label' => 'Create New Draft', 'from' => ['draft', 'needs_review', 'published', 'archived'], 'to' => 'draft', 'weight' => 0],
          'submit_for_review' => ['label' => 'Submit for Review', 'from' => ['draft'], 'to' => 'needs_review', 'weight' => 5],
          'return_to_draft' => ['label' => 'Return to Draft', 'from' => ['needs_review'], 'to' => 'draft', 'weight' => 10],
          'publish' => ['label' => 'Publish', 'from' => ['needs_review', 'published'], 'to' => 'published', 'weight' => 15],
          'archive' => ['label' => 'Archive', 'from' => ['published', 'archived'], 'to' => 'archived', 'weight' => 20],
        ],
        'entity_types' => [],
        'default_moderation_state' => 'draft',
      ],
    ]);
  }
  $moderation = $workflow->getTypePlugin();
  if ($moderation instanceof ContentModerationInterface) {
    $moderation->addEntityTypeAndBundle('node', 'reg_section_hero');
  }
  $workflow->save();
}

/**
 * Imports one fallback image as a published image Media entity.
 */
function reg_core_import_section_hero_media(string $key, string $filename, string $label): ?MediaInterface {
  $source = DRUPAL_ROOT . '/modules/custom/reg_core/assets/section-heroes/' . $filename;
  if (!is_file($source)) {
    return NULL;
  }
  $destination_directory = 'public://section-heroes';
  if (!\Drupal::service('file_system')->prepareDirectory(
    $destination_directory,
    FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS,
  )) {
    return NULL;
  }

  $destination = $destination_directory . '/' . $filename;
  $file_storage = \Drupal::entityTypeManager()->getStorage('file');
  $files = $file_storage->loadByProperties(['uri' => $destination]);
  $file = $files ? reset($files) : NULL;
  if (!$file) {
    $file = \Drupal::service('file.repository')->writeData(
      (string) file_get_contents($source),
      $destination,
      FileExists::Replace,
    );
  }
  if (!$file) {
    return NULL;
  }
  if (!$file->isPermanent()) {
    $file->setPermanent();
    $file->save();
  }

  $media_storage = \Drupal::entityTypeManager()->getStorage('media');
  $media_ids = $media_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('bundle', 'image')
    ->condition('field_media_image.target_id', $file->id())
    ->sort('mid', 'ASC')
    ->range(0, 1)
    ->execute();
  $media = $media_ids ? $media_storage->load(reset($media_ids)) : NULL;
  if (!$media instanceof MediaInterface) {
    $media = Media::create([
      'bundle' => 'image',
      'name' => $label . ' section hero background',
      'uid' => 1,
      'status' => 1,
      'field_media_image' => [
        'target_id' => $file->id(),
        'alt' => 'Abstract REG background for ' . $label,
      ],
    ]);
    $media->save();
  }
  return $media;
}

/**
 * Creates the seven section defaults and Branch Locator override once.
 */
function reg_core_apply_section_hero_defaults(): void {
  $defaults = [
    'about_reg' => ['About REG', 'About REG', '', 'about-reg.png'],
    'what_we_do' => ['What We Do', 'What We Do', '', 'what-we-do.png'],
    'customer_services' => ['What do you need help with?', 'Customer Services', 'Start with the utility you need and continue through an approved REG channel.', 'customer-services.png'],
    'public_information' => ['Public Information Hub', 'Official Information', 'Find approved procurement opportunities, careers information, and official REG Group publications in one place.', 'public-information.png'],
    'media_center' => ['Media Center', 'REG Updates', '', 'media-center.png'],
    'sports' => ['REG Sports', 'REG Sports', 'Official fixtures, results, teams and stories from REG Sports.', 'sports.png'],
    'contact_branches' => ['Contact REG', 'Customer Support', 'Find approved REG contact channels and public service points.', 'contact-branches.png'],
  ];
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $media = [];
  foreach ($defaults as $key => [$title, $eyebrow, $description, $filename]) {
    $media[$key] = reg_core_import_section_hero_media($key, $filename, $title);
    $ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'reg_section_hero')
      ->condition('field_reg_section_key', $key)
      ->sort('field_reg_order', 'ASC')
      ->sort('nid', 'ASC')
      ->execute();
    $existing_default = FALSE;
    foreach ($storage->loadMultiple($ids) as $candidate) {
      if ($candidate->get('field_reg_page_paths')->isEmpty() || trim((string) $candidate->get('field_reg_page_paths')->value) === '') {
        $existing_default = TRUE;
        break;
      }
    }
    if ($existing_default) {
      continue;
    }
    $values = [
      'type' => 'reg_section_hero',
      'langcode' => 'en',
      'uid' => 1,
      'title' => $title,
      'field_reg_eyebrow' => $eyebrow,
      'field_reg_description' => $description,
      'field_reg_section_key' => $key,
      'field_reg_text_alignment' => 'left',
      'field_reg_text_theme' => 'light_background',
      'field_reg_overlay_strength' => 'light',
      'field_reg_active' => 1,
      'field_reg_order' => 0,
      'status' => 1,
      'moderation_state' => 'published',
    ];
    if ($media[$key]) {
      $values['field_reg_background_image'] = ['target_id' => $media[$key]->id()];
    }
    Node::create($values)->save();
  }

  $branch_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'reg_section_hero')
    ->condition('field_reg_section_key', 'contact_branches')
    ->execute();
  $branch_exists = FALSE;
  foreach ($storage->loadMultiple($branch_ids) as $candidate) {
    if (trim((string) $candidate->get('field_reg_page_paths')->value) === '/branches') {
      $branch_exists = TRUE;
      break;
    }
  }
  if (!$branch_exists) {
    $values = [
      'type' => 'reg_section_hero',
      'langcode' => 'en',
      'uid' => 1,
      'title' => 'Branch Locator',
      'field_reg_eyebrow' => 'Customer Support',
      'field_reg_description' => 'Search active public REG, EUCL and EDCL service points.',
      'field_reg_section_key' => 'contact_branches',
      'field_reg_text_alignment' => 'left',
      'field_reg_text_theme' => 'light_background',
      'field_reg_overlay_strength' => 'light',
      'field_reg_active' => 1,
      'field_reg_order' => -10,
      'field_reg_page_paths' => '/branches',
      'status' => 1,
      'moderation_state' => 'published',
    ];
    if (!empty($media['contact_branches'])) {
      $values['field_reg_background_image'] = ['target_id' => $media['contact_branches']->id()];
    }
    Node::create($values)->save();
  }
}

/**
 * Builds the moderated, scheduled and translated Public Alert system.
 */
function reg_core_apply_public_alerts(): void {
  \Drupal::service('module_installer')->install([
    'block',
    'language',
    'locale',
    'content_translation',
    'workflows',
    'content_moderation',
  ], TRUE);

  $type = NodeType::load('reg_public_alert');
  if (!$type) {
    $type = NodeType::create([
      'type' => 'reg_public_alert',
      'name' => 'Public Alert',
      'description' => 'Scheduled, translated homepage or sitewide notices governed by the REG editorial workflow.',
      'new_revision' => TRUE,
      'preview_mode' => 1,
      'display_submitted' => FALSE,
    ]);
    $type->save();
  }

  $weight = 5;
  foreach (reg_core_field_definitions()['reg_public_alert'] as $field_name => $definition) {
    reg_core_ensure_field('reg_public_alert', $field_name, $definition, $weight);
    $weight += 2;
  }

  $base_definitions = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('node');
  $title = BaseFieldOverride::loadByName('node', 'reg_public_alert', 'title')
    ?: BaseFieldOverride::createFromBaseFieldDefinition($base_definitions['title'], 'reg_public_alert');
  $title->setLabel('Alert title')->setTranslatable(TRUE)->save();
  ContentLanguageSettings::loadByEntityTypeBundle('node', 'reg_public_alert')
    ->setDefaultLangcode('site_default')
    ->setLanguageAlterable(TRUE)
    ->setThirdPartySetting('content_translation', 'enabled', TRUE)
    ->save();

  reg_core_configure_customer_service_workflow();
  reg_core_create_roles();
  reg_core_place_public_alert_block();
  reg_core_apply_public_alert_default();
}

/**
 * Places the single alert selector below the header on all public pages.
 */
function reg_core_place_public_alert_block(): void {
  $block = Block::load('reg_public_alert') ?: Block::create([
    'id' => 'reg_public_alert',
    'plugin' => 'reg_core_public_alert',
    'theme' => 'reg_theme',
  ]);
  $block
    ->setRegion('public_alert')
    ->setWeight(0)
    ->setStatus(TRUE)
    ->set('settings', [
      'id' => 'reg_core_public_alert',
      'label' => 'Public alert',
      'label_display' => FALSE,
      'provider' => 'reg_core',
    ])
    ->set('visibility', [])
    ->save();
}

/**
 * Migrates the prior static homepage notice once using a stable UUID.
 */
function reg_core_apply_public_alert_default(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $existing = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'reg_public_alert')
    ->condition('uuid', '748eb19f-cc31-4d57-8ef0-b2cb803b95e4')
    ->range(0, 1)
    ->execute();
  if ($existing) {
    return;
  }

  Node::create([
    'uuid' => '748eb19f-cc31-4d57-8ef0-b2cb803b95e4',
