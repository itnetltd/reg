      'field_reg_wwd_key' => 'homepage',
      'field_reg_order' => $default['order'],
      'field_reg_active' => 1,
      'field_reg_show_homepage' => 1,
      'field_reg_source_id' => 'homepage-stat:' . $key,
      'field_reg_content_review' => 'approved',
      'status' => 1,
    ])->save();
  }
}

/**
 * Places the optional REG At a Glance block on the front page.
 */
function reg_core_place_homepage_statistics_block(): void {
  $block = Block::load('reg_homepage_statistics');
  $is_new = !$block;
  $block = $block ?: Block::create([
    'id' => 'reg_homepage_statistics',
    'plugin' => 'reg_core_homepage_statistics',
    'theme' => 'reg_theme',
  ]);
  $block
    ->setRegion('homepage_stats')
    ->setWeight(0)
    ->set('settings', [
      'id' => 'reg_core_homepage_statistics',
      'label' => 'REG At a Glance',
      'label_display' => FALSE,
      'provider' => 'reg_core',
    ])
    ->setVisibilityConfig('request_path', [
      'id' => 'request_path',
      'negate' => FALSE,
      'pages' => '<front>',
    ]);
  if ($is_new) {
    $block->setStatus(FALSE);
  }
  $block->save();
}

/**
 * Preserves reusable categorized facts without a duplicate homepage block.
 */
function reg_core_apply_energy_at_glance(): void {
  reg_core_apply_homepage_statistics();
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $primary = [
    'homepage-installed-generation-capacity' => [
      'category' => 'generation',
      'page' => 'generation',
      'period' => 'June 2026',
    ],
    'homepage-transmission-network-length' => [
      'category' => 'transmission',
      'page' => 'transmission',
      'period' => 'June 2026',
    ],
    'homepage-national-electricity-access' => [
      'category' => 'access',
      'page' => 'access',
      'period' => 'June 2026',
    ],
  ];
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'reg_fact')
    ->execute();
  foreach ($storage->loadMultiple($ids) as $node) {
    if (!$node instanceof NodeInterface) {
      continue;
    }
    $key = (string) $node->get('field_reg_fact_key')->value;
    $page = (string) $node->get('field_reg_wwd_key')->value;
    $category = $primary[$key]['category'] ?? match (TRUE) {
      $page === 'generation', str_starts_with($key, 'generation-') => 'generation',
      $page === 'transmission', str_starts_with($key, 'transmission-') => 'transmission',
      $page === 'access', str_starts_with($key, 'access-') => 'access',
      default => 'other',
    };
    $role = preg_match('/(?:on-grid|off-grid|220kv|220-kv|110kv|110-kv)/', $key) ? 'secondary' : 'headline';
    $changed = FALSE;
    if ($node->get('field_reg_fact_category')->isEmpty()) {
      $node->set('field_reg_fact_category', $category);
      $changed = TRUE;
    }
    if ($node->get('field_reg_fact_role')->isEmpty()) {
      $node->set('field_reg_fact_role', $role);
      $changed = TRUE;
    }
    if (isset($primary[$key])) {
      if ($page === '' || $page === 'homepage') {
        $node->set('field_reg_wwd_key', $primary[$key]['page']);
        $changed = TRUE;
      }
      $period = (string) $node->get('field_reg_reporting_period')->value;
      if ($period === '' || $period === 'Current approved reporting period') {
        $node->set('field_reg_reporting_period', $primary[$key]['period']);
        $changed = TRUE;
      }
      if ($node->get('field_reg_internal_source_note')->isEmpty()) {
        $node->set('field_reg_internal_source_note', 'Internal approved operational report. Confirmed for manual publication by authorized REG staff.');
        $changed = TRUE;
      }
    }
    if ($changed) {
      $node->save();
    }
  }

  // REG At a Glance is the single homepage statistics presentation. The
  // categorized facts remain available to What We Do pages and editors.
  Block::load('reg_energy_at_glance')?->delete();
}

/**
 * Builds the manual, revisioned outage announcement model.
 */
function reg_core_apply_manual_outages(): void {
  \Drupal::service('module_installer')->install(['taxonomy', 'media', 'media_library', 'language', 'content_translation', 'workflows', 'content_moderation'], TRUE);
  reg_core_ensure_branch_taxonomies();
  $sector_vocabulary = Vocabulary::load('reg_sector') ?: Vocabulary::create(['vid' => 'reg_sector', 'name' => 'Rwanda sectors']);
  $sector_vocabulary->save();
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach (['Gasabo', 'Nyarugenge'] as $district) {
    $ids = $term_storage->getQuery()->accessCheck(FALSE)->condition('vid', 'reg_district')->condition('name', $district)->range(0, 1)->execute();
    if (!$ids) {
      Term::create(['vid' => 'reg_district', 'name' => $district])->save();
    }
  }
  foreach (['Gisozi', 'Kinyinya', 'Kacyiru', 'Muhima', 'Nyarugenge', 'Kimihurura', 'Remera', 'Kimironko', 'Nyarutarama'] as $sector) {
    $ids = $term_storage->getQuery()->accessCheck(FALSE)->condition('vid', 'reg_sector')->condition('name', $sector)->range(0, 1)->execute();
    if (!$ids) {
      Term::create(['vid' => 'reg_sector', 'name' => $sector])->save();
    }
  }
  $date_time = ['type' => 'datetime', 'label' => 'Date and time', 'required' => FALSE, 'translatable' => FALSE, 'storage_settings' => ['datetime_type' => 'datetime'], 'widget' => 'datetime_default', 'formatter' => 'datetime_default'];
  $fields = [
    'field_reg_announcement_ref' => reg_core_string_field('Announcement reference', FALSE),
    'field_reg_announcement_date' => reg_core_date_field('Announcement date', FALSE),
    'field_reg_outage_type' => reg_core_list_field('Outage type', ['planned_maintenance' => 'Planned Maintenance', 'planned_upgrade' => 'Planned Network Upgrade / Extension', 'emergency' => 'Emergency / Unplanned Outage', 'network_repair' => 'Network Repair', 'other' => 'Other'], TRUE, FALSE),
    'field_reg_reason' => reg_core_long_text_field('Reason / purpose'),
    'field_reg_network_element' => reg_core_string_field('Substation / network element'),
    'field_reg_outage_status' => reg_core_list_field('Operational status', ['scheduled' => 'Scheduled', 'ongoing' => 'Ongoing', 'restored' => 'Restored', 'postponed' => 'Postponed', 'cancelled' => 'Cancelled', 'archived' => 'Archived'], TRUE, FALSE),
    'field_reg_outage_segments' => ['type' => 'reg_outage_segment', 'label' => 'Outage schedule windows', 'required' => TRUE, 'translatable' => TRUE, 'cardinality' => -1, 'widget' => 'reg_outage_segment_widget', 'formatter' => 'reg_outage_segment_formatter', 'description' => 'Add one or more windows. Drag rows to change their public display order.'],
    'field_reg_public_summary' => reg_core_long_text_field('Public summary'),
    'field_reg_safety_message' => reg_core_long_text_field('Safety message'),
    'field_reg_customer_message' => reg_core_long_text_field('Customer service message'),
    'field_reg_official_documents' => reg_core_media_reference_field('Official announcement PDF(s)', -1, FALSE, 'document'),
    'field_reg_featured' => reg_core_boolean_field('Feature / show on homepage', FALSE),
    'field_reg_show_public_alert' => reg_core_boolean_field('Show in Public Alert strip', FALSE),
    'field_reg_priority' => reg_core_integer_field('Priority', FALSE),
    'field_reg_outage_source' => reg_core_list_field('Internal source', ['manual' => 'Manual Drupal', 'ge_dms' => 'GE DMS'], TRUE, FALSE),
    'field_reg_postponed_date' => reg_core_date_field('New scheduled date', FALSE),
    'field_reg_status_note' => reg_core_long_text_field('Postponement / cancellation public note'),
    'field_reg_replacement_outage' => reg_core_node_reference_field('Related replacement outage', 'reg_outage', 1, FALSE, FALSE),
    'field_reg_actual_restoration' => array_replace($date_time, ['label' => 'Actual restoration time']),
    'field_reg_restored_early' => reg_core_boolean_field('Restored early', FALSE),
  ];
  $weight = -25;
  foreach ($fields as $field_name => $definition) {
    reg_core_ensure_field('reg_outage', $field_name, $definition, $weight);
    $weight += 2;
  }
  reg_core_ensure_field('reg_public_alert', 'field_reg_related_outage', reg_core_node_reference_field('Related outage', 'reg_outage', 1, FALSE, FALSE), 30);
  $base = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('node');
  $title = BaseFieldOverride::loadByName('node', 'reg_outage', 'title') ?: BaseFieldOverride::createFromBaseFieldDefinition($base['title'], 'reg_outage');
  $title->setLabel('Outage announcement title')->setTranslatable(TRUE)->save();
  ContentLanguageSettings::loadByEntityTypeBundle('node', 'reg_outage')->setDefaultLangcode('site_default')->setLanguageAlterable(TRUE)->setThirdPartySetting('content_translation', 'enabled', TRUE)->save();
  $form = EntityFormDisplay::load('node.reg_outage.default');
  if ($form) {
    foreach (['field_reg_start', 'field_reg_end', 'field_reg_district', 'field_reg_sector', 'field_reg_source_url', 'promote', 'sticky'] as $legacy) {
      $form->removeComponent($legacy);
    }
    $form->setComponent('moderation_state', ['type' => 'moderation_state_default', 'weight' => 90, 'settings' => []]);
    $form->setComponent('revision_log', ['type' => 'string_textarea', 'weight' => 92, 'settings' => []]);
    $form->save();
  }
  reg_core_configure_customer_service_workflow();
  reg_core_create_roles();
  $config = \Drupal::configFactory()->getEditable('reg_core.settings');
  if ($config->get('outages.default_safety_message') === NULL) {
    $config->set('outages.default_safety_message', 'For safety purposes, customers should remain cautious around electrical installations because electricity may be restored before the scheduled time.');
  }
  if ($config->get('outages.default_customer_message') === NULL) {
    $config->set('outages.default_customer_message', 'If your power supply has not been restored by the scheduled time, contact REG through the toll-free customer service line 2727.');
  }
  $config->set('outages.source', 'manual')->save(TRUE);
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()->accessCheck(FALSE)->condition('type', 'reg_outage')->execute();
  foreach ($storage->loadMultiple($ids) as $node) {
    if (!$node instanceof NodeInterface) {
      continue;
    }
    $changed = FALSE;
    if ($node->get('field_reg_outage_segments')->isEmpty() && !$node->get('field_reg_start')->isEmpty()) {
      $node->set('field_reg_outage_segments', [['start' => (string) $node->get('field_reg_start')->value, 'end' => (string) $node->get('field_reg_end')->value, 'districts' => '', 'sectors' => '', 'affected_area' => trim(implode(' — ', array_filter([(string) $node->get('field_reg_district')->value, (string) $node->get('field_reg_sector')->value])))]]);
      $changed = TRUE;
    }
    $status = (string) $node->get('field_reg_outage_status')->value;
    if (in_array($status, ['current', 'planned', 'resolved'], TRUE)) {
      $node->set('field_reg_outage_status', ['current' => 'ongoing', 'planned' => 'scheduled', 'resolved' => 'restored'][$status]);
      $changed = TRUE;
    }
    if ($node->get('field_reg_outage_type')->isEmpty()) {
      $node->set('field_reg_outage_type', 'planned_maintenance');
      $changed = TRUE;
    }
    if ($node->get('field_reg_outage_source')->isEmpty()) {
      $node->set('field_reg_outage_source', 'manual');
      $changed = TRUE;
    }
    if ($changed) {
      $node->setNewRevision(TRUE);
      $node->setRevisionLogMessage('Migrated to the manual multi-window outage model.');
      $node->save();
    }
  }
  reg_core_seed_manual_outage_samples();
}

/**
 * Builds CMS-managed Homepage Energy Awareness tools and safe defaults.
 */
function reg_core_apply_energy_tools(): void {
  \Drupal::service('module_installer')->install([
    'block',
    'image',
    'media',
    'media_library',
    'language',
    'content_translation',
  ], TRUE);

  if (!NodeType::load('reg_energy_tool')) {
    NodeType::create([
      'type' => 'reg_energy_tool',
      'name' => 'Energy Tools',
      'description' => 'Published and ordered homepage tools for cost, carbon and safety awareness.',
      'new_revision' => TRUE,
      'preview_mode' => 1,
      'display_submitted' => FALSE,
    ])->save();
  }
  $weight = 5;
  foreach (reg_core_field_definitions()['reg_energy_tool'] as $field_name => $definition) {
    reg_core_ensure_field('reg_energy_tool', $field_name, $definition, $weight);
    $weight += 2;
  }

  $base_definitions = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('node');
  $title = BaseFieldOverride::loadByName('node', 'reg_energy_tool', 'title')
    ?: BaseFieldOverride::createFromBaseFieldDefinition($base_definitions['title'], 'reg_energy_tool');
  $title->setLabel('Title')->setTranslatable(TRUE)->save();
  ContentLanguageSettings::loadByEntityTypeBundle('node', 'reg_energy_tool')
    ->setDefaultLangcode('site_default')
    ->setLanguageAlterable(TRUE)
    ->setThirdPartySetting('content_translation', 'enabled', TRUE)
    ->save();

  if (!ImageStyle::load('reg_energy_tool_icon')) {
    $style = ImageStyle::create([
      'name' => 'reg_energy_tool_icon',
      'label' => 'REG energy tool icon 96x96',
    ]);
    $style->addImageEffect([
      'id' => 'image_scale',
      'weight' => 0,
      'data' => ['width' => 96, 'height' => 96, 'upscale' => FALSE],
    ]);
    $style->save();
  }

  $config = \Drupal::configFactory()->getEditable('reg_core.settings');
  if (trim((string) $config->get('tariffs.approved_schedule_effective')) === '') {
    $config->set('tariffs.approved_schedule_effective', '2025-10-01')->save(TRUE);
  }

  reg_core_place_homepage_blocks();
  reg_core_create_roles();
  reg_core_apply_energy_tool_defaults();
}

/**
 * Creates the three approved defaults once without overwriting editor content.
 */
function reg_core_apply_energy_tool_defaults(): void {
  $defaults = [
    'bill_estimator' => [
      'title' => 'Bill Estimator',
      'description' => 'Estimate your monthly electricity cost based on customer category and consumption.',
      'cta_label' => 'Open estimator',
      'cta_uri' => 'internal:/tools/bill-estimator',
      'status' => 'available',
      'order' => 10,
    ],
    'carbon_footprint' => [
      'title' => 'Carbon Footprint',
      'description' => 'Estimate the emissions associated with your electricity consumption.',
      'cta_label' => 'Learn more',
      'cta_uri' => 'internal:/tools/carbon-footprint',
      'status' => 'awaiting_validation',
      'order' => 20,
    ],
    'safety_efficiency' => [
      'title' => 'Safety & Efficiency',
      'description' => 'Learn practical ways to use electricity safely and reduce unnecessary energy consumption.',
      'cta_label' => 'View guidance',
      'cta_uri' => 'internal:/help/faq?category=safety',
      'status' => 'guidance',
      'order' => 30,
    ],
  ];
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($defaults as $key => $default) {
    $existing = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'reg_energy_tool')
      ->condition('field_reg_energy_tool_key', $key)
      ->range(0, 1)
      ->execute();
    if ($existing) {
      continue;
