      'reporting_period' => 'June 2026',
      'decimals' => 1,
      'order' => 40,
    ],
    'homepage-productive-use-areas' => [
      'title' => 'Productive use areas (PUAs) connected',
      'value' => '10477',
      'suffix' => '',
      'supporting_text' => 'Cumulative to date',
      'reporting_period' => 'Cumulative to date',
      'decimals' => 0,
      'order' => 50,
    ],
    'homepage-clean-cooking-stoves' => [
      'title' => 'Clean cooking stoves disseminated',
      'value' => '1820646',
      'suffix' => '',
      'supporting_text' => 'Cumulative dissemination',
      'reporting_period' => 'Cumulative dissemination',
      'decimals' => 0,
      'order' => 60,
    ],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($defaults as $key => $default) {
    $existing = $storage->getQuery()
