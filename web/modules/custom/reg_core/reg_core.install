      'langcode' => 'en',
      'uid' => 1,
      'title' => $name,
      'field_reg_order' => $weight,
      'field_reg_active' => 1,
      'status' => 1,
    ])->save();
  }
}

/**
 * Configures bilingual FAQ translation and its approval workflow.
 */
function reg_core_configure_faq_governance(): void {
  if (!ConfigurableLanguage::load('rw')) {
    ConfigurableLanguage::createFromLangcode('rw')->save();
  }

  $language_settings = ContentLanguageSettings::loadByEntityTypeBundle('node', 'reg_faq');
  $language_settings
    ->setDefaultLangcode('site_default')
    ->setLanguageAlterable(TRUE)
    ->setThirdPartySetting('content_translation', 'enabled', TRUE)
    ->save();

  $language_config = \Drupal::configFactory()->getEditable('language.negotiation');
  $language_config
    ->set('url.prefixes.en', '')
    ->set('url.prefixes.rw', 'rw')
    ->set('url.domains.en', '')
    ->set('url.domains.rw', '')
    ->save(TRUE);

  $workflow = Workflow::load('reg_faq_editorial');
  if (!$workflow) {
    $workflow = Workflow::create([
      'id' => 'reg_faq_editorial',
      'label' => 'REG FAQ Editorial',
      'type' => 'content_moderation',
      'type_settings' => [
        'states' => [
          'draft' => [
            'label' => 'Draft',
            'published' => FALSE,
            'default_revision' => FALSE,
            'weight' => -10,
          ],
          'needs_review' => [
            'label' => 'Needs Review',
            'published' => FALSE,
            'default_revision' => FALSE,
            'weight' => 0,
          ],
          'published' => [
            'label' => 'Published',
            'published' => TRUE,
            'default_revision' => TRUE,
            'weight' => 10,
          ],
        ],
        'transitions' => [
          'create_new_draft' => [
            'label' => 'Create New Draft',
            'from' => ['draft', 'needs_review', 'published'],
            'to' => 'draft',
            'weight' => 0,
          ],
          'submit_for_review' => [
            'label' => 'Submit for Review',
            'from' => ['draft', 'needs_review'],
            'to' => 'needs_review',
            'weight' => 5,
          ],
          'publish' => [
            'label' => 'Publish',
            'from' => ['needs_review', 'published'],
            'to' => 'published',
            'weight' => 10,
          ],
          'return_to_draft' => [
            'label' => 'Return to Draft',
            'from' => ['needs_review'],
            'to' => 'draft',
            'weight' => 15,
          ],
        ],
        'entity_types' => [],
        'default_moderation_state' => 'draft',
      ],
    ]);
  }

  $moderation = $workflow->getTypePlugin();
  if ($moderation instanceof ContentModerationInterface) {
    $moderation->addEntityTypeAndBundle('node', 'reg_faq');
  }
  $workflow->save();
}

/**
 * Applies only the FAQ knowledge-base additions on existing sites.
 */
function reg_core_apply_faq_knowledge_base(): void {
  \Drupal::service('module_installer')->install([
    'language',
    'locale',
    'content_translation',
    'workflows',
    'content_moderation',
  ], TRUE);

  $type = NodeType::load('reg_faq');
  if (!$type) {
    $type = NodeType::create([
      'type' => 'reg_faq',
      'name' => 'FAQ',
      'description' => 'Approved multilingual knowledge content for customer support and the FAQ-first assistant.',
      'new_revision' => TRUE,
      'preview_mode' => 1,
      'display_submitted' => FALSE,
    ]);
    $type->save();
  }

  $weight = 5;
  foreach (reg_core_field_definitions()['reg_faq'] as $field_name => $definition) {
    reg_core_ensure_field('reg_faq', $field_name, $definition, $weight);
    $weight += 2;
  }

  reg_core_configure_faq_governance();
  $site_config = \Drupal::configFactory()->getEditable('reg_core.settings');
  if ($site_config->get('links.branch_contacts') === NULL) {
    $site_config->set('links.branch_contacts', '')->save(TRUE);
  }
  reg_core_create_roles();
  reg_core_ensure_faq_analytics_table();
}

/**
 * Imports official REG FAQs with traceability and review metadata.
 *
 * @return array{created: int, tagged_existing: int, unchanged: int}
 *   Import counts.
 */
function reg_core_apply_official_faq_content(): array {
  reg_core_apply_faq_knowledge_base();

  $relatedStorage = FieldStorageConfig::loadByName('node', 'field_reg_related_url');
  if ($relatedStorage && $relatedStorage->getCardinality() !== FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED) {
    $relatedStorage->setCardinality(FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED)->save();
  }

  // Traceability and workflow fields remain available to editors but are not
  // exposed by the generic canonical node display.
  $display = EntityViewDisplay::load('node.reg_faq.default');
  if ($display) {
    foreach ([
      'field_reg_source_url',
      'field_reg_source_label',
      'field_reg_source_id',
      'field_reg_source_hash',
      'field_reg_source_excerpt',
      'field_reg_review_status',
      'field_reg_review_notes',
    ] as $fieldName) {
      $display->removeComponent($fieldName);
    }
    $display->save();
  }

  return \Drupal::service('reg_core.official_faq_importer')->import();
}

/**
 * Creates the unanswered-query table when updating an existing site.
 */
function reg_core_ensure_faq_analytics_table(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('reg_core_faq_unanswered')) {
    $schema->createTable('reg_core_faq_unanswered', reg_core_schema()['reg_core_faq_unanswered']);
  }
}

/**
 * Applies the Public Information Hub model to new and existing sites.
 */
function reg_core_apply_public_information_hub(): void {
  \Drupal::service('module_installer')->install([
    'taxonomy',
    'file',
    'media',
    'media_library',
    'language',
    'content_translation',
    'workflows',
    'content_moderation',
  ], TRUE);

  foreach ([
    'reg_tender' => ['Tender', 'Procurement opportunities, addenda, clarifications and award notices.'],
    'reg_job' => ['Job vacancy', 'Vacancies, application guidance and recruitment notices.'],
    'reg_publication' => ['Publication', 'Reports, policies, plans, safeguards and official documents.'],
  ] as $id => [$label, $description]) {
    if (!NodeType::load($id)) {
      NodeType::create([
        'type' => $id,
        'name' => $label,
        'description' => $description,
        'new_revision' => TRUE,
        'preview_mode' => 1,
        'display_submitted' => FALSE,
      ])->save();
    }
    $weight = 5;
    foreach (reg_core_field_definitions()[$id] as $field_name => $definition) {
      reg_core_ensure_field($id, $field_name, $definition, $weight);
      $weight += 2;
    }
  }

  reg_core_ensure_public_information_taxonomies();
  reg_core_configure_official_documents();
  reg_core_configure_public_information_governance();
  reg_core_ensure_public_information_tables();
  reg_core_create_roles();

  $config = \Drupal::configFactory()->getEditable('reg_core.settings');
  $defaults = [
    'public_information.enable_tender_submission' => FALSE,
    'public_information.job_application_mode' => 'external',
    'public_information.enable_tender_sms' => FALSE,
    'public_information.allow_zip_uploads' => FALSE,
    'public_information.results_per_page' => 12,
  ];
  $changed = FALSE;
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
      $changed = TRUE;
    }
  }
  if ($changed) {
    $config->save(TRUE);
  }
}

/**
 * Upgrades tender editing/presentation and imports the supplied EDCL record.
 *
 * @return array{node_id: int, media_id: int, file_id: int, created: bool}
 *   IDs for the authoritative tender record and its reused/imported document.
 */
function reg_core_apply_tender_upgrade(): array {
  reg_core_apply_public_information_hub();
  reg_core_configure_tender_form_and_display();
  reg_core_place_homepage_blocks();

  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $terms = $term_storage->loadByProperties([
    'vid' => 'reg_procurement_category',
    'name' => 'Consultancy Services',
  ]);
  $category = $terms ? reset($terms) : Term::create([
    'vid' => 'reg_procurement_category',
    'name' => 'Consultancy Services',
    'weight' => 2,
    'langcode' => 'en',
  ]);
  if ($category->isNew()) {
    $category->save();
  }

  $asset_name = 'Terms_of_reference_for_valuation_of_properties_for_electification_projects.pdf';
  $asset_path = __DIR__ . '/assets/tenders/' . $asset_name;
  $expected_hash = 'b5faaf59e8a96cd8e6a623cbb62f8e8c7bbb0ee8462c747aea7b83ff6008c6e7';
  if (!is_file($asset_path) || hash_file('sha256', $asset_path) !== $expected_hash) {
    throw new \RuntimeException('The authoritative EDCL tender PDF is missing or does not match its approved checksum.');
  }

  $file_storage = \Drupal::entityTypeManager()->getStorage('file');
  $file = NULL;
  $candidate_ids = $file_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('filename', $asset_name)
    ->execute();
  foreach ($file_storage->loadMultiple($candidate_ids) as $candidate) {
    $candidate_path = \Drupal::service('file_system')->realpath($candidate->getFileUri());
    if ($candidate_path && is_file($candidate_path) && hash_file('sha256', $candidate_path) === $expected_hash) {
      $file = $candidate;
      break;
    }
  }
  if (!$file) {
    $tender_directory = 'public://tenders';
    \Drupal::service('file_system')->prepareDirectory(
      $tender_directory,
      FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS,
    );
    $contents = file_get_contents($asset_path);
    if ($contents === FALSE) {
      throw new \RuntimeException('The authoritative EDCL tender PDF could not be read.');
    }
    $file = \Drupal::service('file.repository')->writeData(
      $contents,
      'public://tenders/' . $asset_name,
      FileExists::Replace,
    );
  }
  if (!$file->isPermanent()) {
    $file->setPermanent();
    $file->save();
  }

  $media_storage = \Drupal::entityTypeManager()->getStorage('media');
  $media_ids = $media_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('bundle', 'document')
    ->condition('field_media_document.target_id', $file->id())
    ->range(0, 1)
    ->execute();
  $media = $media_ids ? $media_storage->load(reset($media_ids)) : NULL;
  $media_changed = FALSE;
  if (!$media instanceof MediaInterface) {
    $media = Media::create([
      'bundle' => 'document',
      'name' => 'Terms of Reference',
      'status' => 1,
      'uid' => 1,
      'field_media_document' => ['target_id' => $file->id()],
      'field_reg_document_type' => 'terms_of_reference',
    ]);
    $media_changed = TRUE;
  }
  else {
    if ($media->label() !== 'Terms of Reference') {
      $media->setName('Terms of Reference');
      $media_changed = TRUE;
    }
    if (!$media->isPublished()) {
      $media->setPublished(TRUE);
      $media_changed = TRUE;
    }
    if ($media->hasField('field_reg_document_type') && $media->get('field_reg_document_type')->value !== 'terms_of_reference') {
      $media->set('field_reg_document_type', 'terms_of_reference');
      $media_changed = TRUE;
    }
  }
  if ($media_changed) {
    $media->save();
  }

  $reference = 'RW-REG/EDCL-511177-CS-QCBS';
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $node_ids = $node_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'reg_tender')
    ->condition('field_reg_reference', $reference)
    ->sort('nid', 'ASC')
    ->range(0, 1)
    ->execute();
  $node = $node_ids ? $node_storage->load(reset($node_ids)) : NULL;
  $created = !($node instanceof Node);
  $node ??= Node::create([
    'type' => 'reg_tender',
    'uid' => 1,
    'langcode' => 'en',
  ]);
  $changed = $created;
  $set_scalar = static function (Node $entity, string $field_name, string|int $value) use (&$changed): void {
    if ($entity->hasField($field_name) && (string) ($entity->get($field_name)->value ?? '') !== (string) $value) {
      $entity->set($field_name, $value);
      $changed = TRUE;
    }
  };
  $set_reference = static function (Node $entity, string $field_name, int $target_id) use (&$changed): void {
    if ($entity->hasField($field_name) && (int) ($entity->get($field_name)->target_id ?? 0) !== $target_id) {
      $entity->set($field_name, ['target_id' => $target_id]);
      $changed = TRUE;
    }
  };

  $title = 'Hiring a Consultancy Firm to Conduct Valuation of Properties/Assets for Electrification Projects under a Framework Contract';
  if ($node->label() !== $title) {
    $node->setTitle($title);
    $changed = TRUE;
  }
  $values = [
    'field_reg_reference' => $reference,
    'field_reg_entity' => 'edcl',
    'field_reg_tender_type' => 'request_expression_interest',
    'field_reg_re_advertised' => 1,
    'field_reg_project' => 'Accelerating Sustainable and Clean Energy Access Transformation (ASCENT)',
    'field_reg_procurement_method' => 'qcbs',
    'field_reg_tender_status' => 'active',
    'field_reg_summary' => 'EDCL is seeking a qualified consultancy firm to conduct valuation of properties/assets affected by electrification projects under ASCENT, to support fair and just compensation of Project Affected People.',
    'field_reg_contract_duration' => '3 years',
    'field_reg_renewal_terms' => 'subject to client satisfaction and need',
    'field_reg_featured' => 1,
    'field_reg_homepage_priority' => 100,
  ];
  foreach ($values as $field_name => $value) {
    $set_scalar($node, $field_name, $value);
  }
  $set_reference($node, 'field_reg_tender_category', (int) $category->id());

  $document_ids = $node->hasField('field_reg_tender_documents')
    ? array_map('intval', array_column($node->get('field_reg_tender_documents')->getValue(), 'target_id'))
    : [];
  if ($node->hasField('field_reg_tender_documents') && !in_array((int) $media->id(), $document_ids, TRUE)) {
    $document_ids[] = (int) $media->id();
    $node->set('field_reg_tender_documents', array_map(static fn (int $id): array => ['target_id' => $id], $document_ids));
    $changed = TRUE;
  }
  if (!$node->isPublished()) {
    $node->setPublished(TRUE);
    $changed = TRUE;
  }
  if ($node->hasField('moderation_state') && $node->get('moderation_state')->value !== 'published') {
    $node->set('moderation_state', 'published');
    $changed = TRUE;
  }
  if ($changed) {
    if (!$created) {
      $node->setNewRevision(TRUE);
      $node->setRevisionLogMessage('Updated from the approved EDCL valuation Terms of Reference without inventing procurement dates.');
    }
    $node->save();
  }

  return [
    'node_id' => (int) $node->id(),
    'media_id' => (int) $media->id(),
    'file_id' => (int) $file->id(),
    'created' => $created,
  ];
}

/**
 * Orders tender fields for Procurement editors and hides generic field dumps.
 */
function reg_core_configure_tender_form_and_display(): void {
  $form_display = EntityFormDisplay::load('node.reg_tender.default');
  if ($form_display) {
    $components = [
      'title' => ['string_textfield', -30],
      'field_reg_reference' => ['string_textfield', -28],
      'field_reg_entity' => ['options_select', -26],
      'field_reg_tender_type' => ['options_select', -24],
      'field_reg_re_advertised' => ['boolean_checkbox', -22],
      'field_reg_project' => ['string_textfield', -20],
      'field_reg_tender_category' => ['options_select', -18],
      'field_reg_procurement_method' => ['options_select', -16],
      'field_reg_summary' => ['string_textarea', -14],
      'field_reg_description' => ['text_textarea', -12],
      'field_reg_issue_date' => ['datetime_default', -10],
      'field_reg_closing_date' => ['datetime_default', -8],
      'field_reg_tender_status' => ['options_select', -6],
      'field_reg_contract_duration' => ['string_textfield', -4],
      'field_reg_renewal_terms' => ['string_textarea', -2],
      'field_reg_contact' => ['string_textarea', 0],
      'field_reg_tender_documents' => ['media_library_widget', 2],
      'field_reg_tender_addenda' => ['media_library_widget', 4],
      'field_reg_awarded_supplier' => ['string_textfield', 6],
      'field_reg_award_date' => ['datetime_default', 8],
      'field_reg_award_documents' => ['media_library_widget', 10],
      'field_reg_featured' => ['boolean_checkbox', 12],
      'field_reg_homepage_priority' => ['number', 14],
      'field_reg_related_tenders' => ['entity_reference_autocomplete', 16],
      'field_reg_document_language' => ['options_select', 18],
      'langcode' => ['language_select', 20],
      'field_reg_translation_requested' => ['boolean_checkbox', 22],
      'field_reg_translation_priority' => ['options_select', 24],
      'field_reg_translation_review' => ['datetime_default', 26],
      'moderation_state' => ['moderation_state_default', 90],
      'revision_log' => ['string_textarea', 92],
    ];
    foreach ($components as $field_name => [$widget, $weight]) {
      if ($field_name === 'title' || isset(\Drupal::service('entity_field.manager')->getFieldDefinitions('node', 'reg_tender')[$field_name])) {
        $form_display->setComponent($field_name, ['type' => $widget, 'weight' => $weight, 'settings' => []]);
      }
    }
    foreach (['body', 'uid', 'created', 'status', 'promote', 'sticky', 'field_reg_opening_date', 'field_reg_eligibility', 'field_reg_procurement_plan', 'field_reg_external_url', 'field_reg_document_url', 'field_reg_content_department', 'path'] as $hidden) {
      $form_display->removeComponent($hidden);
    }
    $form_display->save();
  }

  $view_display = EntityViewDisplay::load('node.reg_tender.default');
  if ($view_display) {
    foreach (array_keys(\Drupal::service('entity_field.manager')->getFieldDefinitions('node', 'reg_tender')) as $field_name) {
      $view_display->removeComponent($field_name);
    }
    $view_display->save();
  }
}

/**
 * Creates controlled procurement and publication taxonomies.
 */
function reg_core_ensure_public_information_taxonomies(): void {
  $vocabularies = [
    'reg_procurement_category' => [
      'label' => 'REG procurement categories',
      'terms' => [
        'Goods',
        'Works',
        'Consulting services',
        'Non-consulting services',
        'Energy infrastructure',
        'Information technology',
      ],
    ],
    'reg_publication_type' => [
      'label' => 'REG publication types',
      'terms' => [
        'Annual report',
        'Policy',
        'Strategic plan',
        'Environmental and social safeguard',
        'Form',
        'Manual and guideline',
        'Financial statement',
      ],
    ],
  ];

  foreach ($vocabularies as $id => $definition) {
    if (!Vocabulary::load($id)) {
      Vocabulary::create([
        'vid' => $id,
        'name' => $definition['label'],
      ])->save();
    }
    $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    foreach ($definition['terms'] as $weight => $name) {
      $existing = $storage->loadByProperties(['vid' => $id, 'name' => $name]);
      if (!$existing) {
        Term::create([
          'vid' => $id,
          'name' => $name,
          'weight' => $weight,
        ])->save();
      }
    }
  }
}

/**
 * Restricts the existing document media type to approved office formats.
 */
function reg_core_configure_official_documents(): void {
  $media_type = MediaType::load('document');
  if (!$media_type) {
    return;
  }
  $source_field = (string) ($media_type->getSource()->getConfiguration()['source_field'] ?? '');
  $field = $source_field !== '' ? FieldConfig::loadByName('media', 'document', $source_field) : NULL;
  if (!$field) {
    return;
  }

  $allow_zip = (bool) \Drupal::config('reg_core.settings')->get('public_information.allow_zip_uploads');
  $settings = $field->getSettings();
  $settings['file_extensions'] = $allow_zip
    ? 'pdf doc docx xls xlsx zip'
    : 'pdf doc docx xls xlsx';
  $settings['description_field'] = TRUE;
  $field->setSettings($settings)->save();

  $metadata = [
    'field_reg_document_type' => [
      'type' => 'list_string',
      'label' => 'Document type',
      'storage_settings' => ['allowed_values' => [
        'tender_notice' => 'Tender Notice',
        'terms_of_reference' => 'Terms of Reference',
        'addendum' => 'Addendum',
        'clarification' => 'Clarification',
        'award_notice' => 'Award Notice',
        'other' => 'Other official document',
      ]],
      'widget' => 'options_select',
      'formatter' => 'list_default',
      'translatable' => FALSE,
      'weight' => 4,
    ],
    'field_reg_document_date' => [
      'type' => 'datetime',
      'label' => 'Official document date',
      'storage_settings' => ['datetime_type' => 'date'],
      'widget' => 'datetime_default',
      'formatter' => 'datetime_default',
      'translatable' => FALSE,
      'weight' => 5,
    ],
    'field_reg_document_version' => [
      'type' => 'string',
      'label' => 'Version or addendum number',
      'storage_settings' => ['max_length' => 100],
      'widget' => 'string_textfield',
      'formatter' => 'string',
      'translatable' => TRUE,
      'weight' => 6,
    ],
  ];
  foreach ($metadata as $name => $definition) {
    $storage = FieldStorageConfig::loadByName('media', $name);
    if (!$storage) {
      $storage = FieldStorageConfig::create([
        'field_name' => $name,
        'entity_type' => 'media',
        'type' => $definition['type'],
        'cardinality' => 1,
        'translatable' => $definition['translatable'],
        'settings' => $definition['storage_settings'],
      ]);
      $storage->save();
    }
    elseif ($definition['type'] === 'list_string') {
      $storage->setSetting('allowed_values', $definition['storage_settings']['allowed_values'])->save();
    }
    $field = FieldConfig::loadByName('media', 'document', $name);
    if (!$field) {
      $field = FieldConfig::create([
        'field_name' => $name,
        'entity_type' => 'media',
        'bundle' => 'document',
        'label' => $definition['label'],
        'translatable' => $definition['translatable'],
      ]);
      $field->save();
    }
    else {
      $field->setLabel($definition['label'])->setTranslatable($definition['translatable'])->save();
    }
    $form_display = EntityFormDisplay::load('media.document.default');
    if ($form_display) {
      $form_display->setComponent($name, [
        'type' => $definition['widget'],
        'weight' => $definition['weight'],
      ])->save();
    }
    $view_display = EntityViewDisplay::load('media.document.default');
    if ($view_display) {
      $view_display->setComponent($name, [
        'type' => $definition['formatter'],
        'label' => 'above',
        'weight' => $definition['weight'],
      ])->save();
    }
  }
}

/**
 * Adds translation and Draft/Review/Published/Archived governance.
 */
function reg_core_configure_public_information_governance(): void {
  if (!ConfigurableLanguage::load('rw')) {
    ConfigurableLanguage::createFromLangcode('rw')->save();
  }

  $bundles = ['reg_tender', 'reg_job', 'reg_publication'];
  foreach ($bundles as $bundle) {
    ContentLanguageSettings::loadByEntityTypeBundle('node', $bundle)
      ->setDefaultLangcode('site_default')
      ->setLanguageAlterable(TRUE)
      ->setThirdPartySetting('content_translation', 'enabled', TRUE)
      ->save();
  }

  $workflow = Workflow::load('reg_public_information_editorial');
  if (!$workflow) {
    $workflow = Workflow::create([
      'id' => 'reg_public_information_editorial',
      'label' => 'REG Public Information Editorial',
      'type' => 'content_moderation',
      'type_settings' => [
        'states' => [
          'draft' => ['label' => 'Draft', 'published' => FALSE, 'default_revision' => FALSE, 'weight' => -10],
          'needs_review' => ['label' => 'Needs Review', 'published' => FALSE, 'default_revision' => FALSE, 'weight' => 0],
          'published' => ['label' => 'Published', 'published' => TRUE, 'default_revision' => TRUE, 'weight' => 10],
          'archived' => ['label' => 'Archived', 'published' => TRUE, 'default_revision' => TRUE, 'weight' => 20],
        ],
        'transitions' => [
          'create_new_draft' => [
            'label' => 'Create New Draft',
            'from' => ['draft', 'needs_review', 'published', 'archived'],
            'to' => 'draft',
            'weight' => 0,
          ],
          'submit_for_review' => [
            'label' => 'Submit for Review',
            'from' => ['draft', 'needs_review'],
            'to' => 'needs_review',
            'weight' => 5,
          ],
          'publish' => [
            'label' => 'Publish',
            'from' => ['needs_review', 'published'],
            'to' => 'published',
            'weight' => 10,
          ],
          'return_to_draft' => [
            'label' => 'Return to Draft',
            'from' => ['needs_review'],
            'to' => 'draft',
            'weight' => 15,
          ],
          'archive' => [
            'label' => 'Archive',
            'from' => ['published', 'archived'],
            'to' => 'archived',
            'weight' => 20,
          ],
        ],
        'entity_types' => [],
        'default_moderation_state' => 'draft',
      ],
    ]);
  }

  $moderation = $workflow->getTypePlugin();
  if ($moderation instanceof ContentModerationInterface) {
    foreach ($bundles as $bundle) {
      $moderation->addEntityTypeAndBundle('node', $bundle);
    }
  }
  $workflow->save();
}

/**
 * Creates analytics and consent storage during updates.
 */
function reg_core_ensure_public_information_tables(): void {
  $schema = \Drupal::database()->schema();
  foreach (['reg_core_document_download', 'reg_core_tender_subscription'] as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, reg_core_schema()[$table]);
    }
  }
}

/**
 * Applies the structured, governed REG Sports Portal model.
 */
function reg_core_apply_sports_portal(): void {
  \Drupal::service('module_installer')->install([
    'taxonomy',
    'media',
    'media_library',
    'image',
    'responsive_image',
    'language',
    'content_translation',
    'workflows',
    'content_moderation',
  ], TRUE);

  $types = [
    'reg_sports_update' => ['Sports update', 'Approved sports news, previews, reports, announcements and team updates.'],
    'reg_sports_team' => ['Sports team', 'Official REG sports team profiles and current team information.'],
    'reg_sports_player' => ['Sports player', 'Public athlete profiles linked to official REG teams.'],
    'reg_sports_membership' => ['Sports team-season membership', 'Season-aware roster membership linking an athlete to an official REG team.'],
    'reg_sports_staff' => ['Sports technical staff', 'Approved technical and team staff profiles.'],
    'reg_sports_fixture' => ['Sports fixture', 'Fixtures and connected match results for official REG teams.'],
    'reg_sports_standing' => ['Sports standing row', 'CMS-managed competition standing rows by season.'],
    'reg_sports_gallery' => ['Sports gallery', 'Approved team, match and event photo albums.'],
    'reg_sports_video' => ['Sports video', 'Approved sports video highlights using supported Media providers.'],
  ];
  foreach ($types as $id => [$label, $description]) {
    $type = NodeType::load($id);
    if (!$type) {
      $type = NodeType::create([
        'type' => $id,
        'name' => $label,
        'description' => $description,
        'new_revision' => TRUE,
        'preview_mode' => 1,
        'display_submitted' => FALSE,
      ]);
      $type->save();
    }
    reg_core_ensure_body_field_storage();
    if (function_exists('node_add_body_field')) {
      node_add_body_field($type, $id === 'reg_sports_update' ? 'Story body' : 'Additional information');
    }
  }

  reg_core_ensure_sports_taxonomies();
  foreach (array_keys($types) as $bundle) {
    $weight = 5;
    foreach (reg_core_field_definitions()[$bundle] as $field_name => $definition) {
      reg_core_ensure_field($bundle, $field_name, $definition, $weight);
      $weight += 2;
    }
  }

  $internal_metadata = [
    'field_reg_source_organization',
    'field_reg_source_reference',
    'field_reg_verification_status',
    'field_reg_verification_notes',
  ];
  foreach (array_keys($types) as $bundle) {
    $display = EntityViewDisplay::load("node.$bundle.default");
    if (!$display) {
      continue;
    }
    foreach ($internal_metadata as $field_name) {
      $display->removeComponent($field_name);
    }
    $display->save();
  }

  $base_definitions = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('node');
  foreach (['reg_sports_team', 'reg_sports_player', 'reg_sports_membership', 'reg_sports_staff', 'reg_sports_fixture', 'reg_sports_standing'] as $bundle) {
    $override = BaseFieldOverride::loadByName('node', $bundle, 'title')
      ?: BaseFieldOverride::createFromBaseFieldDefinition($base_definitions['title'], $bundle);
    $override->setTranslatable(FALSE)->save();
  }

  reg_core_configure_sports_governance(array_keys($types));
  reg_core_ensure_sports_image_style();
  reg_core_create_roles();

  $config = \Drupal::configFactory()->getEditable('reg_core.settings');
  $defaults = [
    'sports.data_source' => 'cms',
    'sports.statistics_api_base_url' => '',
    'sports.social_embed_enabled' => FALSE,
    'sports.results_per_page' => 12,
  ];
  $changed = FALSE;
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
      $changed = TRUE;
    }
  }
  if ($changed) {
    $config->save(TRUE);
  }

}

/**
 * Attaches the approved REG–Patriots photograph to its existing result.
 */
function reg_core_apply_featured_result_image(): array {
  $result = [
    'fixture' => NULL,
    'media' => NULL,
    'file' => NULL,
    'updated' => FALSE,
  ];
  if (!NodeType::load('reg_sports_fixture')) {
    return $result;
  }

  $entity_type_manager = \Drupal::entityTypeManager();
  $file_storage = $entity_type_manager->getStorage('file');
  $destination = 'public://sports/reg-vs-patriots-74-71.jpg';
  $files = $file_storage->loadByProperties(['uri' => $destination]);
  $file = $files ? reset($files) : NULL;
  if (!$file) {
    $source = DRUPAL_ROOT . '/modules/custom/reg_core/assets/sports/reg-vs-patriots-74-71.jpg';
    if (!is_file($source)) {
      $source = DRUPAL_ROOT . '/themes/custom/reg_theme/assets/images/sports/reg-vs-patriots-74-71.jpg';
    }
    if (!is_file($source)) {
      return $result;
    }
    $directory = 'public://sports';
    if (!\Drupal::service('file_system')->prepareDirectory(
      $directory,
      FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS,
    )) {
      return $result;
    }
    $file = \Drupal::service('file.repository')->writeData(
      (string) file_get_contents($source),
      $destination,
      FileExists::Replace,
    );
  }
  if (!$file->isPermanent()) {
    $file->setPermanent();
    $file->save();
  }
  $result['file'] = (int) $file->id();

  $media_storage = $entity_type_manager->getStorage('media');
  $media_ids = $media_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('bundle', 'image')
    ->condition('field_media_image.target_id', $file->id())
    ->sort('mid', 'ASC')
    ->range(0, 1)
    ->execute();
  $media = $media_ids ? $media_storage->load(reset($media_ids)) : NULL;
  if (!$media instanceof MediaInterface) {
    $media = Media::create([
      'bundle' => 'image',
      'name' => 'REG vs Patriots 74–71 match',
      'uid' => 1,
      'status' => 1,
    ]);
  }
  $alt = 'REG basketball player during the REG 74–71 Patriots match';
  $media_item = $media->get('field_media_image')->first();
  $media_changed = !$media->isPublished()
    || (int) ($media_item?->target_id ?? 0) !== (int) $file->id()
    || trim((string) ($media_item?->alt ?? '')) !== $alt;
  if ($media_changed || $media->isNew()) {
    $media
      ->set('status', 1)
      ->set('field_media_image', [
        'target_id' => $file->id(),
        'alt' => $alt,
      ])
      ->save();
    $result['updated'] = TRUE;
  }
  $result['media'] = (int) $media->id();

  $node_storage = $entity_type_manager->getStorage('node');
  $fixture_ids = $node_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'reg_sports_fixture')
    ->condition('field_reg_home_team_name', 'REG')
    ->condition('field_reg_away_team_name', 'Patriots')
    ->condition('field_reg_home_score', 74)
    ->condition('field_reg_away_score', 71)
    ->sort('nid', 'ASC')
    ->range(0, 1)
    ->execute();
  $fixture = $fixture_ids ? $node_storage->load(reset($fixture_ids)) : NULL;
  if (!$fixture instanceof NodeInterface || !$fixture->hasField('field_reg_hero_image')) {
    return $result;
  }
  $result['fixture'] = (int) $fixture->id();
  if ((int) ($fixture->get('field_reg_hero_image')->target_id ?? 0) !== (int) $media->id()) {
    $fixture->set('field_reg_hero_image', $media->id());
    $fixture->setNewRevision(TRUE);
    $fixture->setRevisionLogMessage('Attached the approved REG 74-71 Patriots match photograph.');
    $fixture->save();
    $result['updated'] = TRUE;
  }
  return $result;
}

/**
 * Creates sports classifications without inventing competition or season data.
 */
function reg_core_ensure_sports_taxonomies(): void {
  $vocabularies = [
    'reg_sports_sport' => ['REG sports', ['Basketball', 'Volleyball']],
    'reg_sports_position' => ['REG sports positions', [
      'Point Guard',
      'Shooting Guard',
      'Small Forward',
      'Power Forward',
      'Center',
      'Setter',
      'Outside Hitter',
      'Opposite Hitter',
      'Middle Blocker',
      'Libero',
      'Defensive Specialist',
    ]],
    'reg_sports_competition' => ['REG sports competitions', []],
    'reg_sports_season' => ['REG sports seasons', []],
  ];
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach ($vocabularies as $id => [$label, $terms]) {
    if (!Vocabulary::load($id)) {
      Vocabulary::create(['vid' => $id, 'name' => $label])->save();
    }
    foreach ($terms as $weight => $name) {
      if (!$storage->loadByProperties(['vid' => $id, 'name' => $name])) {
        Term::create(['vid' => $id, 'name' => $name, 'weight' => $weight])->save();
      }
    }
  }
  reg_core_ensure_sports_competition_fields();
}

/**
 * Creates the administrator-supplied 2026 basketball rosters idempotently.
 */
function reg_core_apply_2026_basketball_data(): void {
  if (!NodeType::load('reg_sports_membership')) {
    return;
  }

  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $term = static function (string $vocabulary, string $name) use ($term_storage): Term {
    $existing = $term_storage->loadByProperties(['vid' => $vocabulary, 'name' => $name]);
    $entity = $existing ? reset($existing) : NULL;
    if (!$entity instanceof Term) {
      $entity = Term::create(['vid' => $vocabulary, 'name' => $name]);
      $entity->save();
    }
    return $entity;
  };
  $first_node = static function (string $bundle, array $conditions) use ($node_storage): ?Node {
    $query = $node_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', $bundle)
      ->sort('nid', 'ASC')
      ->range(0, 1);
    foreach ($conditions as $field_name => $value) {
      $query->condition($field_name, $value, is_array($value) ? 'IN' : '=');
    }
    $ids = $query->execute();
    $node = $ids ? $node_storage->load(reset($ids)) : NULL;
    return $node instanceof Node ? $node : NULL;
  };
  $save_node = static function (?Node $node, array $values, string $revision_log): Node {
    $new = !$node;
    $node ??= Node::create([
      'type' => $values['type'],
      'uid' => 1,
      'langcode' => 'en',
    ]);
    $node->setTitle((string) $values['title']);
    foreach ($values as $field_name => $value) {
      if (in_array($field_name, ['type', 'title'], TRUE) || !$node->hasField($field_name)) {
        continue;
      }
      $node->set($field_name, $value);
    }
    $node->setPublished(TRUE);
    if ($node->hasField('moderation_state')) {
      $node->set('moderation_state', 'published');
    }
    if (!$new) {
      $node->setNewRevision(TRUE);
      $node->setRevisionLogMessage($revision_log);
    }
    $node->save();
    return $node;
  };

  $basketball = $term('reg_sports_sport', 'Basketball');
  $season = $term('reg_sports_season', '2026');
  $competition = $term('reg_sports_competition', '2026 Rwanda Basketball League');
  $men_source = [
    'field_reg_source_organization' => 'other_verified',
    'field_reg_verification_status' => 'verified',
    'field_reg_verification_notes' => [
      'value' => 'Administrator-provided verified 2026 roster and regular-season record. No public source URL, jersey numbers, or playing positions were supplied.',
      'format' => 'restricted_html',
    ],
  ];
  $women_source = [
    'field_reg_source_organization' => 'other_verified',
    'field_reg_verification_status' => 'needs_review',
    'field_reg_verification_notes' => [
      'value' => 'Administrator-provided currently indexed domestic roster data. Canonical spelling follows the supplied list; playing positions, incomplete names, and the exact public source reference require REG administrator confirmation.',
      'format' => 'restricted_html',
    ],
  ];

  $men_team = $first_node('reg_sports_team', ['field_reg_team_key' => 'basketball_men']);
  $men_team = $save_node($men_team, [
    'type' => 'reg_sports_team',
    'title' => 'REG Basketball Men',
    'field_reg_team_key' => 'basketball_men',
    'field_reg_sports_sport' => $basketball->id(),
    'field_reg_gender_category' => 'men',
    'field_reg_competition' => $competition->id(),
    'field_reg_season' => $season->id(),
    'field_reg_active' => 1,
  ] + $men_source, 'Updated the verified 2026 REG Basketball Men team data.');

  $women_team = $first_node('reg_sports_team', ['field_reg_team_key' => 'basketball_women']);
  $women_team = $save_node($women_team, [
    'type' => 'reg_sports_team',
    'title' => 'REG Basketball Women',
    'field_reg_team_key' => 'basketball_women',
    'field_reg_sports_sport' => $basketball->id(),
    'field_reg_gender_category' => 'women',
    'field_reg_season' => $season->id(),
    'field_reg_active' => 1,
  ] + $women_source, 'Updated the review-flagged 2026 REG Basketball Women team data.');

  $men = [
    'Elliott Lamar Cole',
    'Patrick Nshizirungu',
    'Jean de Dieu Umuhoza',
    'Enock Isezerano',
    'Cadeau de Dieu Furaha',
    'Frank Kamndoh Betoudji',
    'Fabrice Muhoza',
    'Armel Sangwe',
    'Prince Muhizi',
    'Emile Kazeneza',
    'Hamady Barro Ndiaye',
    'Sedar Sagamba',
    'Hubert Kabare Bugingo',
    'Yves Shema',
    'Garmine Kande Kieli',
    'Steve Junior Nsumizi',
  ];
  $women = [
    'Faustine Mwizerwa' => [],
    'Henriette Uwimpuhwe' => [],
    'Ange Nelly Irakoze' => [],
    'Sandrine Mushikiwabo' => [],
    'Odile Tetero' => [],
    'Sandra Kantoré' => [],
    'Lamla Umunezero' => ['Ramla Umunezero'],
    'Chantal Ramu Kiyobe' => ['Kiyobe Chantal'],
    'Shauqunna Nicole Collins' => ['Collins Nicole Shauqunna'],
    'Marie Chantal Utamuliza' => [],
    'Kankou Coulibaly' => ['Coulibally Kankou', 'Coulibaly Kankou', 'Kankou Coulibally'],
    'Nandy' => [],
    'Kadidia Maiga' => [],
    'Taylor Lynn Hosendove' => ['Hosendove Taylor Lynn'],
  ];

  $upsert_roster = static function (
    array $roster,
    Node $team,
    Term $season,
    Term $basketball,
    array $source,
    bool $women_roster = FALSE,
  ) use ($first_node, $save_node): void {
    $order = 0;
    foreach ($roster as $key => $value) {
      $name = $women_roster ? (string) $key : (string) $value;
      $variants = $women_roster ? (array) $value : [];
      $player = $first_node('reg_sports_player', [
        'title' => array_values(array_unique(array_merge([$name], $variants))),
        'field_reg_team.target_id' => $team->id(),
      ]);
      $player_values = [
        'type' => 'reg_sports_player',
        'title' => $name,
        'field_reg_team' => $team->id(),
        'field_reg_sports_sport' => $basketball->id(),
        'field_reg_season' => $season->id(),
        'field_reg_player_status' => 'active',
        'field_reg_captain' => $name === 'Prince Muhizi' ? 1 : 0,
      ] + $source;
      if ($name === 'Nandy') {
        $player_values['field_reg_verification_notes'] = [
          'value' => 'The indexed domestic source supplied only the name “Nandy”. Confirm the full registered name and playing position before marking this record verified.',
          'format' => 'restricted_html',
        ];
      }
      elseif ($women_roster && $variants) {
        $player_values['field_reg_verification_notes'] = [
          'value' => 'Canonical spelling was normalized from known indexed variants: ' . implode(', ', $variants) . '. Confirm the spelling and playing position before marking this record verified.',
          'format' => 'restricted_html',
        ];
      }
      $player = $save_node($player, $player_values, 'Updated the 2026 season player and verification metadata.');

      $membership = $first_node('reg_sports_membership', [
        'field_reg_player.target_id' => $player->id(),
        'field_reg_team.target_id' => $team->id(),
        'field_reg_season.target_id' => $season->id(),
      ]);
      $save_node($membership, [
        'type' => 'reg_sports_membership',
        'title' => '2026 — ' . $team->label() . ' — ' . $name,
        'field_reg_player' => $player->id(),
        'field_reg_team' => $team->id(),
        'field_reg_sports_sport' => $basketball->id(),
        'field_reg_season' => $season->id(),
        'field_reg_membership_status' => 'active',
        'field_reg_roster_order' => ++$order,
        'field_reg_captain' => $name === 'Prince Muhizi' ? 1 : 0,
      ] + $source, 'Updated the 2026 team-season roster membership.');
    }
  };

  $upsert_roster($men, $men_team, $season, $basketball, $men_source);
  $upsert_roster($women, $women_team, $season, $basketball, $women_source, TRUE);

  $standing = $first_node('reg_sports_standing', [
    'field_reg_team.target_id' => $men_team->id(),
    'field_reg_competition.target_id' => $competition->id(),
    'field_reg_season.target_id' => $season->id(),
  ]);
  $save_node($standing, [
    'type' => 'reg_sports_standing',
    'title' => 'REG Basketball Men — 2026 Rwanda Basketball League standing',
    'field_reg_sports_sport' => $basketball->id(),
    'field_reg_competition' => $competition->id(),
    'field_reg_season' => $season->id(),
    'field_reg_standing_team' => 'REG Basketball Men',
    'field_reg_team' => $men_team->id(),
    'field_reg_table_position' => 3,
    'field_reg_played' => 16,
    'field_reg_wins' => 11,
    'field_reg_losses' => 5,
  ] + $men_source, 'Updated the verified 2026 regular-season standing.');
}

/**
 * Adds optional logo and participating-team fields to competition terms.
 */
function reg_core_ensure_sports_competition_fields(): void {
  $definitions = [
    'field_reg_competition_logo' => [
      'label' => 'Competition logo',
      'target_type' => 'media',
      'cardinality' => 1,
      'handler' => 'default:media',
      'target_bundles' => ['image' => 'image'],
      'widget' => 'media_library_widget',
    ],
    'field_reg_competition_teams' => [
      'label' => 'Participating REG teams',
      'target_type' => 'node',
      'cardinality' => -1,
      'handler' => 'default:node',
      'target_bundles' => ['reg_sports_team' => 'reg_sports_team'],
      'widget' => 'entity_reference_autocomplete',
    ],
  ];
  foreach ($definitions as $name => $definition) {
    if (!FieldStorageConfig::loadByName('taxonomy_term', $name)) {
      FieldStorageConfig::create([
        'field_name' => $name,
        'entity_type' => 'taxonomy_term',
        'type' => 'entity_reference',
        'cardinality' => $definition['cardinality'],
        'translatable' => FALSE,
        'settings' => ['target_type' => $definition['target_type']],
      ])->save();
    }
    if (!FieldConfig::loadByName('taxonomy_term', 'reg_sports_competition', $name)) {
      FieldConfig::create([
        'field_name' => $name,
        'entity_type' => 'taxonomy_term',
        'bundle' => 'reg_sports_competition',
        'label' => $definition['label'],
        'translatable' => FALSE,
        'settings' => [
          'handler' => $definition['handler'],
          'handler_settings' => ['target_bundles' => $definition['target_bundles']],
        ],
      ])->save();
    }
    $form = EntityFormDisplay::load('taxonomy_term.reg_sports_competition.default') ?: EntityFormDisplay::create([
      'targetEntityType' => 'taxonomy_term',
      'bundle' => 'reg_sports_competition',
      'mode' => 'default',
      'status' => TRUE,
    ]);
    $form->setComponent($name, ['type' => $definition['widget'], 'weight' => 10])->save();
    $view = EntityViewDisplay::load('taxonomy_term.reg_sports_competition.default') ?: EntityViewDisplay::create([
      'targetEntityType' => 'taxonomy_term',
      'bundle' => 'reg_sports_competition',
      'mode' => 'default',
      'status' => TRUE,
    ]);
    $view->setComponent($name, ['type' => 'entity_reference_label', 'label' => 'above', 'weight' => 10])->save();
  }
}

/**
 * Configures bilingual sports content and approval states.
 */
function reg_core_configure_sports_governance(array $bundles): void {
  if (!ConfigurableLanguage::load('rw')) {
    ConfigurableLanguage::createFromLangcode('rw')->save();
  }
  foreach ($bundles as $bundle) {
    ContentLanguageSettings::loadByEntityTypeBundle('node', $bundle)
      ->setDefaultLangcode('site_default')
      ->setLanguageAlterable(TRUE)
      ->setThirdPartySetting('content_translation', 'enabled', TRUE)
      ->save();
  }

  $workflow = Workflow::load('reg_sports_editorial');
  if (!$workflow) {
    $workflow = Workflow::create([
      'id' => 'reg_sports_editorial',
      'label' => 'REG Sports Editorial',
      'type' => 'content_moderation',
      'type_settings' => [
        'states' => [
          'draft' => ['label' => 'Draft', 'published' => FALSE, 'default_revision' => FALSE, 'weight' => -10],
          'needs_review' => ['label' => 'Needs Review', 'published' => FALSE, 'default_revision' => FALSE, 'weight' => 0],
          'published' => ['label' => 'Published', 'published' => TRUE, 'default_revision' => TRUE, 'weight' => 10],
          'archived' => ['label' => 'Archived', 'published' => TRUE, 'default_revision' => TRUE, 'weight' => 20],
        ],
        'transitions' => [
          'create_new_draft' => [
            'label' => 'Create New Draft',
            'from' => ['draft', 'needs_review', 'published', 'archived'],
            'to' => 'draft',
            'weight' => 0,
          ],
          'submit_for_review' => [
            'label' => 'Submit for Review',
            'from' => ['draft', 'needs_review'],
            'to' => 'needs_review',
            'weight' => 5,
          ],
          'publish' => [
            'label' => 'Publish',
            'from' => ['needs_review', 'published'],
            'to' => 'published',
            'weight' => 10,
          ],
          'return_to_draft' => [
            'label' => 'Return to Draft',
            'from' => ['needs_review'],
            'to' => 'draft',
            'weight' => 15,
          ],
          'archive' => [
            'label' => 'Archive',
            'from' => ['published', 'archived'],
            'to' => 'archived',
            'weight' => 20,
          ],
        ],
        'entity_types' => [],
        'default_moderation_state' => 'draft',
      ],
    ]);
  }
  $moderation = $workflow->getTypePlugin();
  if ($moderation instanceof ContentModerationInterface) {
    foreach ($bundles as $bundle) {
      $moderation->addEntityTypeAndBundle('node', $bundle);
    }
  }
  $workflow->save();
}

/**
 * Creates bounded sports derivatives and a Drupal responsive-image style.
 */
function reg_core_ensure_sports_image_style(): void {
  $styles = [
    'reg_sports_card_small' => ['REG sports card 360x240', 360, 240, 'image_scale_and_crop'],
    'reg_sports_card' => ['REG sports card 720x480', 720, 480, 'image_scale_and_crop'],
    'reg_sports_card_large' => ['REG sports card 1440x960', 1440, 960, 'image_scale_and_crop'],
    'reg_sports_logo' => ['REG sports logo 256x256', 256, 256, 'image_scale'],
  ];
  foreach ($styles as $name => [$label, $width, $height, $effect]) {
    if (ImageStyle::load($name)) {
      continue;
    }
    $style = ImageStyle::create(['name' => $name, 'label' => $label]);
    $data = ['width' => $width, 'height' => $height, 'upscale' => FALSE];
    if ($effect === 'image_scale_and_crop') {
      $data['anchor'] = 'center-center';
    }
    $style->addImageEffect([
      'id' => $effect,
      'weight' => 0,
      'data' => $data,
    ]);
    $style->save();
  }

  if (!ResponsiveImageStyle::load('reg_sports_card')) {
    $responsive = ResponsiveImageStyle::create([
      'id' => 'reg_sports_card',
      'label' => 'REG sports responsive card',
      'breakpoint_group' => 'reg_theme',
      'fallback_image_style' => 'reg_sports_card',
    ]);
    $responsive->addImageStyleMapping('reg_theme.mobile', '1x', [
      'image_mapping_type' => 'image_style',
      'image_mapping' => 'reg_sports_card_small',
    ]);
    $responsive->addImageStyleMapping('reg_theme.desktop', '1x', [
      'image_mapping_type' => 'image_style',
      'image_mapping' => 'reg_sports_card_large',
    ]);
    $responsive->save();
  }
}

