      'title' => $default['title'],
      'field_reg_energy_tool_key' => $key,
      'field_reg_description' => ['value' => $default['description'], 'format' => 'plain_text'],
      'field_reg_cta_label' => $default['cta_label'],
      'field_reg_cta_url' => ['uri' => $default['cta_uri']],
      'field_reg_tool_status' => $default['status'],
      'field_reg_featured' => 1,
      'field_reg_order' => $default['order'],
      'field_reg_active' => 1,
      'status' => 1,
    ])->save();
  }
}

/**
 * Creates bounded responsive derivatives for homepage-managed images.
 */
function reg_core_ensure_homepage_image_styles(): void {
  $styles = [
    'reg_homepage_hero_mobile' => ['REG homepage hero mobile 900x1100', 900, 1100, 'image_scale_and_crop'],
    'reg_homepage_hero_desktop' => ['REG homepage hero desktop 1920x900', 1920, 900, 'image_scale_and_crop'],
    'reg_partner_logo' => ['REG partner logo 320x160', 320, 160, 'image_scale'],
  ];
  foreach ($styles as $name => [$label, $width, $height, $effect]) {
    if (ImageStyle::load($name)) {
      continue;
    }
    $style = ImageStyle::create(['name' => $name, 'label' => $label]);
    $data = ['width' => $width, 'height' => $height, 'upscale' => FALSE];
    if ($effect === 'image_scale_and_crop') {
      $data['anchor'] = 'center-center';
    }
    $style->addImageEffect([
      'id' => $effect,
      'weight' => 0,
      'data' => $data,
    ]);
    $style->save();
  }

  if (!ResponsiveImageStyle::load('reg_homepage_hero')) {
    $responsive = ResponsiveImageStyle::create([
      'id' => 'reg_homepage_hero',
      'label' => 'REG homepage hero',
      'breakpoint_group' => 'reg_theme',
      'fallback_image_style' => 'reg_homepage_hero_desktop',
    ]);
    $responsive->addImageStyleMapping('reg_theme.mobile', '1x', [
      'image_mapping_type' => 'image_style',
      'image_mapping' => 'reg_homepage_hero_mobile',
    ]);
    $responsive->addImageStyleMapping('reg_theme.desktop', '1x', [
      'image_mapping_type' => 'image_style',
      'image_mapping' => 'reg_homepage_hero_desktop',
    ]);
    $responsive->save();
  }
  if (!ResponsiveImageStyle::load('reg_partner_logo')) {
    $responsive = ResponsiveImageStyle::create([
      'id' => 'reg_partner_logo',
      'label' => 'REG partner logo',
      'breakpoint_group' => 'reg_theme',
      'fallback_image_style' => 'reg_partner_logo',
    ]);
    foreach (['reg_theme.mobile', 'reg_theme.desktop'] as $breakpoint) {
      $responsive->addImageStyleMapping($breakpoint, '1x', [
        'image_mapping_type' => 'image_style',
        'image_mapping' => 'reg_partner_logo',
      ]);
    }
    $responsive->save();
  }
}

/**
 * Places the CMS-backed blocks in their dedicated front-page regions.
 */
function reg_core_place_homepage_blocks(): void {
  $placements = [
    'reg_homepage_hero' => ['reg_core_homepage_hero', 'Homepage hero', 'hero', 0],
    'reg_homepage_energy_tools' => ['reg_core_homepage_energy_tools', 'Homepage Energy Awareness', 'energy_awareness', 0],
    'reg_homepage_news' => ['reg_core_homepage_news', 'Homepage News & Insights', 'news', 0],
    'reg_homepage_tenders' => ['reg_core_homepage_tenders', 'Homepage Tenders', 'tenders', 0],
    'reg_homepage_videos' => ['reg_core_homepage_videos', 'Homepage featured videos', 'featured_video', 0],
    'reg_homepage_partners' => ['reg_core_homepage_partners', 'Homepage partners', 'partners', 0],
  ];
  foreach ($placements as $id => [$plugin, $label, $region, $weight]) {
    $block = Block::load($id) ?: Block::create([
      'id' => $id,
      'plugin' => $plugin,
      'theme' => 'reg_theme',
    ]);
    $block
      ->setRegion($region)
      ->setWeight($weight)
      ->setStatus(TRUE)
      ->set('settings', [
        'id' => $plugin,
        'label' => $label,
        'label_display' => FALSE,
        'provider' => 'reg_core',
      ])
      ->setVisibilityConfig('request_path', [
        'id' => 'request_path',
        'negate' => FALSE,
        'pages' => '<front>',
      ])
      ->save();
  }
}

