function reg_core_date_field(string $label, bool $translatable = TRUE): array {
  return [
    'type' => 'datetime',
    'label' => $label,
    'required' => FALSE,
    'translatable' => $translatable,
    'storage_settings' => ['datetime_type' => 'date'],
    'widget' => 'datetime_default',
    'formatter' => 'datetime_default',
  ];
}

/**
 * Creates a reusable decimal field definition.
