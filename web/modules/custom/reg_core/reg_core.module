/**
 * Implements hook_preprocess().
 *
 * Section selection remains centralized in the resolver. Feature templates
 * receive the same normalized model without route checks or image paths.
 */
function reg_core_preprocess(array &$variables, string $hook): void {
  $supported = [
    'reg_branch_detail',
    'reg_branch_locator',
    'reg_complaints',
    'reg_contact',
    'reg_customer_services',
    'reg_faq_page',
    'reg_outage_center',
    'reg_outage_detail',
    'reg_public_information_detail',
    'reg_public_information_hub',
    'reg_public_information_listing',
    'reg_public_information_search',
    'reg_tender_detail',
    'reg_sports_detail',
    'reg_sports_landing',
    'reg_sports_listing',
    'reg_sports_standings',
    'reg_sports_team',
    'reg_video_archive',
    'reg_news_archive',
  ];
  if (in_array($hook, $supported, TRUE) && \Drupal::hasService('reg_core.section_hero_resolver')) {
    $variables['section_hero'] = \Drupal::service('reg_core.section_hero_resolver')->resolve();
  }
}

/**
 * Implements hook_preprocess_page().
 *
 * Generic node/View section pages that do not own a REG feature template use
 * the same component at page level. Custom feature pages render it themselves.
 */
function reg_core_preprocess_page(array &$variables): void {
  if (!\Drupal::hasService('reg_core.section_hero_resolver')) {
    return;
  }
  $route_name = \Drupal::routeMatch()->getRouteName() ?: '';
  if (in_array($route_name, ['system.403', 'system.404', '<front>'], TRUE)) {
    return;
  }
  $custom_routes = [
    'reg_core.contact',
    'reg_core.customer_services',
    'reg_core.complaints',
    'reg_core.report_problem',
    'reg_core.branches',
    'reg_core.branch_detail',
    'reg_core.outages',
    'reg_core.outages_current',
    'reg_core.outages_planned',
    'reg_core.outages_history',
    'reg_core.outage_detail',
    'reg_core.faq',
    'reg_core.public_information',
    'reg_core.public_information_search',
    'reg_core.tenders',
    'reg_core.tenders_current',
    'reg_core.tenders_awarded',
    'reg_core.tenders_archive',
    'reg_core.tender_detail',
    'reg_core.jobs',
    'reg_core.jobs_current',
    'reg_core.jobs_results',
    'reg_core.jobs_archive',
    'reg_core.job_detail',
    'reg_core.publications',
    'reg_core.publication_detail',
    'reg_core.sports',
    'reg_core.sports_team_basketball_men',
    'reg_core.sports_team_basketball_women',
    'reg_core.sports_team_volleyball_men',
    'reg_core.sports_fixtures',
    'reg_core.sports_results',
    'reg_core.sports_standings',
    'reg_core.sports_news',
    'reg_core.sports_news_detail',
    'reg_core.sports_players',
    'reg_core.sports_player',
    'reg_core.sports_fixture',
    'reg_core.sports_gallery',
    'reg_core.sports_gallery_detail',
    'reg_core.sports_videos',
    'reg_core.sports_search',
    'reg_core.videos',
    'reg_core.video_media_center',
    'reg_core.news',
  ];
  if (str_starts_with($route_name, 'reg_core.about')) {
    return;
  }
  if (!in_array($route_name, $custom_routes, TRUE)) {
    $route_node = \Drupal::routeMatch()->getParameter('node');
    if ($route_name === 'entity.node.canonical' && $route_node instanceof \Drupal\node\NodeInterface && $route_node->bundle() === 'reg_news') {
      return;
    }
    $hero = \Drupal::service('reg_core.section_hero_resolver')->resolve();
    if ($route_name === 'entity.node.canonical' && $route_node instanceof NodeInterface && $route_node->bundle() === 'reg_what_we_do_page') {
      $hero['eyebrow'] = 'What We Do';
      $hero['title'] = $route_node->label();
      $hero['description'] = (string) $route_node->get('field_reg_summary')->value;
    }
    if ($hero) {
      $variables['reg_section_hero_global'] = [
        '#theme' => 'reg_section_hero',
        '#hero' => $hero,
        '#attached' => ['library' => ['reg_core/section_hero']],
        '#cache' => [
          'contexts' => ['languages:language_interface', 'url.path'],
          'tags' => $hero['cache_tags'] ?? ['node_list:reg_section_hero'],
          'max-age' => 300,
        ],
      ];
    }
  }
}

/**
 * Implements hook_preprocess_node().
 */
function reg_core_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'reg_what_we_do_page' || ($variables['view_mode'] ?? '') !== 'full') {
    return;
  }

  $manager = \Drupal::entityTypeManager();
  $storage = $manager->getStorage('node');
  $key = (string) $node->get('field_reg_wwd_key')->value;
  $group = (string) $node->get('field_reg_wwd_group')->value;
  $variables['#attached']['library'][] = 'reg_core/what_we_do';
  $variables['page'] = [
    'title' => $node->label(),
    'summary' => (string) $node->get('field_reg_summary')->value,
    'body' => (string) $node->get('body')->processed,
    'key' => $key,
    'group' => $group,
    'source_url' => (string) ($node->get('field_reg_source_url')->uri ?? ''),
  ];

  $fact_ids = $storage->getQuery()->accessCheck(TRUE)
    ->condition('type', 'reg_fact')->condition('status', 1)
    ->condition('field_reg_wwd_key', $key)->sort('created', 'ASC')->execute();
  $variables['facts'] = [];
  foreach ($storage->loadMultiple($fact_ids) as $fact) {
    $value = rtrim(rtrim(number_format((float) $fact->get('field_reg_fact_value')->value, 3, '.', ','), '0'), '.');
    $variables['facts'][] = [
      'metric' => (string) $fact->get('field_reg_metric')->value,
      'value' => $value,
      'unit' => (string) $fact->get('field_reg_fact_unit')->value,
      'period' => (string) $fact->get('field_reg_reporting_period')->value,
    ];
  }

  $variables['children'] = [];
  foreach (\Drupal\reg_core\Content\WhatWeDoImporter::pageManifest() as $child_key => $definition) {
    $include = match ($key) {
      'overview' => in_array($child_key, ['generation', 'transmission', 'distribution', 'access', 'biomass-clean-cooking', 'petroleum', 'projects'], TRUE),
      'generation' => str_starts_with($child_key, 'generation-'),
      'access' => in_array($child_key, ['access-on-grid', 'access-off-grid', 'access-national-electrification-plan'], TRUE),
      'off-grid' => str_starts_with($child_key, 'off-grid-'),
      default => FALSE,
    };
    if (!$include) {
      continue;
    }
    $ids = $storage->getQuery()->accessCheck(TRUE)->condition('type', 'reg_what_we_do_page')->condition('status', 1)->condition('field_reg_wwd_key', $child_key)->range(0, 1)->execute();
    $child = $ids ? $storage->load(reset($ids)) : NULL;
    if ($child) {
      $variables['children'][] = ['title' => $child->label(), 'summary' => (string) $child->get('field_reg_summary')->value, 'url' => $child->toUrl()->toString()];
    }
  }

  $variables['plants'] = [];
  if ($key === 'generation') {
    $plant_ids = $storage->getQuery()->accessCheck(TRUE)->condition('type', 'reg_power_plant')->condition('status', 1)->sort('field_reg_plant_technology')->sort('title')->execute();
    foreach ($storage->loadMultiple($plant_ids) as $plant) {
      $variables['plants'][] = [
        'name' => $plant->label(), 'technology' => (string) $plant->get('field_reg_plant_technology')->value,
        'grid' => (string) ($plant->get('field_reg_grid_status')->value === 'off_grid' ? 'Off-grid' : 'On-grid'),
        'capacity' => rtrim(rtrim(number_format((float) $plant->get('field_reg_capacity_mw')->value, 3, '.', ','), '0'), '.'),
        'ownership' => (string) $plant->get('field_reg_ownership')->value,
        'year' => (string) $plant->get('field_reg_commissioning_year')->value,
      ];
    }
  }

  $variables['access_statistics'] = [];
  $access_type = match ($key) {'access' => 'total', 'access-on-grid' => 'on_grid', 'access-off-grid' => 'off_grid', default => ''};
  if ($access_type) {
    $stat_ids = $storage->getQuery()->accessCheck(TRUE)->condition('type', 'reg_access_statistic')->condition('status', 1)->condition('field_reg_access_type', $access_type)->sort('field_reg_district_name')->execute();
    foreach ($storage->loadMultiple($stat_ids) as $stat) {
      $variables['access_statistics'][] = ['district' => (string) $stat->get('field_reg_district_name')->value, 'rate' => number_format((float) $stat->get('field_reg_access_rate')->value, 1) . '%', 'period' => (string) $stat->get('field_reg_reporting_period')->value];
    }
  }

  $variables['projects'] = [];
  $project_limit = $key === 'projects' ? 60 : 6;
  $project_ids = $storage->getQuery()->accessCheck(TRUE)->condition('type', 'reg_project')->condition('status', 1)->sort('changed', 'DESC')->range(0, $project_limit)->execute();
  foreach ($storage->loadMultiple($project_ids) as $project) {
    $variables['projects'][] = ['title' => $project->label(), 'summary' => (string) $project->get('field_reg_summary')->value, 'category' => (string) $project->get('field_reg_project_category')->value, 'url' => $project->toUrl()->toString()];
  }

  $variables['news'] = [];
  $news_ids = $storage->getQuery()->accessCheck(TRUE)->condition('type', 'reg_news')->condition('status', 1)->sort('field_reg_publication_date', 'DESC')->range(0, 3)->execute();
  foreach ($storage->loadMultiple($news_ids) as $news) {
    $variables['news'][] = ['title' => $news->label(), 'url' => $news->toUrl()->toString()];
  }
}

/**
 * Implements hook_page_bottom().
 */
function reg_core_page_bottom(array &$page_bottom): void {
  $route = \Drupal::routeMatch()->getRouteObject();
  if (!$route || $route->getOption('_admin_route')) {
    return;
  }

  $config = \Drupal::config('reg_core.settings');
  $translation = \Drupal::translation();
  $page_bottom['reg_faq_assistant'] = [
    '#theme' => 'reg_faq_assistant',
    '#call_center' => $config->get('support.call_center') ?: '2727',
    '#faq_url' => Url::fromRoute('reg_core.faq')->toString(),
    '#search_url' => Url::fromRoute('reg_core.faq_search')->toString(),
    '#quick_topics' => [
      ['id' => 'outages', 'label' => $translation->translate('Power Outages')],
      ['id' => 'online_services', 'label' => $translation->translate('Online Services')],
      ['id' => 'connection', 'label' => $translation->translate('New Connection')],
      ['id' => 'tariffs', 'label' => $translation->translate('Tariffs and Billing')],
    ],
    '#attached' => [
      'library' => ['reg_core/faq_assistant'],
    ],
    '#cache' => [
      'contexts' => ['url.path', 'languages:language_interface'],
      'tags' => ['config:reg_core.settings', 'node_list:reg_faq'],
    ],
  ];

  CacheableMetadata::createFromRenderArray($page_bottom['reg_faq_assistant'])
    ->applyTo($page_bottom['reg_faq_assistant']);
}
