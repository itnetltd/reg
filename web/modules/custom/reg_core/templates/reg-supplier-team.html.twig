<section class="reg-supplier-shell"><nav class="reg-supplier-nav" aria-label="{{ 'Supplier workspace'|t }}">{% for link in links %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}</nav><div class="reg-supplier-heading"><h1>{{ 'Organization team'|t }}</h1>{% if can_invite %}<a class="reg-supplier-button" href="{{ path('reg_core.supplier_team_invite') }}">{{ 'INVITE TEAM MEMBER'|t }}</a>{% endif %}</div><div class="reg-supplier-table"><table><thead><tr><th>{{ 'Name'|t }}</th><th>{{ 'Email'|t }}</th><th>{{ 'Role'|t }}</th><th>{{ 'Status'|t }}</th></tr></thead><tbody>{% for member in members %}<tr><td>{{ member.name }}</td><td>{{ member.email }}</td><td>{{ member.role }}</td><td>{{ member.status }}</td></tr>{% endfor %}</tbody></table></div></section>
