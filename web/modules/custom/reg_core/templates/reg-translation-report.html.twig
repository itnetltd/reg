<div class="reg-admin-report">
  <p>{{ 'This report tracks editorial translations only. Official PDFs remain in their supplied source language unless REG publishes an approved translated document.'|t }}</p>
  <div class="reg-kpi-grid">
    <article><strong>{{ summary.total_priority }}</strong><span>{{ 'Total priority pages'|t }}</span></article><article><strong>{{ summary.fully_translated }}</strong><span>{{ 'Fully translated'|t }}</span></article><article><strong>{{ summary.missing_translation }}</strong><span>{{ 'Missing translation'|t }}</span></article><article><strong>{{ summary.outdated_translation }}</strong><span>{{ 'Translation outdated'|t }}</span></article><article><strong>{{ summary.pending_review }}</strong><span>{{ 'Pending review'|t }}</span></article>
  </div>
  <form method="get" class="reg-admin-filters"><label>{{ 'Translation status'|t }}<select name="status"><option value="">{{ 'All statuses'|t }}</option>{% for key, label in {'missing_rw':'Missing Kinyarwanda','outdated':'Outdated translation','pending_review':'Pending review','complete':'Complete'} %}<option value="{{ key }}"{{ filters.status == key ? ' selected' : '' }}>{{ label|t }}</option>{% endfor %}</select></label><label>{{ 'Content type'|t }}<select name="content_type"><option value="">{{ 'All content types'|t }}</option>{% for key, label in bundles %}<option value="{{ key }}"{{ filters.content_type == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><label>{{ 'Owner or department'|t }}<input name="owner" value="{{ filters.owner }}"></label><label>{{ 'Publication status'|t }}<select name="published"><option value="">{{ 'All'|t }}</option><option value="published"{{ filters.published == 'published' ? ' selected' : '' }}>{{ 'Published'|t }}</option><option value="unpublished"{{ filters.published == 'unpublished' ? ' selected' : '' }}>{{ 'Unpublished'|t }}</option></select></label><button type="submit">{{ 'Apply filters'|t }}</button></form>
  <div class="reg-admin-table-wrap"><table><caption class="visually-hidden">{{ 'REG translation status'|t }}</caption><thead><tr><th scope="col">{{ 'Content'|t }}</th><th scope="col">{{ 'Content Type'|t }}</th><th scope="col">{{ 'Priority'|t }}</th><th scope="col">{{ 'Source Language'|t }}</th><th scope="col">{{ 'English Status'|t }}</th><th scope="col">{{ 'Kinyarwanda Status'|t }}</th><th scope="col">{{ 'Last Updated'|t }}</th><th scope="col">{{ 'Owner'|t }}</th><th scope="col">{{ 'Review Date'|t }}</th></tr></thead><tbody>{% for row in rows %}<tr><th scope="row">{{ row.title }}</th><td>{{ row.bundle }}</td><td>{{ row.priority }}</td><td>{{ row.source_language }}</td><td>{{ row.english_status }}</td><td>{{ row.kinyarwanda_status }}</td><td>{{ row.last_updated }}</td><td>{{ row.owner }}{% if row.department %}<small>{{ row.department }}</small>{% endif %}</td><td>{{ row.review_date }}</td></tr>{% else %}<tr><td colspan="9">{{ 'No content matched these filters.'|t }}</td></tr>{% endfor %}</tbody></table></div>
</div>
