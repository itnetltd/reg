<div class="reg-pi">
  {% set search_hero = section_hero|merge({eyebrow: 'Public Information'|t, title: 'Search public information'|t, description: 'Search only approved, published tenders, job notices, recruitment results, and official publications.'|t}) %}
  {% include '@reg_core/reg-section-hero.html.twig' with {hero: search_hero} only %}
  <div class="reg-container reg-pi__body">
    <form class="reg-pi-filter reg-pi-filter--search reg-filter-bar reg-filter-bar--wide" method="get" role="search">
      <div class="reg-pi-filter__search reg-filter-field reg-filter-field--search"><label for="reg-pi-search-q">{{ 'Keywords'|t }}</label><input id="reg-pi-search-q" name="q" type="search" maxlength="120" value="{{ filters.query }}"></div>
      <div class="reg-filter-field"><label for="reg-pi-type">{{ 'Information type'|t }}</label><select id="reg-pi-type" name="type"><option value="">{{ 'Everything'|t }}</option>{% for value, label in type_options %}<option value="{{ value }}"{% if filters.type == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
      <div class="reg-filter-field"><label for="reg-pi-entity">{{ 'Company'|t }}</label><select id="reg-pi-entity" name="entity"><option value="">{{ 'All companies'|t }}</option>{% for value, label in entity_options %}<option value="{{ value }}"{% if filters.entity == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
      {% if category_options %}<div class="reg-filter-field"><label for="reg-pi-category">{{ 'Category'|t }}</label><select id="reg-pi-category" name="category"><option value="">{{ 'All categories'|t }}</option>{% for value, label in category_options %}<option value="{{ value }}"{% if filters.category == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>{% endif %}
      <div class="reg-filter-field"><label for="reg-pi-language">{{ 'File language'|t }}</label><select id="reg-pi-language" name="language"><option value="">{{ 'All languages'|t }}</option>{% for value, label in language_options %}<option value="{{ value }}"{% if filters.language == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
      <button class="reg-filter-submit" type="submit">{{ 'Search'|t }}</button>
    </form>
    {% if items %}
      <div class="reg-pi-list">
        {% for item in items %}
          <article class="reg-pi-card">
            <div class="reg-pi-card__top"><span class="reg-pi-type">{{ item.kind }}</span>{% if item.status %}<span class="reg-pi-badge reg-pi-badge--{{ item.status_key|clean_class }}">{{ item.status }}</span>{% endif %}</div>
            <h2><a href="{{ item.url }}">{{ item.title }}</a></h2><p>{{ item.summary }}</p>
            <span class="reg-pi-muted">{{ item.entity }}{% if item.date %} · {{ item.date }}{% endif %}</span>
            <a class="reg-pi-card__link" href="{{ item.url }}">{{ 'View details'|t }} <span aria-hidden="true">→</span></a>
          </article>
        {% endfor %}
      </div>
      {{ pager }}
    {% else %}
      <div class="reg-pi-empty" role="status"><h2>{{ 'No published results'|t }}</h2><p>{{ 'Try a broader keyword or clear one of the filters.'|t }}</p></div>
    {% endif %}
  </div>
</div>
