<div class="reg-sports">
  {% set sports_listing_hero = section_hero|merge({eyebrow: 'REG Sports'|t, title: heading, description: 'Only approved, published sports information is displayed.'|t}) %}
  {% include '@reg_core/reg-section-hero.html.twig' with {hero: sports_listing_hero} only %}
  <nav class="reg-sports-nav" aria-label="{{ 'Sports Portal navigation'|t }}"><div class="reg-container">{% for link in links %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}</div></nav>
  <main class="reg-container reg-sports__body">
    <form class="reg-sports-filter reg-filter-bar reg-filter-bar--dense" method="get" role="search">
      {% if view in ['search', 'news'] %}<div class="reg-sports-filter__wide reg-filter-field reg-filter-field--search"><label for="sports-q">{{ 'Search'|t }}</label><input id="sports-q" name="q" type="search" maxlength="120" value="{{ filters.query }}"></div>{% endif %}
      {% if teams %}<div><label for="sports-team">{{ 'Team'|t }}</label><select id="sports-team" name="team"><option value="">{{ 'All teams'|t }}</option>{% for value, label in teams %}<option value="{{ value }}"{% if filters.team == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>{% endif %}
      {% if sports %}<div><label for="sports-sport">{{ 'Sport'|t }}</label><select id="sports-sport" name="sport"><option value="">{{ 'All sports'|t }}</option>{% for value, label in sports %}<option value="{{ value }}"{% if filters.sport == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>{% endif %}
      {% if competitions and view in ['fixtures', 'results'] %}<div><label for="sports-competition">{{ 'Competition'|t }}</label><select id="sports-competition" name="competition"><option value="">{{ 'All competitions'|t }}</option>{% for value, label in competitions %}<option value="{{ value }}"{% if filters.competition == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>{% endif %}
      {% if seasons and view in ['fixtures', 'results', 'players'] %}<div><label for="sports-season">{{ 'Season'|t }}</label><select id="sports-season" name="season"><option value="">{{ 'All seasons'|t }}</option>{% for value, label in seasons %}<option value="{{ value }}"{% if filters.season == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>{% endif %}
      {% if positions and view == 'players' %}<div><label for="sports-position">{{ 'Position'|t }}</label><select id="sports-position" name="position"><option value="">{{ 'All positions'|t }}</option>{% for value, label in positions %}<option value="{{ value }}"{% if filters.position == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>{% endif %}
      {% if view in ['fixtures', 'results'] %}<div><label for="sports-month">{{ 'Month'|t }}</label><input id="sports-month" name="month" type="month" value="{{ filters.month }}"></div><div><label for="sports-status">{{ 'Status'|t }}</label><select id="sports-status" name="status"><option value="">{{ 'Route default'|t }}</option>{% for value, label in {'scheduled':'Scheduled'|t,'postponed':'Postponed'|t,'cancelled':'Cancelled'|t,'live':'Live'|t,'completed':'Completed'|t} %}<option value="{{ value }}"{% if filters.status == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>{% endif %}
      <button class="reg-filter-submit" type="submit">{{ view == 'search' ? 'Search'|t : 'Apply filters'|t }}</button>
    </form>
    <div class="reg-sports-results-count reg-filter-results" aria-live="polite"><strong>{{ count }} {{ count == 1 ? 'result'|t : 'results'|t }}</strong>{% if filters.query or filters.team or filters.sport or filters.competition or filters.season or filters.position or filters.month or filters.status %}<a class="reg-filter-clear" href="?">{{ 'Clear filters'|t }}</a>{% endif %}</div>
    {% if items %}
      {% if view in ['fixtures', 'results'] %}
        <div class="reg-sports-fixture-grid">
          {% for item in items %}
            <article class="reg-sports-fixture-card">
              <div>
                <span class="reg-sports-badge reg-sports-badge--{{ item.status_key|clean_class }}">{{ item.result_label ?: item.status }}</span>
                {% if item.date %}<time datetime="{{ item.date_iso }}">{{ item.date }}</time>{% endif %}
              </div>
              <h2><a href="{{ item.url }}" data-reg-analytics-event="{{ view == 'results' ? 'result_view' : 'fixture_view' }}" data-reg-analytics-id="{{ item.id }}">{{ item.score_label ?: item.matchup }}</a></h2>
              {% if item.score %}<strong class="reg-sports-score" aria-label="{{ 'Final score: @score'|t({'@score': item.score_label}) }}">{{ item.score }}</strong>{% endif %}
              {% if item.competition or item.venue or item.round %}<dl>{% if item.competition %}<div><dt>{{ 'Competition'|t }}</dt><dd>{{ item.competition }}</dd></div>{% endif %}{% if item.venue %}<div><dt>{{ 'Venue'|t }}</dt><dd>{{ item.venue }}</dd></div>{% endif %}{% if item.round %}<div><dt>{{ 'Round'|t }}</dt><dd>{{ item.round }}</dd></div>{% endif %}</dl>{% endif %}
              <a href="{{ item.url }}">{{ view == 'results' ? 'View match result'|t : 'View match'|t }} <span aria-hidden="true">→</span></a>
            </article>
          {% endfor %}
        </div>
      {% elseif view == 'players' %}<div class="reg-sports-player-grid">{% for player in items %}<a class="reg-sports-player-card" href="{{ player.url }}" data-reg-analytics-event="player_profile_view" data-reg-analytics-id="{{ player.id }}">{% if player.image.url %}<img src="{{ player.image.url }}"{% if player.image.srcset %} srcset="{{ player.image.srcset }}" sizes="{{ player.image.sizes }}"{% endif %} alt="{{ player.image.alt }}" loading="lazy">{% endif %}<span>{% if player.jersey %}#{{ player.jersey }} · {% endif %}{{ player.position }}</span><h2>{{ player.title }}</h2><small>{{ player.team }}</small></a>{% endfor %}</div>
      {% elseif view == 'gallery' %}<div class="reg-sports-gallery-grid">{% for item in items %}<a href="{{ item.url }}" data-reg-analytics-event="gallery_view" data-reg-analytics-id="{{ item.id }}">{% if item.image.url %}<img src="{{ item.image.url }}"{% if item.image.srcset %} srcset="{{ item.image.srcset }}" sizes="{{ item.image.sizes }}"{% endif %} alt="{{ item.image.alt }}" loading="lazy">{% endif %}<div><h2>{{ item.title }}</h2><span>{{ item.team }}{% if item.date %} · {{ item.date }}{% endif %}</span></div></a>{% endfor %}</div>
      {% elseif view == 'videos' %}<div class="reg-sports-gallery-grid">{% for item in items %}<a href="{{ item.video_url ?: '#' }}" data-reg-analytics-event="video_click" data-reg-analytics-id="{{ item.id }}">{% if item.image.url %}<img src="{{ item.image.url }}"{% if item.image.srcset %} srcset="{{ item.image.srcset }}" sizes="{{ item.image.sizes }}"{% endif %} alt="{{ item.image.alt }}" loading="lazy">{% endif %}<div><span class="reg-sports-play" aria-hidden="true">▶</span><h2>{{ item.title }}</h2><span>{{ item.team }}{% if item.date %} · {{ item.date }}{% endif %}</span></div></a>{% endfor %}</div>
      {% else %}<div class="reg-sports-card-grid">{% for item in items %}<article class="reg-sports-content-card">{% if item.image.url %}<img src="{{ item.image.url }}"{% if item.image.srcset %} srcset="{{ item.image.srcset }}" sizes="{{ item.image.sizes }}"{% endif %} alt="{{ item.image.alt }}" loading="lazy">{% endif %}<div><span>{{ item.category ?: item.kind }}</span><h2><a href="{{ item.url }}" data-reg-analytics-event="{{ item.bundle == 'reg_sports_update' ? 'sports_article_view' : 'sports_search_result' }}" data-reg-analytics-id="{{ item.id }}">{{ item.title }}</a></h2><p>{{ item.summary ?: item.description }}</p><small>{{ item.team }}{% if item.date %} · {{ item.date }}{% endif %}</small></div></article>{% endfor %}</div>{% endif %}
      {{ pager }}
    {% else %}<div class="reg-sports-empty" role="status"><h2>{{ 'Nothing published yet'|t }}</h2><p>{{ empty_message }}</p></div>{% endif %}
  </main>
</div>
