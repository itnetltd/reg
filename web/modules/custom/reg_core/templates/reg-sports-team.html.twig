<div class="reg-sports" data-reg-analytics-event="team_page_view" data-reg-analytics-id="{{ team.id }}">
  {% if team.image.url %}
  <section class="reg-sports-team-hero"{% if team.image.url %} style="--sports-hero-image: url('{{ team.image.url }}')"{% endif %}>
    <div class="reg-container reg-sports-team-hero__inner">{% if team.logo.url %}<img src="{{ team.logo.url }}"{% if team.logo.srcset %} srcset="{{ team.logo.srcset }}" sizes="{{ team.logo.sizes }}"{% endif %} alt="{{ team.logo.alt }}">{% endif %}<span class="reg-sports-kicker">{{ team.sport ?: 'REG Sports'|t }}</span><h1>{{ team.title }}</h1>{% if team.description %}<p>{{ team.description }}</p>{% endif %}<dl>{% if team.competition %}<div><dt>{{ 'Competition'|t }}</dt><dd>{{ team.competition }}</dd></div>{% endif %}{% if team.season %}<div><dt>{{ 'Season'|t }}</dt><dd>{{ team.season }}</dd></div>{% endif %}{% if team.coach %}<div><dt>{{ 'Head coach'|t }}</dt><dd>{{ team.coach }}</dd></div>{% endif %}{% if team.venue %}<div><dt>{{ 'Home venue'|t }}</dt><dd>{{ team.venue }}</dd></div>{% endif %}</dl></div>
  </section>
  {% else %}
    {% set team_hero = section_hero|merge({eyebrow: team.sport ?: 'REG Sports'|t, title: team.title, description: team.description}) %}
    {% include '@reg_core/reg-section-hero.html.twig' with {hero: team_hero} only %}
  {% endif %}
  <nav class="reg-sports-nav" aria-label="{{ 'Sports Portal navigation'|t }}"><div class="reg-container">{% for link in links %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}</div></nav>
  <main class="reg-container reg-sports__body">
    <section><div class="reg-sports-heading"><span class="reg-sports-kicker">{{ 'Match centre'|t }}</span><h2>{{ 'Upcoming fixtures'|t }}</h2></div>{% if team.fixtures %}<div class="reg-sports-fixture-list">{% for item in team.fixtures %}<a href="{{ item.url }}"{% if not item.date %} class="reg-sports-fixture-list__no-date"{% endif %}>{% if item.date %}<time datetime="{{ item.date_iso }}">{{ item.date }}</time>{% endif %}<strong>{{ item.matchup }}</strong>{% if item.competition or item.venue %}<span>{{ item.competition }}{% if item.competition and item.venue %} · {% endif %}{{ item.venue }}</span>{% endif %}</a>{% endfor %}</div>{% else %}<div class="reg-sports-empty"><p>{{ 'No upcoming fixtures currently published for this team.'|t }}</p></div>{% endif %}</section>
    <section><div class="reg-sports-heading"><span class="reg-sports-kicker">{{ 'Recent games'|t }}</span><h2>{{ 'Latest results'|t }}</h2></div>{% if team.results %}<div class="reg-sports-fixture-list">{% for item in team.results %}<a href="{{ item.url }}"{% if not item.date %} class="reg-sports-fixture-list__no-date"{% endif %}>{% if item.date %}<time datetime="{{ item.date_iso }}">{{ item.date }}</time>{% endif %}<strong>{{ item.score_label ?: item.matchup }}</strong><span class="reg-sports-result-status">{{ item.result_label ?: item.status }}</span></a>{% endfor %}</div>{% else %}<div class="reg-sports-empty"><p>{{ 'No results currently available for this team.'|t }}</p></div>{% endif %}</section>
    <section><div class="reg-sports-heading"><span class="reg-sports-kicker">{{ 'Team roster'|t }}</span><h2>{{ 'Players'|t }}</h2></div>{% if team.players %}<div class="reg-sports-player-grid">{% for player in team.players %}<a class="reg-sports-player-card" href="{{ player.url }}" data-reg-analytics-event="player_profile_view" data-reg-analytics-id="{{ player.id }}">{% if player.image.url %}<img src="{{ player.image.url }}"{% if player.image.srcset %} srcset="{{ player.image.srcset }}" sizes="{{ player.image.sizes }}"{% endif %} alt="{{ player.image.alt }}" loading="lazy">{% endif %}{% if player.jersey or player.position %}<span>{% if player.jersey %}#{{ player.jersey }}{% if player.position %} · {% endif %}{% endif %}{{ player.position }}</span>{% endif %}<h3>{{ player.title }}</h3>{% if player.captain %}<small>{{ 'Captain'|t }}</small>{% endif %}</a>{% endfor %}</div>{% else %}<div class="reg-sports-empty"><p>{{ 'No players are currently published for this team.'|t }}</p></div>{% endif %}</section>
    <section><div class="reg-sports-heading"><span class="reg-sports-kicker">{{ 'Technical team'|t }}</span><h2>{{ 'Coaches and staff'|t }}</h2></div>{% if team.staff %}<div class="reg-sports-staff-grid">{% for staff in team.staff %}<article>{% if staff.image.url %}<img src="{{ staff.image.url }}"{% if staff.image.srcset %} srcset="{{ staff.image.srcset }}" sizes="{{ staff.image.sizes }}"{% endif %} alt="{{ staff.image.alt }}" loading="lazy">{% endif %}<h3>{{ staff.title }}</h3><p>{{ staff.role }}</p>{% if staff.description %}<p>{{ staff.description }}</p>{% endif %}</article>{% endfor %}</div>{% elseif team.technical_summary %}<p>{{ team.technical_summary|nl2br }}</p>{% else %}<div class="reg-sports-empty"><p>{{ 'Technical staff profiles will appear when approved.'|t }}</p></div>{% endif %}</section>
    <section><div class="reg-sports-heading"><span class="reg-sports-kicker">{{ 'Competition'|t }}</span><h2>{{ 'Standings'|t }}</h2></div>{% if team.standings %}<div class="reg-sports-table-wrap"><table class="reg-sports-table"><caption class="visually-hidden">{{ team.title }} {{ 'standings'|t }}</caption><thead><tr><th>#</th><th>{{ 'Team'|t }}</th><th>{{ 'P'|t }}</th><th>{{ 'W'|t }}</th><th>{{ 'L'|t }}</th><th>{{ 'Pts'|t }}</th></tr></thead><tbody>{% for row in team.standings %}<tr><td>{{ row.standing.table_position }}</td><th scope="row">{{ row.standing.team }}</th><td>{{ row.standing.played }}</td><td>{{ row.standing.wins }}</td><td>{{ row.standing.losses }}</td><td>{{ row.standing.league_points }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="reg-sports-empty"><p>{{ 'Standings will be published when confirmed.'|t }}</p></div>{% endif %}</section>
    <section><div class="reg-sports-heading"><span class="reg-sports-kicker">{{ 'Team updates'|t }}</span><h2>{{ 'Latest news'|t }}</h2></div>{% if team.news %}<div class="reg-sports-card-grid">{% for item in team.news %}<article class="reg-sports-content-card">{% if item.image.url %}<img src="{{ item.image.url }}"{% if item.image.srcset %} srcset="{{ item.image.srcset }}" sizes="{{ item.image.sizes }}"{% endif %} alt="{{ item.image.alt }}" loading="lazy">{% endif %}<div><span>{{ item.category }}</span><h3><a href="{{ item.url }}">{{ item.title }}</a></h3><p>{{ item.summary }}</p></div></article>{% endfor %}</div>{% else %}<div class="reg-sports-empty"><p>{{ 'No team news is currently published.'|t }}</p></div>{% endif %}</section>
    <section><div class="reg-sports-heading"><span class="reg-sports-kicker">{{ 'Team media'|t }}</span><h2>{{ 'Gallery and videos'|t }}</h2></div><div class="reg-sports-media-columns"><div>{% if team.galleries %}<div class="reg-sports-media-grid">{% for item in team.galleries %}<a href="{{ item.url }}">{% if item.image.url %}<img src="{{ item.image.url }}"{% if item.image.srcset %} srcset="{{ item.image.srcset }}" sizes="{{ item.image.sizes }}"{% endif %} alt="{{ item.image.alt }}" loading="lazy">{% endif %}<strong>{{ item.title }}</strong></a>{% endfor %}</div>{% else %}<p class="reg-sports-empty-inline">{{ 'No team galleries are currently published.'|t }}</p>{% endif %}</div><div>{% if team.videos %}<div class="reg-sports-media-grid">{% for item in team.videos %}<a href="{{ item.video_url ?: path('reg_core.sports_videos') }}" data-reg-analytics-event="video_click" data-reg-analytics-id="{{ item.id }}">{% if item.image.url %}<img src="{{ item.image.url }}"{% if item.image.srcset %} srcset="{{ item.image.srcset }}" sizes="{{ item.image.sizes }}"{% endif %} alt="{{ item.image.alt }}" loading="lazy">{% endif %}<strong>{{ item.title }}</strong></a>{% endfor %}</div>{% else %}<p class="reg-sports-empty-inline">{{ 'No team videos are currently published.'|t }}</p>{% endif %}</div></div></section>
  </main>
</div>
