<div class="reg-media-center">
  {% set hero = section_hero|default({})|merge({
    eyebrow: 'Media Center'|t,
    title: 'Stay informed'|t,
    description: 'Official REG news, publications and media resources.'|t
  }) %}
  {% include '@reg_core/reg-section-hero.html.twig' with {hero: hero} only %}

  <main class="reg-container reg-media-center__body">
    <section class="reg-media-center__featured" aria-labelledby="media-featured">
      <div class="reg-media-center__heading">
        <div>
          <span>{{ 'Featured Corporate News'|t }}</span>
          <h2 id="media-featured">{{ 'Featured Corporate News'|t }}</h2>
        </div>
        <a href="{{ path('reg_core.news') }}">{{ 'View all corporate news'|t }} &rarr;</a>
      </div>
      {% if featured %}
        {% include '@reg_core/reg-news-card.html.twig' with {item: featured, variant: 'featured'} only %}
      {% else %}
        <p class="reg-media-center__empty">{{ 'No featured corporate news is currently available.'|t }}</p>
      {% endif %}
    </section>

    <section aria-labelledby="media-corporate">
      <div class="reg-media-center__heading">
        <div>
          <span>{{ 'News & Insights'|t }}</span>
          <h2 id="media-corporate">{{ 'Latest Corporate News'|t }}</h2>
        </div>
        <nav class="reg-media-center__language" aria-label="{{ 'Corporate news languages'|t }}">
          <a href="{{ path('reg_core.news') }}">{{ 'All'|t }}</a>
          <a lang="en" href="{{ path('reg_core.news_english') }}">{{ 'English'|t }}</a>
          <a lang="rw" href="{{ path('reg_core.news_kinyarwanda') }}">{{ 'Kinyarwanda'|t }}</a>
        </nav>
      </div>
      {% if corporate %}
        <div class="reg-news-grid">
          {% for item in corporate %}
            {% include '@reg_core/reg-news-card.html.twig' with {item: item, variant: 'card'} only %}
          {% endfor %}
        </div>
      {% else %}
        <p class="reg-media-center__empty">{{ 'No additional corporate news is currently available.'|t }}</p>
      {% endif %}
    </section>

    <section aria-labelledby="media-sports">
      <div class="reg-media-center__heading">
        <div>
          <span>{{ 'REG Sports'|t }}</span>
          <h2 id="media-sports">{{ 'Latest Sports News'|t }}</h2>
        </div>
        <a href="{{ path('reg_core.sports_news') }}">{{ 'View all sports news'|t }} &rarr;</a>
      </div>
      {% if sports %}
        <div class="reg-news-grid">
          {% for item in sports %}
            {% include '@reg_core/reg-news-card.html.twig' with {item: item, variant: 'card'} only %}
          {% endfor %}
        </div>
      {% else %}
        <p class="reg-media-center__empty">{{ 'No sports news is currently available.'|t }}</p>
      {% endif %}
    </section>

    <section aria-labelledby="media-documents">
      <div class="reg-media-center__heading">
        <div>
          <span>{{ 'Official Documents'|t }}</span>
          <h2 id="media-documents">{{ 'Press Releases, Publications and Newsletters'|t }}</h2>
        </div>
      </div>
      <div class="reg-media-center__documents">
        {% for key, items in documents %}
          {% set archive_route = key == 'press' ? 'reg_core.press_releases' : (key == 'newsletters' ? 'reg_core.newsletters' : 'reg_core.publications') %}
          <section aria-labelledby="media-documents-{{ key }}">
            <h3 id="media-documents-{{ key }}">{{ key == 'press' ? 'Press Releases'|t : (key == 'newsletters' ? 'Newsletters'|t : 'Publications'|t) }}</h3>
            {% if items %}
              {% for item in items %}
                <article>
                  {% if item.date %}<span>{{ item.date }}</span>{% endif %}
                  <h4><a href="{{ item.url }}">{{ item.title }}</a></h4>
                  {% if item.primary_document.url %}<a href="{{ item.primary_document.url }}">{{ 'Download'|t }} &rarr;</a>{% endif %}
                </article>
              {% endfor %}
            {% else %}
              <p class="reg-media-center__empty">{{ 'No published items are currently available.'|t }}</p>
            {% endif %}
            <a class="reg-media-center__all" href="{{ path(archive_route) }}">{{ 'View archive'|t }} &rarr;</a>
          </section>
        {% endfor %}
      </div>
    </section>

    <section aria-labelledby="media-gallery">
      <div class="reg-media-center__heading">
        <div>
          <span>{{ 'Official Flickr'|t }}</span>
          <h2 id="media-gallery">{{ 'Photo Gallery'|t }}</h2>
        </div>
        <a href="{{ path('reg_core.media_gallery') }}">{{ 'View photo gallery'|t }} &rarr;</a>
      </div>
      {% if gallery.items %}
        <div class="reg-media-gallery__grid reg-media-gallery__grid--preview">
          {% for photo in gallery.items %}
            <a href="{{ photo.url }}" target="_blank" rel="noopener noreferrer">
              <span class="reg-media-gallery__image"><img src="{{ photo.image_url }}" alt="{{ photo.title }}" width="640" height="480" loading="lazy"></span>
              <span>{{ photo.title }}</span>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <div class="reg-media-center__fallback">
          <p>{{ gallery.enabled ? 'The Flickr preview is temporarily unavailable.'|t : 'The official Flickr gallery has not yet been enabled.'|t }}</p>
          {% if gallery.profile_url %}<a href="{{ gallery.profile_url }}" target="_blank" rel="noopener noreferrer">{{ 'View REG photo gallery on Flickr'|t }} &rarr;</a>{% endif %}
        </div>
      {% endif %}
    </section>

    <section aria-labelledby="media-videos">
      <div class="reg-media-center__heading">
        <div>
          <span>{{ 'Official YouTube videos'|t }}</span>
          <h2 id="media-videos">{{ 'Videos'|t }}</h2>
        </div>
        <a href="{{ path('reg_core.videos') }}">{{ 'View all videos'|t }} &rarr;</a>
      </div>
      {% if videos %}
        <div class="reg-media-center__video-grid">
          {% for video in videos %}
            <article>
              <a href="{{ video.public_url }}" target="_blank" rel="noopener noreferrer">
                <span class="reg-media-center__video-image"><img src="{{ video.thumbnail.url }}" alt="{{ video.thumbnail.alt }}" width="640" height="360" loading="lazy"></span>
                {% if video.date %}<time datetime="{{ video.date_iso }}">{{ video.date }}</time>{% endif %}
                <h3>{{ video.title }}</h3>
                <strong>{{ 'Watch video'|t }} &rarr;</strong>
              </a>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <p class="reg-media-center__empty">{{ 'No published REG videos are currently available.'|t }}</p>
      {% endif %}
    </section>

    <section aria-labelledby="media-follow">
      <div class="reg-media-center__heading">
        <div>
          <span>{{ 'Official Channels'|t }}</span>
          <h2 id="media-follow">{{ 'Follow REG'|t }}</h2>
        </div>
      </div>
      {% if social_available %}
        {{ social }}
      {% else %}
        <div class="reg-media-center__fallback">
          <p>{{ 'Official social-media links are temporarily unavailable. They can be enabled in the central REG social-media settings.'|t }}</p>
        </div>
      {% endif %}
    </section>
  </main>
</div>
