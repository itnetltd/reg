<div class="reg-assistant" data-reg-assistant data-search-url="{{ search_url }}">
  <button class="reg-assistant__toggle" type="button" aria-expanded="false" aria-haspopup="dialog" aria-controls="reg-assistant-panel" data-reg-assistant-toggle>
    <span aria-hidden="true">?</span>
    <span>{{ 'Help & FAQs'|t }}</span>
  </button>
  <section class="reg-assistant__panel" id="reg-assistant-panel" role="dialog" aria-modal="false" aria-labelledby="reg-assistant-title" hidden data-reg-assistant-panel>
    <div class="reg-assistant__header">
      <div>
        <strong id="reg-assistant-title">{{ 'REG Help Assistant'|t }}</strong>
        <small>{{ 'Published answers approved by REG'|t }}</small>
      </div>
      <button type="button" aria-label="{{ 'Close help assistant'|t }}" data-reg-assistant-close>&times;</button>
    </div>
    <form class="reg-assistant__form" data-reg-assistant-form>
      <label for="reg-assistant-query">{{ 'What do you need help with?'|t }}</label>
      <div class="reg-assistant__search-row">
        <input id="reg-assistant-query" type="search" minlength="2" maxlength="120" placeholder="{{ 'Outages, tariffs, new connection…'|t }}" required data-reg-assistant-input>
        <button type="submit">{{ 'Search'|t }}</button>
      </div>
      <small>{{ 'Do not enter account or personal information.'|t }}</small>
    </form>
    <div class="reg-assistant__topics" aria-label="{{ 'Quick topics'|t }}">
      {% for topic in quick_topics %}
        <button type="button" data-reg-quick-topic="{{ topic.id }}">{{ topic.label }}</button>
      {% endfor %}
    </div>
    <div class="reg-assistant__results" aria-live="polite" aria-atomic="false" data-reg-assistant-results>
      <p>{{ 'Search the official FAQ knowledge base. This assistant does not generate answers.'|t }}</p>
    </div>
    <div class="reg-assistant__footer">
      <a href="{{ faq_url }}">{{ 'Browse all FAQs'|t }}</a>
      <a href="tel:{{ call_center|replace({' ': '', '-': ''}) }}">{{ 'Call center:'|t }} <strong>{{ call_center }}</strong></a>
    </div>
  </section>
</div>
