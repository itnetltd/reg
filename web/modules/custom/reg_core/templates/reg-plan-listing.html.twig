<div class="reg-plan">
  {% set hero = (section_hero|default({}))|merge({eyebrow: kind == 'procurement' ? 'Procurement'|t : 'Careers'|t, title: heading, description: description}) %}
  {% include '@reg_core/reg-section-hero.html.twig' with {hero: hero} only %}
  <div class="reg-container reg-plan__body">
    <form class="reg-plan__filters reg-filter-bar reg-filter-bar--wide" method="get" role="search">
      <label>{{ 'Search'|t }}<input name="q" type="search" value="{{ filters.q }}" placeholder="{{ kind == 'procurement' ? 'Activity title or plan reference'|t : 'Position or department'|t }}"></label>
      <label>{{ 'Financial Year'|t }}<select name="year"><option value="">{{ 'All years'|t }}</option>{% for value, label in years %}<option value="{{ value }}"{% if filters.year == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
      <label>{{ 'Entity'|t }}<select name="entity"><option value="">{{ 'All entities'|t }}</option>{% for value, label in entity_options %}<option value="{{ value }}"{% if filters.entity == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
      {% if kind == 'procurement' %}<label>{{ 'Category'|t }}<select name="category"><option value="">{{ 'All categories'|t }}</option>{% for value, label in category_options %}<option value="{{ value }}"{% if filters.category == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>{% else %}<label>{{ 'Department'|t }}<select name="department"><option value="">{{ 'All departments'|t }}</option>{% for value, label in departments %}<option value="{{ value }}"{% if filters.department == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>{% endif %}
      <label>{{ 'Status'|t }}<select name="status"><option value="">{{ 'All statuses'|t }}</option>{% for value, label in status_options %}<option value="{{ value }}"{% if filters.status == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
      <button class="reg-filter-submit" type="submit">{{ 'Apply filters'|t }}</button>
    </form>
    {% if items %}<div class="reg-plan__table-wrap"><table><thead><tr><th>{{ kind == 'procurement' ? 'Plan reference'|t : 'Position'|t }}</th><th>{{ kind == 'procurement' ? 'Tender / activity'|t : 'Entity'|t }}</th><th>{{ kind == 'procurement' ? 'Entity'|t : 'Positions'|t }}</th><th>{{ kind == 'procurement' ? 'Category / method'|t : 'Planned quarter'|t }}</th><th>{{ 'Status'|t }}</th><th>{{ 'Action'|t }}</th></tr></thead><tbody>{% for item in items %}<tr><td data-label="{{ kind == 'procurement' ? 'Plan reference'|t : 'Position'|t }}">{{ kind == 'procurement' ? item.reference : item.title }}</td><td data-label="{{ kind == 'procurement' ? 'Activity'|t : 'Entity'|t }}">{{ kind == 'procurement' ? item.title : item.entity }}</td><td data-label="{{ kind == 'procurement' ? 'Entity'|t : 'Positions'|t }}">{{ kind == 'procurement' ? item.entity : item.positions }}</td><td data-label="{{ kind == 'procurement' ? 'Category / method'|t : 'Planned quarter'|t }}">{{ kind == 'procurement' ? item.category ~ (item.method ? ' · ' ~ item.method : '') : item.quarter }}</td><td data-label="{{ 'Status'|t }}"><span class="reg-plan__badge">{{ item.status }}</span></td><td>{% if item.related_url %}<a href="{{ item.related_url }}">{{ kind == 'procurement' ? 'View tender'|t : 'View vacancy'|t }} →</a>{% else %}<span>{{ 'Planned'|t }}</span>{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="reg-plan__empty" role="status"><h2>{{ 'No approved public plan items matched these filters.'|t }}</h2></div>{% endif %}
  </div>
</div>
