{{ attach_library('reg_core/news_homepage') }}
{% if content.primary %}
  <div class="reg-news-homepage reg-news-homepage--visual">
    <article class="reg-news-lead">
      <a class="reg-news-lead__media" href="{{ content.primary.url }}" aria-label="{{ 'Read @title'|t({'@title': content.primary.title}) }}">
        {% if content.primary.image.render %}
          {{ content.primary.image.render }}
        {% elseif content.primary.image.absolute_url %}
          <img src="{{ content.primary.image.absolute_url }}" alt="{{ content.primary.image.alt }}" loading="eager" decoding="async">
        {% else %}
          <span class="reg-news-image-fallback reg-news-image-fallback--lead" aria-hidden="true"><span>REG</span><strong>{{ 'News & Insights'|t }}</strong></span>
        {% endif %}
      </a>
      <div class="reg-news-lead__body">
        <div class="reg-news-card__meta">
          {% if content.primary.category.label %}<span>{{ content.primary.category.label }}</span>{% endif %}
          {% if content.primary.date %}<time datetime="{{ content.primary.date_iso }}">{{ content.primary.date }}</time>{% endif %}
        </div>
        <h3><a href="{{ content.primary.url }}">{{ content.primary.title }}</a></h3>
        {% if content.primary.summary %}<p>{{ content.primary.summary }}</p>{% endif %}
        <a class="reg-news-card__action" href="{{ content.primary.url }}">{{ 'Read story'|t }} <span aria-hidden="true">→</span></a>
      </div>
    </article>

    {% if content.secondary %}
      <div class="reg-news-homepage__secondary">
        {% for item in content.secondary %}
          {% include '@reg_core/reg-news-homepage-story.html.twig' with {item: item} only %}
        {% endfor %}
      </div>
      {% if content.x_feed %}
        <div class="reg-news-homepage__social" tabindex="0" role="region" aria-label="{{ 'Stay connected on X'|t }}">
          {{ attach_library('reg_core/x_feed') }}
          {% include '@reg_core/reg-x-feed.html.twig' with {feed: content.x_feed} only %}
        </div>
      {% endif %}
    {% endif %}
  </div>
{% else %}
  <div class="reg-news-empty"><p>{{ 'No News & Insights stories are currently published.'|t }}</p></div>
{% endif %}