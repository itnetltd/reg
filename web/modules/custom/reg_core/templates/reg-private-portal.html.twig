<div class="reg-container reg-private-portal"><h1>{{ heading }}</h1><div class="messages messages--warning" role="status"><strong>{{ 'Controlled foundation — not production ready'|t }}</strong><p>{{ notice }}</p></div>{% if items %}<table><thead><tr><th>{{ 'Opportunity'|t }}</th><th>{{ 'Reference'|t }}</th><th>{{ 'Status'|t }}</th><th>{{ 'Updated'|t }}</th></tr></thead><tbody>{% for item in items %}<tr><td>{{ item.title }}</td><td>{{ item.reference }}</td><td>{{ item.status }}</td><td>{{ item.updated }}</td></tr>{% endfor %}</tbody></table>{% else %}<p>{{ 'No records are available.'|t }}</p>{% endif %}</div>
