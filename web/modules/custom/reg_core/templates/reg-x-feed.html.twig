<aside class="reg-x-feed{{ feed.mode == 'embed' ? ' reg-x-feed--embed' : '' }}"{% if feed.social_card %} data-reg-social-card="x"{% endif %}{% if feed.mode != 'embed' %} data-reg-x-feed aria-roledescription="{{ 'carousel'|t }}"{% endif %} aria-labelledby="reg-x-feed-title">
  <header class="reg-x-feed__header">
    <span class="reg-x-feed__icon" aria-hidden="true"></span>
    <div class="reg-x-feed__identity">
      <h3 id="reg-x-feed-title">{{ feed.display_name }}</h3>
      <span>{{ feed.handle }}</span>
    </div>
    <a class="reg-x-feed__follow" href="{{ feed.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'View Rwanda Energy Group on X'|t }}">{{ 'VIEW ON X'|t }} <span aria-hidden="true">&nearr;</span></a>
  </header>

  {% if feed.mode == 'embed' %}
    {{ attach_library('reg_core/x_embed') }}
    <div class="reg-x-feed__embed-intro" data-reg-x-embed data-reg-x-embed-profile="{{ feed.url }}">
      <span class="reg-x-feed__eyebrow">{{ 'Latest updates from X'|t }}</span>
      <p>{{ 'View the official REG public timeline without an X API subscription.'|t }}</p>
      {% if feed.posts %}
        {% set approved = feed.posts|first %}
        <div class="reg-x-feed__embed-approved" data-reg-x-embed-approved>
          <span class="reg-x-feed__embed-approved-label">{{ 'Latest approved REG X update'|t }}</span>
          {% if approved.date %}<time datetime="{{ approved.date_iso }}">{{ approved.date }}</time>{% endif %}
          <p>{{ approved.text|length > 155 ? approved.text|slice(0, 155) ~ '…' : approved.text }}</p>
          <a href="{{ approved.url }}" rel="noopener noreferrer" target="_blank">{{ 'Read this post on X'|t }} &nearr;</a>
        </div>
      {% endif %}
      <button type="button" class="reg-x-feed__embed-load" data-reg-x-embed-load>{{ 'Load X posts'|t }}</button>
      <p class="reg-x-feed__embed-notice">{{ 'Loading connects your browser to X and may allow X to process your data.'|t }}</p>
      <div class="reg-x-feed__embed-frame" data-reg-x-embed-frame hidden>
        <div data-reg-x-embed-target></div>
        <p data-reg-x-embed-status role="status" aria-live="polite"></p>
      </div>
      <a class="reg-x-feed__embed-external" href="{{ feed.url }}" target="_blank" rel="noopener noreferrer">{{ 'Open @handle on X'|t({'@handle': feed.handle}) }} &nearr;</a>
    </div>
  {% elseif feed.posts %}
    <div class="reg-x-feed__posts" tabindex="0" role="region" aria-label="{{ 'Latest REG posts on X'|t }}">
      {% for post in feed.posts %}
        <article class="reg-x-feed__post{{ (post.image.url or post.image.render) ? ' reg-x-feed__post--media' : '' }}" role="group" aria-label="{{ 'Post @current of @total'|t({'@current': loop.index, '@total': feed.posts|length}) }}">
          <div class="reg-x-feed__post-copy">
            {% if post.date %}<time datetime="{{ post.date_iso }}">{{ post.date }}</time>{% endif %}
            <p>{{ post.text }}</p>
            <a href="{{ post.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'View this Rwanda Energy Group post on X'|t }}">{{ 'VIEW POST'|t }} <span aria-hidden="true">&nearr;</span></a>
          </div>
          {% if post.image.url or post.image.render %}
            <a class="reg-x-feed__media" href="{{ post.url }}" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
              {% if post.image.render %}{{ post.image.render }}{% else %}
              <img src="{{ post.image.url }}" alt="{{ post.image.alt }}" loading="lazy"{% if post.image.width %} width="{{ post.image.width }}"{% endif %}{% if post.image.height %} height="{{ post.image.height }}"{% endif %}>
              {% endif %}
            </a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
    {% if feed.posts|length > 1 %}
      <div class="reg-x-feed__controls" hidden>
        <button type="button" data-x-prev aria-label="{{ 'Previous X post'|t }}">&larr;</button>
        <span data-x-status aria-live="polite" aria-atomic="true"></span>
        <button type="button" data-x-next aria-label="{{ 'Next X post'|t }}">&rarr;</button>
      </div>
    {% endif %}
  {% else %}
    <div class="reg-x-feed__fallback" data-reg-x-fallback>
      <span class="reg-x-feed__eyebrow">{{ 'Stay connected'|t }}</span>
      <p>{{ 'Follow Rwanda Energy Group for electricity updates, projects, announcements and public information.'|t }}</p>
      <a href="{{ feed.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'View Rwanda Energy Group on X'|t }}">{{ 'VIEW @handle ON X'|t({'@handle': feed.handle}) }} <span aria-hidden="true">&nearr;</span></a>
    </div>
  {% endif %}
</aside>
