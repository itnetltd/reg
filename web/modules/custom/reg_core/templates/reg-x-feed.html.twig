<aside class="reg-x-feed" data-reg-x-feed aria-labelledby="reg-x-feed-title">
  <header class="reg-x-feed__header">
    <span class="reg-x-feed__icon" aria-hidden="true"></span>
    <div class="reg-x-feed__identity">
      <h3 id="reg-x-feed-title">{{ feed.display_name }}</h3>
      <span>{{ feed.handle }}</span>
    </div>
    <a class="reg-x-feed__follow" href="{{ feed.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'View Rwanda Energy Group on X'|t }}">{{ 'VIEW ON X'|t }} <span aria-hidden="true">↗</span></a>
  </header>
  {% if feed.posts %}
    <div class="reg-x-feed__posts">
      {% for post in feed.posts|slice(0, 2) %}
        <article class="reg-x-feed__post{{ post.image.render ? ' reg-x-feed__post--media' : '' }}">
          <div class="reg-x-feed__post-copy">
            {% if post.date %}<time datetime="{{ post.date_iso }}">{{ post.date }}</time>{% endif %}
            <p>{{ post.text }}</p>
            <a href="{{ post.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'View this Rwanda Energy Group post on X'|t }}">{{ 'VIEW POST'|t }} <span aria-hidden="true">↗</span></a>
          </div>
          {% if post.image.render %}
            <a class="reg-x-feed__thumbnail" href="{{ post.url }}" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">{{ post.image.render }}</a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="reg-x-feed__fallback" data-reg-x-fallback>
      <span class="reg-x-feed__eyebrow">{{ 'Stay connected'|t }}</span>
      <p>{{ 'Follow Rwanda Energy Group for electricity updates, projects, announcements and public information.'|t }}</p>
      <a href="{{ feed.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'View Rwanda Energy Group on X'|t }}">{{ 'VIEW @handle ON X'|t({'@handle': feed.handle}) }} <span aria-hidden="true">↗</span></a>
    </div>
  {% endif %}
</aside>
