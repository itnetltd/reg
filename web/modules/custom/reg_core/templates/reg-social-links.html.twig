{% if items %}
  {% set social_id = 'reg-social-' ~ variant|clean_class %}
  {% if variant == 'media-center' %}
    <section class="reg-social-follow reg-social-follow--media-center" aria-labelledby="{{ social_id }}-heading" data-reg-social-follow data-reg-social-feed-ready>
      <div class="reg-social-follow__content">
        <span class="reg-social-follow__eyebrow">{{ 'Official channels'|t }}</span>
        <h2 id="{{ social_id }}-heading">{{ heading }}</h2>
        {% if description %}<p>{{ description }}</p>{% endif %}
      </div>
  {% endif %}

  <nav class="reg-social-links reg-social-links--{{ variant|clean_class }}" aria-label="{{ variant == 'footer' ? 'Follow REG'|t : 'REG social media'|t }}">
    <ul>
      {% for item in items %}
        <li>
          <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ item.aria_label }}" title="{{ item.label }}">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              {% if item.id == 'x' %}
                <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.847h-7.406l-5.8-7.584-6.638 7.584H.474l8.56-9.782L0 1.153h7.594l5.243 6.932 6.064-6.932Zm-1.291 19.492h2.039L6.486 3.24H4.298L17.61 20.645Z"/>
              {% elseif item.id == 'facebook' %}
                <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.414c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.972h-1.513c-1.49 0-1.956.931-1.956 1.887v2.261h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073Z"/>
              {% elseif item.id == 'youtube' %}
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.017 3.017 0 0 0 2.121 2.136c1.872.505 9.377.505 9.377.505s7.505 0 9.376-.505a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z"/>
              {% elseif item.id == 'instagram' %}
                <path d="M12 2.162c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.848 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069ZM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12s.014 3.668.072 4.948c.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24s3.668-.014 4.948-.072c4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948s-.014-3.667-.072-4.947c-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0Zm0 5.838A6.162 6.162 0 1 0 12 18.162 6.162 6.162 0 0 0 12 5.838Zm0 10.162a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881Z"/>
              {% elseif item.id == 'linkedin' %}
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.94v5.666H9.351V9h3.414v1.561h.047c.476-.9 1.637-1.85 3.37-1.85 3.602 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124ZM7.119 20.452H3.555V9H7.12v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0Z"/>
              {% elseif item.id == 'flickr' %}
                <circle cx="7.5" cy="12" r="5"/>
                <circle cx="16.5" cy="12" r="5"/>
              {% endif %}
            </svg>
            {% if variant != 'utility' %}<span>{{ item.label }}</span>{% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  </nav>

  {% if variant == 'media-center' %}
      <div class="reg-social-follow__feed-region" data-reg-social-feed-region hidden></div>
    </section>
  {% endif %}
{% endif %}
