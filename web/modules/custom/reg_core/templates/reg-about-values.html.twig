<div class="reg-about-values">
  {% for value in values %}
    <article class="reg-about-value">
      <span class="reg-about-value__icon" aria-hidden="true">
        {% if value.icon == 'customer' %}<svg viewBox="0 0 24 24"><path d="M12 3a4 4 0 1 1 0 8 4 4 0 0 1 0-8Zm-7 18a7 7 0 0 1 14 0"/></svg>
        {% elseif value.icon == 'integrity' %}<svg viewBox="0 0 24 24"><path d="m12 3 7 3v5c0 4.6-2.9 8-7 10-4.1-2-7-5.4-7-10V6l7-3Zm-3 9 2 2 4-5"/></svg>
        {% elseif value.icon == 'respect' %}<svg viewBox="0 0 24 24"><path d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2 20c.5-4 2.5-6 6-6s5.5 2 6 6m-2-5c1-.7 2.2-1 4-1 3.5 0 5.5 2 6 6"/></svg>
        {% elseif value.icon == 'teamwork' %}<svg viewBox="0 0 24 24"><path d="M7 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm10 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM1 21c.5-4 2.5-6 6-6s5.5 2 6 6m-2 0c.5-4 2.5-6 6-6s5.5 2 6 6"/></svg>
        {% elseif value.icon == 'efficiency' %}<svg viewBox="0 0 24 24"><path d="M13 2 5 14h6l-1 8 9-13h-6V2Z"/></svg>
        {% else %}<svg viewBox="0 0 24 24"><path d="M20 4C10 4 4 9 4 16c4 1 8 0 11-3M4 21c2-6 6-10 12-13"/></svg>{% endif %}
      </span>
      <h3>{{ value.title }}</h3>
      <p>{{ value.description }}</p>
    </article>
  {% endfor %}
</div>
