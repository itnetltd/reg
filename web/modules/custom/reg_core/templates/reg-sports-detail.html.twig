<article class="reg-sports reg-sports-detail" data-reg-analytics-event="{{ analytics_event }}" data-reg-analytics-id="{{ item.id }}">
  {% if item.image.url %}
  <header class="reg-sports-detail-head"><div class="reg-container">{% if item.image.url %}<img src="{{ item.image.url }}"{% if item.image.srcset %} srcset="{{ item.image.srcset }}" sizes="{{ item.image.sizes }}"{% endif %} alt="{{ item.image.alt }}">{% endif %}<div><span class="reg-sports-kicker">{{ item.category ?: item.kind }}</span><h1>{{ item.title }}</h1>{% if item.summary %}<p>{{ item.summary }}</p>{% endif %}<small>{{ item.team }}{% if item.date %} · <time datetime="{{ item.date_iso }}">{{ item.date }}</time>{% endif %}</small></div></div></header>
  {% else %}
    {% set detail_hero = section_hero|merge({eyebrow: item.category ?: item.kind, title: item.title, description: item.summary, meta: item.team}) %}
    {% include '@reg_core/reg-section-hero.html.twig' with {hero: detail_hero} only %}
  {% endif %}
  <nav class="reg-sports-nav" aria-label="{{ 'Sports Portal navigation'|t }}"><div class="reg-container">{% for link in links %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}</div></nav>
  <div class="reg-container reg-sports__body reg-sports-detail__layout">
    <main>
      {% if item.bundle == 'reg_sports_fixture' %}<section class="reg-sports-detail-score" aria-label="{{ (item.result_label ?: item.status) ~ ': ' ~ (item.score_label ?: item.matchup) }}"><span class="reg-sports-detail-score__status">{{ item.result_label ?: item.status }}</span><div><span>{{ item.home_team }}</span>{% if item.score %}<strong>{{ item.score }}</strong>{% else %}<strong>{{ 'VS'|t }}</strong>{% endif %}<span>{{ item.away_team }}</span></div></section>{% endif %}
      {% if item.description %}<section><h2>{{ item.bundle == 'reg_sports_player' ? 'Biography'|t : 'Overview'|t }}</h2><p>{{ item.description|nl2br }}</p></section>{% endif %}
      {% if item.match_notes %}<section><h2>{{ 'Match notes'|t }}</h2><p>{{ item.match_notes|nl2br }}</p></section>{% endif %}
      {% if item.match_report %}<section><h2>{{ 'Match report'|t }}</h2><p>{{ item.match_report|nl2br }}</p></section>{% endif %}
      {% if item.match_statistics or item.quarter_scores or item.set_scores %}<section><h2>{{ 'Match statistics'|t }}</h2>{% if item.quarter_scores %}<p><strong>{{ 'Quarter scores'|t }}:</strong> {{ item.quarter_scores }}</p>{% endif %}{% if item.set_scores %}<p><strong>{{ 'Set scores'|t }}:</strong> {{ item.set_scores }}</p>{% endif %}{% if item.match_statistics %}<p>{{ item.match_statistics|nl2br }}</p>{% endif %}</section>{% endif %}
      {% if item.images %}<section><h2>{{ 'Photos'|t }}</h2><div class="reg-sports-photo-grid">{% for image in item.images %}<figure><img src="{{ image.url }}"{% if image.srcset %} srcset="{{ image.srcset }}" sizes="{{ image.sizes }}"{% endif %} alt="{{ image.alt }}" loading="lazy">{% if item.photo_credit %}<figcaption>{{ item.photo_credit }}</figcaption>{% endif %}</figure>{% endfor %}</div></section>{% endif %}
      {% if item.news %}<section><h2>{{ 'Related news'|t }}</h2><ul class="reg-sports-related">{% for news in item.news %}<li><a href="{{ news.url }}">{{ news.title }}</a></li>{% endfor %}</ul></section>{% endif %}
    </main>
    <aside class="reg-sports-detail__side"><h2>{{ 'Key information'|t }}</h2><dl>{% if item.team %}<div><dt>{{ 'Team'|t }}</dt><dd>{{ item.team }}</dd></div>{% endif %}{% if item.position %}<div><dt>{{ 'Position'|t }}</dt><dd>{{ item.position }}</dd></div>{% endif %}{% if item.jersey %}<div><dt>{{ 'Jersey'|t }}</dt><dd>#{{ item.jersey }}</dd></div>{% endif %}{% if item.captain %}<div><dt>{{ 'Role'|t }}</dt><dd>{{ 'Captain'|t }}</dd></div>{% endif %}{% if item.nationality %}<div><dt>{{ 'Nationality'|t }}</dt><dd>{{ item.nationality }}</dd></div>{% endif %}{% if item.birth_date %}<div><dt>{{ 'Date of birth'|t }}</dt><dd><time datetime="{{ item.birth_date_iso }}">{{ item.birth_date }}</time></dd></div>{% endif %}{% if item.height %}<div><dt>{{ 'Height'|t }}</dt><dd>{{ item.height }} cm</dd></div>{% endif %}{% if item.competition %}<div><dt>{{ 'Competition'|t }}</dt><dd>{{ item.competition }}</dd></div>{% endif %}{% if item.season %}<div><dt>{{ 'Season'|t }}</dt><dd>{{ item.season }}</dd></div>{% endif %}{% if item.venue %}<div><dt>{{ 'Venue'|t }}</dt><dd>{{ item.venue }}</dd></div>{% endif %}{% if item.player_of_match %}<div><dt>{{ 'Player of the match'|t }}</dt><dd>{{ item.player_of_match }}</dd></div>{% endif %}</dl>{% if item.ticket_url %}<a class="reg-sports-button" href="{{ item.ticket_url }}">{{ 'Official ticket information'|t }}</a>{% endif %}{% if item.broadcast_url %}<a class="reg-sports-button reg-sports-button--dark" href="{{ item.broadcast_url }}">{{ 'Approved broadcast'|t }}</a>{% endif %}{% if item.stats %}<h3>{{ 'Published statistics'|t }}</h3><dl>{% for label, value in item.stats %}<div><dt>{{ label|replace({'_':' '})|title }}</dt><dd>{{ value }}</dd></div>{% endfor %}</dl>{% endif %}{% if item.social_links %}<h3>{{ 'Official links'|t }}</h3><ul class="reg-sports-related">{% for social in item.social_links %}<li><a href="{{ social.url }}">{{ social.title }}</a></li>{% endfor %}</ul>{% endif %}{% if item.publication_source %}<p><strong>{{ 'Source'|t }}:</strong> {{ item.publication_source }}</p>{% endif %}</aside>
  </div>
</article>
