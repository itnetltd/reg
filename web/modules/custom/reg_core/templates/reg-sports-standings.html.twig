<div class="reg-sports">
  {% set standings_hero = section_hero|merge({eyebrow: 'REG Sports'|t, title: 'Standings'|t, description: 'Sports Editor-managed tables published only after competition information is confirmed.'|t}) %}
  {% include '@reg_core/reg-section-hero.html.twig' with {hero: standings_hero} only %}
  <nav class="reg-sports-nav" aria-label="{{ 'Sports Portal navigation'|t }}"><div class="reg-container">{% for link in links %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}</div></nav>
  <main class="reg-container reg-sports__body">
    <form class="reg-sports-filter reg-filter-bar" method="get"><div><label for="standing-sport">{{ 'Sport'|t }}</label><select id="standing-sport" name="sport"><option value="">{{ 'All sports'|t }}</option>{% for value, label in sports %}<option value="{{ value }}"{% if filters.sport == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div><div><label for="standing-competition">{{ 'Competition'|t }}</label><select id="standing-competition" name="competition"><option value="">{{ 'All competitions'|t }}</option>{% for value, label in competitions %}<option value="{{ value }}"{% if filters.competition == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div><div><label for="standing-season">{{ 'Season'|t }}</label><select id="standing-season" name="season"><option value="">{{ 'All seasons'|t }}</option>{% for value, label in seasons %}<option value="{{ value }}"{% if filters.season == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div><button class="reg-filter-submit" type="submit">{{ 'Apply filters'|t }}</button></form>
    {% if rows %}<div class="reg-sports-table-wrap"><table class="reg-sports-table reg-sports-table--full"><caption>{{ 'Published standings. Competition-specific rules are managed by the Sports Editor and are not calculated by this website.'|t }}</caption><thead><tr><th scope="col">#</th><th scope="col">{{ 'Team'|t }}</th><th scope="col">{{ 'P'|t }}</th><th scope="col">{{ 'W'|t }}</th><th scope="col">{{ 'L'|t }}</th><th scope="col">{{ 'PF'|t }}</th><th scope="col">{{ 'PA'|t }}</th><th scope="col">{{ '+/−'|t }}</th><th scope="col">{{ 'SW'|t }}</th><th scope="col">{{ 'SL'|t }}</th><th scope="col">{{ 'Pts'|t }}</th></tr></thead><tbody>{% for row in rows %}<tr><td>{{ row.standing.table_position }}</td><th scope="row">{{ row.standing.team }}</th><td>{{ row.standing.played }}</td><td>{{ row.standing.wins }}</td><td>{{ row.standing.losses }}</td><td>{{ row.standing.points_for }}</td><td>{{ row.standing.points_against }}</td><td>{{ row.standing.points_difference }}</td><td>{{ row.standing.sets_won }}</td><td>{{ row.standing.sets_lost }}</td><td>{{ row.standing.league_points }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="reg-sports-empty"><h2>{{ 'Standings pending confirmation'|t }}</h2><p>{{ 'Standings will be published when confirmed.'|t }}</p></div>{% endif %}
  </main>
</div>
