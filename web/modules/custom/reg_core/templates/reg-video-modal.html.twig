<div class="reg-video-modal" data-reg-video-modal role="dialog" aria-modal="true" aria-labelledby="{{ modal_id }}-title" hidden>
  <button class="reg-video-modal__backdrop" type="button" data-reg-video-modal-backdrop tabindex="-1" aria-label="{{ 'Close video player'|t }}"></button>
  <div class="reg-video-modal__dialog" role="document">
    <div class="reg-video-modal__header">
      <h2 id="{{ modal_id }}-title" data-reg-video-modal-title>{{ 'REG video'|t }}</h2>
      <button class="reg-video-modal__close" type="button" data-reg-video-modal-close aria-label="{{ 'Close video player'|t }}"><span aria-hidden="true">×</span></button>
    </div>
    <div class="reg-video-modal__player" data-reg-video-player></div>
    <div class="reg-video-modal__external" data-reg-video-external hidden>
      <p>{{ 'This approved video is hosted externally.'|t }}</p>
      <a class="button button--primary" data-reg-video-external-link href="#" target="_blank" rel="noopener noreferrer">{{ 'Open approved video'|t }}</a>
    </div>
  </div>
</div>
